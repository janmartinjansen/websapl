::list = Nil | Cons !x xs

// File and stream I/O functions
readStream fd =
  let c = readChar fd in
  if (c == (0 - 1))
    Nil
    (Cons c (readStream fd))

writeStream fd xs =
  case xs
    (Nil -> closeFile fd)
    (Cons c cs -> writeChar fd c <#> writeStream fd cs)

// Converts a packed-array string (e.g. from readFile) into a char list
str2list !s = strls 0 s

strls !n !s = if (n < strlen s) (Cons (strat n s) (strls (n+1) s)) Nil

// Compares two packed-array strings for content equality
strEqual !s1 !s2 = (strlen s1 == strlen s2) /\ strEqualAt 0 s1 s2

strEqualAt !n !s1 !s2 = if (n >= strlen s1) 1 (if (strat n s1 == strat n s2) (strEqualAt (n+1) s1 s2) 0)

// Converts a char list into a packed-array string (inverse of str2list).
// Note: the raw `update` predef takes its arguments as (value, index, array) -
// the opposite of what the name suggests - see docs/sapl_programmeer_regels.md §7.
list2str !cs = fillStr 0 cs (strcreate (length cs))

fillStr !i !xs !arr =
  case xs
    (Nil -> arr)
    (Cons c cs -> fillStr (i+1) cs (update c i arr))

// Concatenates two packed-array strings into a new one. Copies directly
// into one fresh array (26 September 2026; was a round trip through a char
// list, see docs/2026-09-26_strings_keuze_analyse.md).
strcat !s1 !s2 =
  let n1 = strlen s1,
      n2 = strlen s2 in
  strBlit s2 0 n1 n2 (strBlit s1 0 0 n1 (strcreate (n1 + n2)))

// strBlit src from off k t: copies src[from .. from+k-1] to t[off ..] and
// returns t. Only for a fresh `t` (update mutates in place).
strBlit !src !from !off !k !t = strBlitAt src from off 0 k t

strBlitAt !src !from !off !i !k !t = if (i >= k) t (strBlitAt src from off (i + 1) k (update (strat (from + i) src) (off + i) t))

toUpperChar !c = if ((c >= 'a') /\ (c <= 'z')) ((c - 'a') + 'A') c

// Char <-> num conversion (Amanda's code/decode) -- no Sapl/JMVM primitive
// exists for this; '0' (ASCII 48) as a known anchor point is enough given
// char arithmetic already works directly (see toUpperChar above).
code !c = (c - '0') + 48
decode !n = '0' + (n - 48)

// Uppercases a packed-array string
strUpper !s = strUpperAt s 0 (strlen s) (strcreate (strlen s))

strUpperAt !s !i !n !t = if (i >= n) t (strUpperAt s (i + 1) n (update (toUpperChar (strat i s)) i t))

// Substring of length !len starting at !start (both packed-array strings).
// O(len): copies only the part needed (26 September 2026; the old
// `list2str (take len (drop start (str2list s)))` walked the whole prefix on
// every call, which made e.g. splitting into lines quadratic). Same edge
// cases as that take/drop version: a start < 0 or past the end gives "",
// a len < 0 or past the end takes the rest.
substr !s !start !len = substrClamp s start len (strlen s)

substrClamp !s !a !len !n = if ((a < 0) \/ (a >= n)) (strcreate 0) (strBlit s a 0 (substrLen len (n - a)) (strcreate (substrLen len (n - a))))

substrLen !len !r = if ((len < 0) \/ (len > r)) r len

// Converts an integer to a list of character codes (string)
itoa n =
  if (n < 0) (Cons '-' (itoa (0 - n)))
  (if (n < 10) (Cons ('0' + n) Nil)
  (append (itoa (n / 10)) (Cons ('0' + (n % 10)) Nil)))

// List operations
length xs =
  case xs
    (Nil -> 0)
    (Cons x xs -> 1 + length xs)

map f xs =
  case xs
    (Nil -> Nil)
    (Cons x xs -> Cons (f x) (map f xs))

filter f xs =
  case xs
    (Nil -> Nil)
    (Cons x xs -> if (f x) (Cons x (filter f xs)) (filter f xs))

foldl f z xs =
  case xs
    (Nil -> z)
    (Cons x xs -> foldl f (f z x) xs)

foldr f z xs =
  case xs
    (Nil -> z)
    (Cons x xs -> f x (foldr f z xs))

append xs ys =
  case xs
    (Nil -> ys)
    (Cons x xs -> Cons x (append xs ys))

take n xs =
  case xs
    (Nil -> Nil)
    (Cons x xs -> if (n == 0) Nil (Cons x (take (n - 1) xs)))

drop n xs =
  case xs
    (Nil -> Nil)
    (Cons x xs -> if (n == 0) (Cons x xs) (drop (n - 1) xs))

reverse xs = rev xs Nil

rev xs acc =
  case xs
    (Nil -> acc)
    (Cons x xs -> rev xs (Cons x acc))
