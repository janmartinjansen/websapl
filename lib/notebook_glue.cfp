// lib/notebook_glue.cfp -- de uitvoer van notebookcellen (26 september 2026).
// Plan: docs/2026-09-25_notebook_en_bibliotheken_plan.md, deel 3.
//
// Wordt niet door de gebruiker geïmporteerd: de notebookpagina
// (websapl/notebook.html) maakt van een notebook één Sapl+-programma met
// deze kop
//
//   #import "repl/stddyn.cfp"
//   #import "lib/notebook_glue.cfp"
//   import "lib/display.spp" as D
//   import "grafisch/graphics.cfp" as G
//
// daarna de definitiecellen, een `__cellN = <expressie>` per
// expressiecel, en `start = nbCell 1 __cell1 <#> nbCell 2 __cell2 <#> ... 0`.
//
// Protocol op stdout, per expressiecel:
//   @@begin N
//   @@<soort>            (value, text, markdown, table, graphics of form)
//   <inhoud>
//   @@end N
// Stopt een cel met `error`, dan ontbreekt haar @@end: de pagina markeert
// die cel en de cellen erna als niet uitgevoerd. Een tabel: koppen en
// cellen gescheiden door een tab, één rij per regel.
//
// De alias `D` (en de constructornamen `Display__...`, uit `module
// Display`) zijn dus een vaste afspraak met notebook.js.

nbCell n v = nbMark "@@begin " n <#> nbRender v <#> nbMark "@@end " n

// Weergave op type (notebookplan fase 3, 5 oktober 2026): notebook_core.js
// typeert elke expressiecel; bevat het type `Bool`, dan wordt de cel
// `nbCellT n "<type>" v` (een bool is in de VM gewoon 1/0). Zelfde grenzen
// als nbShow: lijsten na 100 elementen afgekapt, 40 niveaus diep.
nbCellT n ty v = nbMark "@@begin " n <#> nbValueT ty v <#> nbMark "@@end " n

nbValueT ty v = printString "@@value" <#> nbNl <#> printString (nbShowT 40 ty v) <#> nbNl

// Sinds 10 oktober 2026 roept de REPL dit aan, met `tbl` (per import het
// modulevoorvoegsel en de alias, "list L text T"), `cur` (de huidige
// adressen van de functies van de sessie, voor "(oude versie)") en het type van de cel
// (of ""). Een functie: `<fn:L.map/2> :: <type>` (prelude: showValX); een
// type met Bool: als nbCellT; de rest als nbCell.
nbCellX tbl cur n ty v = nbMark "@@begin " n <#> nbValueX tbl cur ty v <#> nbMark "@@end " n

nbValueX tbl cur ty v =
  if (typeId v == TYPE_FUNC) (printString "@@value" <#> nbNl <#> printString (showValX tbl cur ty v) <#> nbNl)
  (if (tyHasBool ty) (nbValueT ty v) (nbRender v))

nbShowT d ty v =
  if (d == 0) "..."
  (if (strEqual ty "Bool") (showBoolVal v)
  (if (isListTy ty) (strcat "[" (strcat (nbItemsT (d - 1) (listElemTy ty) 100 v) "]")) (nbShowD d v)))

nbItemsT d ty k xs =
  case xs
    (Nil -> "")
    (Cons x rest -> if (k == 0) "..." (strcat (nbShowT d ty x) (nbMoreT d ty (k - 1) rest)))

nbMoreT d ty k xs =
  case xs
    (Nil -> "")
    (Cons x rest -> strcat ", " (nbItemsT d ty k xs))

nbMark s n = printString s <#> printString (list2str (itoa n)) <#> writeChar 1 10

nbNl = writeChar 1 10

nbTab = writeChar 1 9

// Een Display-waarde herkennen we aan de naam: een `case` op een waarde van
// een ander type zou stil op tagnummer matchen (tags zijn per ADT).
nbRender v =
  if (typeId v > TYPE_FUNC) (nbRenderAdt v (constrName v)) (nbValue v)

nbRenderAdt v name =
  if (nbIsDisplayName name) (nbDisplay v) (nbRenderHook v (lookup (strcat "render_" name)))

nbRenderHook v h =
  if (typeId h == TYPE_FUNC) (nbRenderChecked v (applyDynamic h (Cons v Nil))) (nbValue v)

// Een render_-haak die geen Display teruggeeft: dan toch gewoon showVal.
nbRenderChecked v d =
  if (typeId d > TYPE_FUNC) (nbRenderCheckedName v d (constrName d)) (nbValue v)

nbRenderCheckedName v d name = if (nbIsDisplayName name) (nbDisplay d) (nbValue v)

nbIsDisplayName name = (strlen name > 9) /\ strEqualAt 0 "Display__" name

nbDisplay d =
  case d
    (D.DText s -> printString "@@text" <#> nbNl <#> printString s <#> nbNl)
    (D.DMarkdown s -> printString "@@markdown" <#> nbNl <#> printString s <#> nbNl)
    (D.DTable hs rows -> printString "@@table" <#> nbNl <#> nbRow hs <#> nbRows 500 rows)
    (D.DGraphics gs -> printString "@@graphics" <#> nbNl <#> printString (D.graphicsText gs) <#> nbNl)
    (D.DForm v -> printString "@@form" <#> nbNl <#> nbForm v)
    (D.DSlider lo hi v -> printString "@@form" <#> nbNl <#> nbLine (Cons "slider" (Cons (nbKind v) (Cons (nbPlain v) (Cons (nbPlain lo) (Cons (nbPlain hi) Nil))))))
    (D.DChoice opts v -> printString "@@form" <#> nbNl <#> nbLine (Cons "choice" (Cons v opts)))
    (D.DRecords xs -> nbRecords xs)
    (D.DInteractive ms m u vw -> nbRender (vw m))
    (D.DColumn ds -> nbColumn ds)
    (D.DConnected url m u vw -> nbRender (vw m))

// D.column: elk onderdeel met zijn eigen @@-kop (de pagina toont ze onder
// elkaar).
nbColumn ds = case ds (Nil -> 0) (Cons d rest -> nbRender d <#> nbColumn rest)

// == Interactieve cellen (D.interactive, D.animated; fase E) ==================
// De REPL roept per expressiecel nbCellI aan, met een sleutel `tok` die de
// sessie uitdeelt (repl_sapl/mini_repl.spp, nbBatchSrc). Een gewone cel geeft
// Nil terug, een interactieve [tok, stapper]. De stapper is een functie van
// een gebeurtenis als tekst (velden gescheiden door een tab, zoals bij de
// formulieren geëscapet: "click\t0.25\t-0.5", "key\ta", "tick\t120"): hij
// rekent `update` en `view` uit, tekent de cel opnieuw en geeft de volgende
// stapper terug. De REPL bewaart hem (`:nbmsg tok gebeurtenis`).
// Protocol voor de pagina:
//   @@begin n
//   @@interactive
//   <tok> <ms>
//   (de weergave van `view model`, zoals een gewone cel)
//   @@end n
// Een fout in update of view: @@begin n met de melding (zonder @@end), en het
// model blijft wat het was.
// De typechecker (met de kop van de sessie ervoor) meldt hier bewust drie
// dingen: een "oneindig type" bij nbStepNext/nbStepFail (een stapper geeft een
// stapper terug: zonder wikkeltype niet uit te drukken), bij nbInterFirst
// een lijst met een string en een functie (de grens naar de REPL, die er
// alleen Cons/Nil van leest), en bij nbCellIV `Str met Display` (`v` is elke
// waarde, alleen een Display als hij interactief is; tot 24 oktober 2026
// verborgen doordat nbInterStart zelf al niet typeerde).
// Eerst @@begin, dan pas de waarde uitrekenen (zoals nbCellX): een fout in de
// cel hoort binnen de cel (de pagina wijst er een trap mee aan).
// Het model bewaren (fase F, docs/2026-10-23_waarden_bewaren_plan.md §11):
// `mp` het bestand ("" = niet bewaren), `nm` de naam (`@m<hash van de
// celtekst>`), `mh` de hash van de cel met alles waar ze van afhangt, `mr` 1
// als de REPL het bewaarde model mag terugzetten (een verse sessie: de cel
// had nog geen stapper; opnieuw uitvoeren begint wel bij model0).
nbCellI tbl cur n tok ty mp nm mh mr v = nbMark "@@begin " n <#> nbCellIV tbl cur n tok ty mp nm mh mr v

nbCellIV tbl cur n tok ty mp nm mh mr v = if (nbIsInteractive v) (nbInterStart n tok mp nm mh mr v) (nbValueX tbl cur ty v <#> nbMark "@@end " n <#> Nil)

// De cellen van een run op volgorde uitrekenen (elke cel drukt af) en de
// interactieve verzamelen; de hele lijst is uitgerekend zodra er een eerste
// cel is (nbCollectKeep is strikt in de rest).
nbCollect cs = case cs (Nil -> Nil) (Cons c r -> nbCollectOne c r)

nbCollectOne !c r = nbCollectKeep c (nbCollect r)

nbCollectKeep c !rest = case c (Nil -> rest) (Cons t x -> Cons c rest)

nbIsInteractive v = if (typeId v > TYPE_FUNC) (strEqual (constrName v) "Display__DInteractive" \/ strEqual (constrName v) "Display__DConnected") False

// `kop`: wat er na de sleutel op de regel van @@interactive staat: de ms van
// de klok, en bij een verbonden cel (D.connected) "0 <url>". Een verbonden
// cel krijgt als update D.connStep: die schrijft de berichten van update
// als `@@send <tok> <bericht>` (geëscapet), voor de pagina, die ze naar de
// WebSocket stuurt.
nbInterStart n tok mp nm mh mr v =
  case v
    (D.DInteractive ms m u vw -> nbInterBegin n tok (list2str (itoa ms)) u vw (MS mp nm mh (nbModelFirst mp nm mh)) (nbModelStart mp nm mh mr m))
    (D.DConnected url m u vw -> nbInterBegin n tok (strcat "0 " url) (D.connStep (nbSends tok) u) vw (MS mp nm mh (nbModelFirst mp nm mh)) (nbModelStart mp nm mh mr m))

nbSends tok msgs = case msgs (Nil -> 0) (Cons x r -> printString "@@send " <#> printString tok <#> printString " " <#> printString (nbEsc x) <#> nbNl <#> nbSends tok r)

// Het eerste beeld; het startmodel meteen bewaren (ook model0: anders bracht
// een verse sessie na "opnieuw uitvoeren" het oude model terug).
nbInterBegin n tok ms u vw sv !m = nbInterBody tok ms m vw <#> nbMark "@@end " n <#> nbInterFirst n tok ms m u vw (nbModelSave sv m)

// `!sv2`: meteen bewaren (anders pas bij de volgende gebeurtenis).
nbInterFirst n tok ms m u vw !sv2 = Cons tok (Cons (nbStepper n tok ms m u vw sv2) Nil)

nbInterShow n tok ms m vw = nbMark "@@begin " n <#> nbInterBody tok ms m vw <#> nbMark "@@end " n

nbInterBody tok ms m vw = printString "@@interactive" <#> nbNl <#> printString tok <#> printString " " <#> printString ms <#> nbNl <#> nbRender (vw m)

nbStepper n tok ms m u vw sv ev = try (nbStepOk n tok ms u vw sv (u (nbEvent ev) m)) (nbStepFail n tok ms m u vw sv)

// `!m2`: het nieuwe model meteen uitrekenen (binnen de try), zodat een lange
// reeks gebeurtenissen geen keten van uitstellen opbouwt.
nbStepOk n tok ms u vw sv !m2 = nbInterShow n tok ms m2 vw <#> nbStepNext n tok ms m2 u vw (nbModelSave sv m2)

nbStepNext n tok ms m u vw !sv2 = nbStepper n tok ms m u vw sv2

nbStepFail n tok ms m u vw sv msg = nbMark "@@begin " n <#> printString msg <#> nbNl <#> nbStepper n tok ms m u vw sv

// -- Het model bewaren --------------------------------------------------------
// Een bestand `<map>/<nm>.<mh>.val` met een kopregel `jmvm-waarde <nm> <mh>`
// en de tekst van packMax (zoals een `=:`-waarde, dus de motoren bewaren en
// verplaatsen het net zo). Na elke geslaagde stap, alleen als de tekst
// veranderde (vergeleken met de vorige, in het geheugen); geschreven met een
// regel `@@saved <nm> <mh> <pad>`. MS: pad, naam, hash, de laatst bewaarde
// tekst ("" = nog niets; "-" = te groot).
::MS = MS mp nm mh last

nbModelMax = 1000000

nbModelHdr nm mh = strcat "jmvm-waarde " (strcat nm (strcat " " (strcat mh "\n")))

nbModelSave sv m = case sv (MS mp nm mh last -> if (strlen mp == 0) sv (nbModelSaveT mp nm mh last (try (packMax nbModelMax m) nbModelPackErr)))

nbModelPackErr msg = ""

nbModelSaveT mp nm mh last t =
  if (strlen t == 0) (nbModelBig mp nm mh last)
  (if (strEqual t last) (MS mp nm mh last)
  (writeFile mp (strcat (nbModelHdr nm mh) t) <#> printString (strcat "@@saved " (strcat nm (strcat " " (strcat mh (strcat " " (strcat mp "\n")))))) <#> MS mp nm mh t))

nbModelBig mp nm mh last = if (strEqual last "-") (MS mp nm mh last) (printString (strcat "@@savefailed " (strcat nm " te groot\n")) <#> MS mp nm mh "-")

// Wat er al in het bestand staat (zonder kopregel), zodat het startmodel niet
// opnieuw geschreven wordt als het teruggezet is of niet veranderde.
nbModelFirst mp nm mh = if (strlen mp == 0) "" (nbModelBody (nbModelHdr nm mh) (readFile mp))

nbModelBody hdr content = if (nbStarts hdr content) (strslice content (strlen hdr) (strlen content)) ""

nbStarts hdr s = (strlen s >= strlen hdr) /\ strEqual (strslice s 0 (strlen hdr)) hdr

// Het startmodel: het bewaarde als dat er is en mag, anders model0. Een
// bewaard model dat niet terug te lezen is (een functie die er niet meer is):
// `@@restorefailed`, en dan model0.
nbModelStart mp nm mh mr m = if ((mr == 0) \/ (strlen mp == 0)) m (nbModelFrom nm m (nbModelBody (nbModelHdr nm mh) (readFile mp)))

nbModelFrom nm m t = if (strlen t == 0) m (try (nbModelRestored nm (unpack t)) (nbModelRestoreErr nm m))

nbModelRestored nm !m2 = printString (strcat "@@restored " (strcat nm "\n")) <#> m2

nbModelRestoreErr nm m msg = printString (strcat "@@restorefailed " (strcat nm (strcat " " (strcat (nbEsc msg) "\n")))) <#> m

nbEvent ev = nbEventF (nbTabFields ev)

nbEventF fs = case fs (Nil -> error "lege gebeurtenis") (Cons k r -> nbEventK k r)

nbEventK k r =
  if (strEqual k "click") (D.Click (atof (nbNth 0 r)) (atof (nbNth 1 r)))
  (if (strEqual k "key") (D.Key (nbNth 0 r))
  (if (strEqual k "tick") (D.Tick (nbInt (nbNth 0 r)))
  (if (strEqual k "input") (D.Input (nbNth 0 r) (nbNth 1 r))
  (if (strEqual k "message") (D.Message (nbNth 0 r))
  (if (strEqual k "connected") D.Connected
  (if (strEqual k "disconnected") D.Disconnected
  (error (strcat "onbekende gebeurtenis: " k))))))))

nbNth !i fs = case fs (Nil -> "") (Cons f r -> if (i == 0) f (nbNth (i - 1) r))

nbInt s = if (strlen s == 0) 0 (if (strat 0 s == '-') (0 - nbDigits s 1 (strlen s) 0) (nbDigits s 0 (strlen s) 0))

nbDigits s !i !n !acc = if (i >= n) acc (nbDigits s (i + 1) n (acc * 10 + (strat i s - '0')))

// Velden gescheiden door een tab, met \t, \n en \\ (zoals nbEsc).
nbTabFields s = nbTabFrom s 0 (strlen s) Nil

nbTabFrom s !i !n acc =
  if (i >= n) (Cons (list2str (nbRev acc Nil)) Nil)
  (if (strat i s == 9) (Cons (list2str (nbRev acc Nil)) (nbTabFrom s (i + 1) n Nil))
  (if ((strat i s == 92) /\ (i + 1 < n)) (nbTabFrom s (i + 2) n (Cons (nbUnesc (strat (i + 1) s)) acc))
  (nbTabFrom s (i + 1) n (Cons (strat i s) acc))))

nbUnesc c = if (c == 't') 9 (if (c == 'n') 10 c)

// (de prelude van de REPL heeft geen reverse)
nbRev xs acc = case xs (Nil -> acc) (Cons x r -> nbRev r (Cons x acc))

// == Formulieren (D.form, D.slider, D.choice; lib/display.spp) ==============
// Protocol na `@@form`: één regel per onderdeel, velden gescheiden door een
// tab (\t, \n en \\ in een waarde geëscapet; websapl/js/notebook_core.js
// parseForm):
//   record <Constructor>
//   sum <Constructor> <Type>           een waarde van een somtype (zie onder)
//   alt <Constructor> (<naam> <soort> <opties> <standaard>)*
//   field <naam> <soort> <waarde> <opties>
//                                      soort: int float str bool char con other
//   value <soort> <waarde>             een losse waarde (geen record)
//   slider <soort> <waarde> <lo> <hi>
//   choice <waarde> <optie> <optie> ...
// Een record herkennen we aan __fields_<Naam> (preprocess/records.cfp): de
// veldtypen staan daar als tekst, want een Bool heeft geen eigen tag.
// Soort `con`: een veld van een opsommingstype (alleen constructors zonder
// velden, ::Kleur = Rood | Groen); <opties> zijn dan de constructors,
// gescheiden door een spatie, anders leeg.
nbForm v = if (typeId v > TYPE_FUNC) (nbFormAdt v (constrName v) (lookup (nbFieldsName (constrName v)))) (nbFormValue v)

nbFormAdt v name h =
  if (typeId h == TYPE_FUNC) (nbLine (Cons "record" (Cons (displayConName name) Nil)) <#> nbFormFields v 0 (applyDynamic h Nil))
  (nbFormSum v name (nbTypeInfo (list2str (itoa (typeId v)))))

nbFormValue v = nbLine (Cons "value" (Cons (nbKind v) (Cons (nbPlain v) Nil)))

nbFormFields v !i fs = case fs (Nil -> 0) (Cons p rest -> nbFormField v i p <#> nbFormFields v (i + 1) rest)

nbFormField v !i p = case p (Cons n r -> case r (Cons ty r2 -> nbLine (Cons "field" (Cons n (Cons (nbFieldKind ty) (Cons (nbRecCell v i ty) (Cons (nbEnumOpts ty) Nil)))))))

// == Somtypen (23 oktober 2026) ==============================================
// Een waarde van een somtype als formulier: eerst een keuze van de
// constructor, dan de velden van de gekozen constructor. Kan voor een
// opsommingstype (::Kleur = Rood | Groen) en voor een ADT met getypeerde
// velden (fase D2, ::Vorm = Cirkel { !r : Float } | Leeg); de veldtypen staan
// in __alts_<Type> (preprocess/records.cfp, "Cirkel,r,Float;Leeg"). Een type
// uit een module (Mod__Kleur) of een ander somtype: alleen de waarde.
// De constructors van een type geeft de VM: lookup "@meta:type:<id of naam>"
// is "Naam\tCon\tariteit\t..." (vm/meta.h), of "" als het type er niet is.
nbTypeInfo key = nbTabFields (lookup (strcat "@meta:type:" key))

nbInfoName info = case info (Nil -> "") (Cons n r -> n)

nbInfoCons info = case info (Nil -> Nil) (Cons n r -> nbConPairs r)

nbConPairs xs = case xs (Nil -> Nil) (Cons c r -> case r (Nil -> Nil) (Cons a r2 -> Cons (Cons c (Cons a Nil)) (nbConPairs r2)))

nbPairFst p = case p (Cons a r -> a)

nbPairSnd p = case p (Cons a r -> case r (Cons b r2 -> b))

nbAllNullary cs = case cs (Nil -> True) (Cons p rest -> if (strEqual (nbPairSnd p) "0") (nbAllNullary rest) False)

nbHasModule name = nbHasModuleFrom name 0 (strlen name)

nbHasModuleFrom name !i !n = if (i + 1 >= n) False (if ((strat i name == '_') /\ (strat (i + 1) name == '_')) True (nbHasModuleFrom name (i + 1) n))

// Een eigen type (geen module) met minstens één constructor.
nbOwnType info = (strlen (nbInfoName info) > 0) /\ (nbHasModule (nbInfoName info) == False) /\ nbNotEmpty (nbInfoCons info)

nbNotEmpty xs = case xs (Nil -> False) (_ -> True)

nbIsEnum info = nbOwnType info /\ nbAllNullary (nbInfoCons info)

nbFormSum v con info = nbFormSumA v con info (lookup (strcat "__alts_" (nbInfoName info)))

nbFormSumA v con info h =
  if (nbOwnType info == False) (nbFormValue v)
  (if (typeId h == TYPE_FUNC) (nbFormSumAlts v con (nbInfoName info) (nbParseAlts (applyDynamic h Nil)))
  (if (nbAllNullary (nbInfoCons info)) (nbFormSumAlts v con (nbInfoName info) (nbEnumAlts (nbInfoCons info))) (nbFormValue v)))

// Alternatieven: per constructor de naam en de velden [[veld, type], ...].
::NbAlt = NbAlt !con fields

nbAltCon a = case a (NbAlt c fs -> c)

nbAltFs a = case a (NbAlt c fs -> fs)

nbEnumAlts cs = case cs (Nil -> Nil) (Cons p rest -> Cons (NbAlt (nbPairFst p) Nil) (nbEnumAlts rest))

nbParseAlts s = nbParseAltList (nbSplit ';' s)

nbParseAltList xs = case xs (Nil -> Nil) (Cons a rest -> Cons (nbParseAlt (nbSplit ',' a)) (nbParseAltList rest))

nbParseAlt ws = case ws (Nil -> NbAlt "" Nil) (Cons c r -> NbAlt c (nbConPairs r))

nbFormSumAlts v con tname alts =
  nbLine (Cons "sum" (Cons con (Cons tname Nil))) <#> nbAltLines alts <#> nbFormFields v 0 (nbAltFields con alts)

nbAltLines alts = case alts (Nil -> 0) (Cons a rest -> nbLine (Cons "alt" (Cons (nbAltCon a) (nbAltSpecs (nbAltFs a)))) <#> nbAltLines rest)

nbAltSpecs fs = case fs (Nil -> Nil) (Cons p rest -> Cons (nbPairFst p) (Cons (nbFieldKind (nbPairSnd p)) (Cons (nbEnumOpts (nbPairSnd p)) (Cons (nbDefault (nbPairSnd p)) (nbAltSpecs rest)))))

nbAltFields con alts = case alts (Nil -> Nil) (Cons a rest -> if (strEqual (nbAltCon a) con) (nbAltFs a) (nbAltFields con rest))

// De soort van een veldtype: zoals nbKindOfTy, en `con` voor een
// opsommingstype.
nbFieldKind ty = nbFieldKindK ty (nbKindOfTy ty)

nbFieldKindK ty k = if (strEqual k "other") (if (nbIsEnum (nbTypeInfoOf ty)) "con" k) k

// Alleen een kale typenaam (geen [Int], Tree a, a) kan een opsommingstype zijn.
nbTypeInfoOf ty = if (nbPlainTypeName ty) (nbTypeInfo ty) Nil

nbPlainTypeName ty = (strlen ty > 0) /\ (strat 0 ty >= 'A') /\ (strat 0 ty <= 'Z') /\ nbNoSpace ty 0 (strlen ty)

nbNoSpace s !i !n = if (i >= n) True (if (strat i s == ' ') False (nbNoSpace s (i + 1) n))

nbEnumOpts ty = nbEnumOptsI (nbTypeInfoOf ty)

nbEnumOptsI info = if (nbIsEnum info) (nbJoinSp (nbInfoCons info)) ""

nbJoinSp cs = case cs (Nil -> "") (Cons p rest -> case rest (Nil -> nbPairFst p) (_ -> strcat (nbPairFst p) (strcat " " (nbJoinSp rest))))

// Een standaardwaarde (als Sapl-tekst) voor een veld bij het wisselen van
// constructor; "" als er geen is (een typevariabele, een lijst). Een eigen
// somtype met een constructor zonder velden (Tree a: Leaf) krijgt die.
nbDefault ty =
  if (strEqual ty "Int") "0"
  (if (strEqual ty "Float") "0.0"
  (if (strEqual ty "String" \/ strEqual ty "Str") "\"\""
  (if (strEqual ty "Bool") "False"
  (if (strEqual ty "Char") "'a'"
  (nbNullaryOf (nbTypeInfo (nbHeadWord ty)))))))

nbHeadWord ty = list2str (nbHeadFrom ty 0 (strlen ty))

nbHeadFrom s !i !n = if (i >= n) Nil (if (strat i s == ' ') Nil (Cons (strat i s) (nbHeadFrom s (i + 1) n)))

nbNullaryOf info = if (nbOwnType info) (nbFirstNullary (nbInfoCons info)) ""

nbFirstNullary cs = case cs (Nil -> "") (Cons p rest -> if (strEqual (nbPairSnd p) "0") (nbPairFst p) (nbFirstNullary rest))

// s gesplitst op teken c (zonder escapes).
nbSplit c s = nbSplitFrom c s 0 0 (strlen s)

nbSplitFrom c s !start !i !n =
  if (i >= n) (Cons (strslice s start n) Nil)
  (if (strat i s == c) (Cons (strslice s start i) (nbSplitFrom c s (i + 1) (i + 1) n)) (nbSplitFrom c s start (i + 1) n))

nbKind v = nbKindTid (typeId v)

nbKindTid tid = if (tid == TYPE_INT) "int" (if (tid == TYPE_FLOAT) "float" (if (tid == TYPE_STRING) "str" (if (tid == TYPE_CHAR) "char" "other")))

nbKindOfTy ty =
  if (strEqual ty "Int") "int"
  (if (strEqual ty "Float") "float"
  (if (strEqual ty "String" \/ strEqual ty "Str") "str"
  (if (strEqual ty "Bool") "bool"
  (if (strEqual ty "Char") "char" "other"))))

// Een waarde als tekst: een string zoals hij is, een teken als zichzelf.
nbPlain x = if (typeId x == TYPE_STRING) x (if (typeId x == TYPE_CHAR) (list2str (Cons x Nil)) (nbShow x))

// Veld i van een record als tekst; een Bool-veld als True/False. In een eigen
// functie, zoals nbFieldAt (getField + eval niet midden in een strcat).
nbRecCell !v !i ty = if (strEqual ty "Bool") (showBoolVal (getField v i)) (nbPlain (getField v i))

nbLine xs = printString (nbTabbed xs) <#> nbNl

nbTabbed xs = case xs (Nil -> "") (Cons x rest -> case rest (Nil -> nbEsc x) (Cons y r2 -> strcat (nbEsc x) (strcat "\t" (nbTabbed rest))))

nbEsc s = list2str (nbEscFrom s 0 (strlen s))

nbEscFrom s !i !n = if (i >= n) Nil (nbEscChar (strat i s) (nbEscFrom s (i + 1) n))

nbEscChar c rest =
  if (c == 92) (Cons 92 (Cons 92 rest))
  (if (c == 9) (Cons 92 (Cons 't' rest))
  (if (c == 10) (Cons 92 (Cons 'n' rest)) (Cons c rest)))

// D.records xs: een tabel met de veldnamen als kop.
// __fields_<Naam> van een record; bij een record uit een module heet de
// constructor `Module__Naam` en de functie `module____fields_Naam`
// (preprocess/modules.cfp: functies krijgen de modulenaam met een kleine
// letter ervoor, constructors de modulenaam zelf). Tot 25 oktober 2026 werd
// alleen de eerste vorm gezocht, en toonden D.records en D.form een record
// uit een module als gewone waarde.
// De naam, niet de functie zelf: een functie zonder argumenten die een
// functie teruggeeft, wordt daar meteen uitgerekend (dan kwam de lijst
// velden terug in plaats van de functie).
nbFieldsName name = if (typeId (lookup (strcat "__fields_" name)) == TYPE_FUNC) (strcat "__fields_" name) (nbFieldsMod name (nbLastSep name (strlen name - 2)))

nbFieldsMod name !i = if (i <= 0) (strcat "__fields_" name) (strcat (nbLowerFirst (strslice name 0 i)) (strcat "____fields_" (strslice name (i + 2) (strlen name))))

// De plek van de laatste "__" in s (zoekend vanaf i omlaag), of -1.
nbLastSep s !i = if (i < 1) (0 - 1) (if ((strat i s == '_') /\ (strat (i + 1) s == '_')) i (nbLastSep s (i - 1)))

nbLowerFirst s = if (strlen s == 0) s (strcat (list2str (Cons (nbLowerC (strat 0 s)) Nil)) (strslice s 1 (strlen s)))

nbLowerC c = if ((c >= 'A') /\ (c <= 'Z')) (c + 32) c

nbRecords xs = case xs (Nil -> printString "@@text" <#> nbNl <#> printString "(geen rijen)" <#> nbNl) (Cons r rest -> nbRecordsH xs (lookup (nbFieldsName (constrName r))))

nbRecordsH xs h = if (typeId h == TYPE_FUNC) (nbRecordsF xs (applyDynamic h Nil)) (nbValue xs)

nbRecordsF xs fs = printString "@@table" <#> nbNl <#> nbRow (nbFieldNames fs) <#> nbRows 500 (nbRecRows fs xs)

nbFieldNames fs = case fs (Nil -> Nil) (Cons p rest -> case p (Cons n r -> Cons n (nbFieldNames rest)))

nbRecRows fs xs = case xs (Nil -> Nil) (Cons r rest -> Cons (nbRecRow fs r 0) (nbRecRows fs rest))

nbRecRow fs r !i = case fs (Nil -> Nil) (Cons p rest -> case p (Cons n t -> case t (Cons ty t2 -> Cons (nbRecCell r i ty) (nbRecRow rest r (i + 1)))))

nbRows k rows =
  case rows
    (Nil -> 0)
    (Cons r rest -> if (k == 0) (printString "..." <#> nbNl) (nbRow r <#> nbRows (k - 1) rest))

nbRow cells =
  case cells
    (Nil -> nbNl)
    (Cons c rest -> printString (nbCellText c) <#> nbRowRest rest)

nbRowRest cells =
  case cells
    (Nil -> nbNl)
    (Cons c rest -> nbTab <#> printString (nbCellText c) <#> nbRowRest rest)

nbCellText c = if (typeId c == TYPE_STRING) c (nbShow c)

nbValue v = printString "@@value" <#> nbNl <#> printString (nbShow v) <#> nbNl

// showVal, maar met grenzen, zodat een oneindige waarde de pagina niet laat
// hangen: elke lijst (op elk niveau) na 100 elementen afgekapt, en na 40
// niveaus diep "...". Verder als showVal (repl/stddyn.cfp): show_-haken,
// tupels als (a, b), modulenamen zonder voorvoegsel (displayConName).
// (Tot 27 september 2026 alleen de buitenste lijst; `[L.from 1]` hing.)
nbShow v = nbShowD 40 v

nbShowD d v = if (d == 0) "..." (nbShowTid d v (typeId v))

nbShowTid d v tid = if (tid > TYPE_FUNC) (nbShowAdt d v (constrName v)) (showVal v)

nbShowAdt d v name =
  if (strEqual name "Cons") (strcat "[" (strcat (nbItems (d - 1) 100 v) "]"))
  (if (strEqual name "Nil") "[]"
  (nbShowHook d v name (lookup (strcat "show_" name))))

nbShowHook d v name h = if (typeId h == TYPE_FUNC) (applyDynamic h (Cons v Nil)) (nbShowGeneric d v name (getConstrArity v))

// Een record (er is een __fields_<Naam>, preprocess/records.cfp) als
// `Naam { veld = waarde, ... }`, met een Bool-veld als True/False (15 oktober
// 2026; in een cel maakt de preprocessor geen show_<Naam>, want de cel
// definieert geen showVal).
nbShowGeneric d v name arity = nbShowRec d v name arity (lookup (nbFieldsName name))

nbShowRec d v name arity h =
  if (typeId h == TYPE_FUNC) (strcat (displayConName name) (strcat " { " (strcat (nbRecFields (d - 1) v 0 (applyDynamic h Nil)) " }")))
  (nbShowPlain d v name arity)

nbRecFields d v i fs =
  case fs
    (Nil -> "")
    (Cons p rest -> case rest (Nil -> nbRecField d v i p) (_ -> strcat (nbRecField d v i p) (strcat ", " (nbRecFields d v (i + 1) rest))))

nbRecField d v i p = case p (Cons n r -> case r (Cons ty r2 -> strcat n (strcat " = " (nbRecValue d v i ty))))

nbRecValue d !v !i ty = if (strEqual ty "Bool") (showBoolVal (getField v i)) (nbFieldAt d v i)

nbShowPlain d v name arity =
  if (isTupleName name) (strcat "(" (strcat (nbFields (d - 1) v 0 arity) ")"))
  (if (arity == 0) (displayConName name) (strcat (displayConName name) (strcat "(" (strcat (nbFields (d - 1) v 0 arity) ")"))))

nbFields d v i n =
  if (i >= n) ""
  (if (i == n - 1) (nbFieldAt d v i) (strcat (nbFieldAt d v i) (strcat ", " (nbFields d v (i + 1) n))))

// Een veld in een eigen functie (11 oktober 2026, zoals showFieldAt in de
// prelude): de getField + eval niet met al een argument van strcat in het
// frame, anders past `eval` een gedeeltelijke toepassing in het veld toe.
nbFieldAt d !v !i = nbShowD d (getField v i)

nbItems d k xs =
  case xs
    (Nil -> "")
    (Cons x rest -> if (k == 0) "..." (strcat (nbShowD d x) (nbMore d (k - 1) rest)))

nbMore d k xs =
  case xs
    (Nil -> "")
    (Cons x rest -> strcat ", " (nbItems d k xs))
