// lib/shape.spp -- de vorm van een waarde tijdens het draaien (15 oktober 2026).
// Plan: docs/2026-10-15_notebook_integraal_plan.md, fase A.
//
// Gebruik:  import "lib/shape.spp" as Sh
//           ::Klant = { !naam : String, !lid : Bool }
//           Sh.ofCon Klant                -- TRec "Klant" [Field "naam" TStr, Field "lid" TBool]
//           Sh.ofValue (Klant "Jan" True) -- idem, via de constructor van de waarde
//           Sh.showAs (Sh.ofCon Klant) k  -- tonen volgens de vorm (een Bool als True)
//           Sh.make Klant ["Jan", True]   -- een record uit een lijst velden
//
// De vorm van een record komt uit `__fields_<Naam>`, dat de preprocessor bij
// elk record maakt (preprocess/records.cfp), en wordt met `lookup` gevonden.
// Een somtype (23 oktober 2026) wordt TSum, met per constructor een Alt; de
// constructors geeft de VM (lookup "@meta:type:<naam>"), de veldtypen van een
// getypeerde ADT (fase D2) `__alts_<Type>` (preprocess/records.cfp). Een
// ongetypeerd veld is TUnknown "". Een Bool
// heeft geen eigen tag in de VM (True is 1), dus alleen de vorm weet dat een
// veld een Bool is.
module Shape
import "lib/text.spp" as T

::list = Nil | Cons !x xs

::Ty = TInt | TFloat | TStr | TBool | TChar | TList !elem | TRec !name fields | TSum !name alts | TUnknown !name

// Een constructor van een somtype; alts van een TSum is lui, zoals fields.
::Alt = Alt !name fields

// fields van een TRec is lui: een record mag (via een lijst) naar zichzelf verwijzen.
::Field = Field !name !ty

// == Een vorm vinden ==========================================================

// Uit de constructor van een record (`Klant`, een functiewaarde): funcName
// geeft "__con_Klant".
ofCon c = ofName (conName (funcName c))

conName s = if (T.startsWith "__con_" s) (T.drop 6 s) s

// Uit een waarde.
ofValue v = ofValueTid v (typeId v)

ofValueTid v tid =
  if (tid > 4) (ofAdtValue (constrName v) tid)
  (if (tid == 1) TInt
  (if (tid == 2) TFloat
  (if (tid == 3) TStr
  (if (tid == 0 - 1) TChar (TUnknown "")))))

// Een record heet als zijn constructor; een somtype zoeken we op type-id.
ofAdtValue con tid = if (typeId (lookup (T.append "__fields_" con)) == 4) (ofName con) (ofTypeInfo con (T.split '\t' (lookup (T.append "@meta:type:" (T.showInt tid)))))

// Een record of somtype op naam; anders TUnknown.
ofName name = ofNameH name (lookup (T.append "__fields_" name))

ofNameH name h = if (typeId h == 4) (TRec name (fieldsFrom (applyDynamic h Nil))) (ofTypeInfo name (T.split '\t' (lookup (T.append "@meta:type:" name))))

// "Naam\tCon\tariteit\t..." (vm/meta.h); een onbekend type is "".
ofTypeInfo name info =
  case info
    (Cons tn rest -> if (T.isEmpty tn) (TUnknown name) (TSum tn (altsFor tn rest (lookup (T.append "__alts_" tn)))))
    (Nil -> TUnknown name)

altsFor tn cons h = if (typeId h == 4) (mapL altOf (T.split ';' (applyDynamic h Nil))) (plainAlts cons)

// "Cirkel,r,Float" (preprocess/records.cfp)
altOf s = case (T.split ',' s) (Cons c rest -> Alt c (altFields rest)) (Nil -> Alt "" Nil)

altFields ws = case ws (Cons n r -> case r (Cons ty r2 -> Cons (Field n (if (T.equal ty "?") (TUnknown "") (parseTy ty))) (altFields r2)) (Nil -> Nil)) (Nil -> Nil)

// Zonder veldtypen: per veld TUnknown.
plainAlts cons = case cons (Cons c r -> case r (Cons a r2 -> Cons (Alt c (unknownFields (T.readInt a))) (plainAlts r2)) (Nil -> Nil)) (Nil -> Nil)

unknownFields !n = if (n <= 0) Nil (Cons (Field "" (TUnknown "")) (unknownFields (n - 1)))

fieldsFrom ps = case ps (Nil -> Nil) (Cons p rest -> Cons (fieldOf p) (fieldsFrom rest))

fieldOf p = case p (Cons n r -> case r (Cons ty r2 -> Field n (parseTy ty)) (Nil -> Field n (TUnknown ""))) (Nil -> Field "" (TUnknown ""))

// Een typenaam zoals in een recorddeclaratie.
parseTy s =
  if (T.equal s "Int") TInt
  (if (T.equal s "Float") TFloat
  (if (T.equal s "String" \/ T.equal s "Str") TStr
  (if (T.equal s "Bool") TBool
  (if (T.equal s "Char") TChar
  (if (isListName s) (TList (parseTy (T.slice 1 (strlen s - 2) s))) (ofName s))))))

isListName s = (strlen s >= 2) /\ (strat 0 s == '[') /\ (strat (strlen s - 1) s == ']')

// == Over een vorm ============================================================

isRec ty = case ty (TRec n fs -> True) (_ -> False)

isSum ty = case ty (TSum n as -> True) (_ -> False)

recName ty = case ty (TRec n fs -> n) (TSum n as -> n) (TUnknown n -> n) (_ -> "")

alts ty = case ty (TSum n as -> as) (_ -> Nil)

altName a = case a (Alt n fs -> n)

altFieldsOf a = case a (Alt n fs -> fs)

altNames ty = mapL altName (alts ty)

// De velden van constructor `con` van een somtype.
altFieldsFor ty con = altFieldsIn con (alts ty)

altFieldsIn con as = case as (Nil -> Nil) (Cons a rest -> if (T.equal (altName a) con) (altFieldsOf a) (altFieldsIn con rest))

fields ty = case ty (TRec n fs -> fs) (_ -> Nil)

fieldName f = case f (Field n t -> n)

fieldTy f = case f (Field n t -> t)

fieldNames ty = mapL fieldName (fields ty)

tyName ty =
  case ty
    (TInt -> "Int")
    (TFloat -> "Float")
    (TStr -> "String")
    (TBool -> "Bool")
    (TChar -> "Char")
    (TList e -> T.concat ["[", tyName e, "]"])
    (TRec n fs -> n)
    (TSum n as -> n)
    (TUnknown n -> if (T.isEmpty n) "?" n)

// == Waarden maken ============================================================

// Een waarde als een willekeurig type doorgeven (alleen voor de typechecker:
// een lijst velden van verschillende typen, zoals voor make).
::Dyn = Dyn x

dyn x = getField (Dyn x) 0

// make Klant ["Jan", True]: de constructor toegepast op de velden. De lijst
// wordt eerst helemaal opgebouwd (applyDynamic forceert de staart niet).
make c vs = applyDynamic c (strictList vs)

strictList xs = revL (revL xs Nil) Nil

revL xs acc = case xs (Nil -> acc) (Cons y ys -> revL ys (Cons y acc))

// Tekst omzetten volgens een vorm (voor CSV); een fout zegt wat er mis is.
fromText ty s =
  case ty
    (TInt -> if (isIntText s) (dyn (T.readInt s)) (error (T.concat ["geen geheel getal: \"", s, "\""])))
    (TFloat -> if (isNumText s) (dyn (T.readFloat s)) (error (T.concat ["geen getal: \"", s, "\""])))
    (TStr -> dyn s)
    (TBool -> boolText s)
    (TSum n as -> conText ty (T.trim s))
    (TChar -> if (strlen s == 1) (dyn (strat 0 s)) (error (T.concat ["geen teken: \"", s, "\""])))
    (_ -> error (T.concat ["kan geen ", tyName ty, " uit tekst maken: \"", s, "\""]))

// Een constructor zonder velden op naam (een CSV-kolom van type Kleur).
conText ty s = if (nullaryIn s (alts ty)) (lookup s) (error (T.concat ["geen ", tyName ty, ": \"", s, "\""]))

nullaryIn s as = case as (Nil -> False) (Cons a rest -> if (T.equal (altName a) s) (isNil (altFieldsOf a)) (nullaryIn s rest))

isNil xs = case xs (Nil -> True) (_ -> False)

boolText s =
  let t = T.toLower (T.trim s) in
  if (T.equal t "true" \/ T.equal t "1" \/ T.equal t "ja") (dyn True)
  (if (T.equal t "false" \/ T.equal t "0" \/ T.equal t "nee") (dyn False) (error (T.concat ["geen Bool: \"", s, "\""])))

// Een geheel getal: optioneel '-', dan minstens één cijfer.
isIntText s = isIntT (T.trim s)

isIntT t = if (strlen t == 0) False (if (strat 0 t == '-') (digitsAt t 1 (strlen t) False) (digitsAt t 0 (strlen t) False))

digitsAt t !i !n seen = if (i >= n) seen (if (T.isDigit (strat i t)) (digitsAt t (i + 1) n True) False)

// Een getal: een geheel getal, of met een punt en/of een exponent.
isNumText s = isNumT (T.trim s)

isNumT t = if (strlen t == 0) False (numFrom t (if (strat 0 t == '-') 1 0) (strlen t) False False False)

// d: een cijfer gezien; p: een punt gezien; e: een exponent gezien.
numFrom t !i !n d p e =
  if (i >= n) d
  (if (T.isDigit (strat i t)) (numFrom t (i + 1) n True p e)
  (if ((strat i t == '.') /\ notB p /\ notB e) (numFrom t (i + 1) n d True e)
  (if (((strat i t == 'e') \/ (strat i t == 'E')) /\ d /\ notB e) (expFrom t (i + 1) n)
  False)))

expFrom t !i !n = if (i >= n) False (if ((strat i t == '-') \/ (strat i t == '+')) (digitsAt t (i + 1) n False) (digitsAt t i n False))

notB b = if b False True

isBoolText s = let t = T.toLower (T.trim s) in T.equal t "true" \/ T.equal t "false"

// == Tonen volgens een vorm ===================================================

// v heeft per tak een ander type: via dyn, anders weigert de typechecker showAs.
showAs ty v =
  case ty
    (TInt -> T.showInt (dyn v))
    (TFloat -> ftoa (dyn v))
    (TStr -> dyn v)
    (TBool -> if (dyn v) "True" "False")
    (TChar -> T.fromChar (dyn v))
    (TList e -> T.concat ["[", T.join ", " (mapL (showAs e) (dyn v)), "]"])
    (TRec n fs -> T.concat [n, " { ", T.join ", " (showFields fs v 0), " }"])
    (TSum n as -> showAlt (altFieldsFor ty (constrName v)) v)
    (TUnknown n -> showPlain v)

// Een constructor met velden als `Cirkel 1.5 Rood` (velden met haakjes als
// ze een spatie bevatten).
showAlt fs v = T.join " " (Cons (constrName v) (mapL paren (showArgs fs v 0)))

showArgs fs v !i = case fs (Nil -> Nil) (Cons f rest -> Cons (showAs (fieldTy f) (getField v i)) (showArgs rest v (i + 1)))

paren s = if (T.contains " " s) (T.concat ["(", s, ")"]) s

showFields fs v !i = case fs (Nil -> Nil) (Cons f rest -> Cons (T.concat [fieldName f, " = ", showAs (fieldTy f) (getField v i)]) (showFields rest v (i + 1)))

showPlain v = ofPlainTid v (typeId v)

ofPlainTid v tid =
  if (tid == 1) (T.showInt (dyn v))
  (if (tid == 2) (ftoa (dyn v))
  (if (tid == 3) (dyn v)
  (if (tid == 0 - 1) (T.fromChar (dyn v))
  (if (tid > 4) (constrName v) "<fn>"))))

mapL f xs = case xs (Nil -> Nil) (Cons y ys -> Cons (f y) (mapL f ys))

// == Invoer uit een formulier (interactieve cellen) ===========================

// Een `D.Input veld tekst` (lib/display.spp) toepassen op een waarde: het
// veld met die naam van een record (of van de huidige constructor van een
// somtype) wordt de tekst, omgezet volgens zijn type. Veld "" is de hele
// waarde: een getal, tekst, of de naam van een constructor van een somtype;
// velden met dezelfde naam en hetzelfde type houden dan hun waarde, de rest
// krijgt een standaardwaarde (0, 0.0, "", False, 'a', [], de eerste
// constructor zonder velden). Een fout als het niet kan.
//
//   update ev m = case ev (D.Input veld s -> Sh.input veld s m) (_ -> m)
input field s v = inputAs (ofValue v) field s v

inputAs ty field s v =
  if (T.isEmpty field) (inputWhole ty s v)
  (case ty
    (TRec n fs -> setNamed v fs field s)
    (TSum n as -> setNamed v (altFieldsFor ty (constrName v)) field s)
    (_ -> error (T.concat ["geen veld ", field, " in een ", tyName ty])))

inputWhole ty s v = case ty (TSum n as -> switchTo ty (T.trim s) v) (_ -> fromText ty s)

setNamed v fs field s = setAt v (indexOfField field fs 0) fs s

setAt v !i fs s =
  if (i < 0) (error (T.concat ["geen veld met die naam in ", constrName v]))
  (make (lookup (constrName v)) (replaceAt i (fromText (fieldTy (nthL i fs)) s) (fieldValues v 0 (lenL fs))))

indexOfField name fs !i = case fs (Nil -> 0 - 1) (Cons f rest -> if (T.equal (fieldName f) name) i (indexOfField name rest (i + 1)))

fieldValues v !i n = if (i >= n) Nil (Cons (getField v i) (fieldValues v (i + 1) n))

replaceAt !i x xs = case xs (Nil -> Nil) (Cons y ys -> if (i == 0) (Cons x ys) (Cons y (replaceAt (i - 1) x ys)))

nthL !i xs = case xs (Cons y ys -> if (i == 0) y (nthL (i - 1) ys))

lenL xs = case xs (Nil -> 0) (Cons y ys -> 1 + lenL ys)

// Een andere constructor van een somtype.
switchTo ty con v = switchFields con (altFieldsFor ty con) (altFieldsFor ty (constrName v)) v (hasAlt con (alts ty))

hasAlt con as = case as (Nil -> False) (Cons a rest -> if (T.equal (altName a) con) True (hasAlt con rest))

switchFields con newFs oldFs v known =
  if (known == False) (error (T.concat ["geen constructor ", con]))
  (case newFs (Nil -> lookup con) (_ -> make (lookup con) (mapL (carryOver oldFs v) newFs)))

// Een veld met dezelfde naam en hetzelfde type houdt zijn waarde.
carryOver oldFs v f = carryFrom oldFs v f 0

carryFrom fs v f !i =
  case fs
    (Nil -> defaultOf (fieldTy f))
    (Cons g rest -> if (T.equal (fieldName g) (fieldName f) /\ T.equal (tyName (fieldTy g)) (tyName (fieldTy f))) (getField v i) (carryFrom rest v f (i + 1)))

defaultOf ty =
  case ty
    (TInt -> dyn 0)
    (TFloat -> dyn 0.0)
    (TStr -> dyn "")
    (TBool -> dyn False)
    (TChar -> dyn 'a')
    (TList e -> dyn Nil)
    (TSum n as -> firstNullary n as)
    (_ -> error (T.concat ["geen standaardwaarde voor ", tyName ty]))

firstNullary n as = case as (Nil -> error (T.concat ["geen standaardwaarde voor ", n])) (Cons a rest -> if (isNil (altFieldsOf a)) (lookup (altName a)) (firstNullary n rest))
