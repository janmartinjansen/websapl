// lib/csv.spp -- CSV lezen (26 september 2026).
// Plan: docs/2026-09-25_notebook_en_bibliotheken_plan.md, deel 2.3.
//
// Gebruik:  import "lib/csv.spp" as C
//           rijen = C.read "notebooks/data/fruit.csv"
//           C.column "prijs" rijen            -- ["1.20", "0.45", ...]
//           C.floats (C.column "prijs" rijen)  -- [1.2, 0.45, ...]
//           C.table rijen                      -- als tabel in de notebook
//
// Getypeerd (15 oktober 2026, docs/2026-10-15_notebook_integraal_plan.md fase B):
//           ::Verkoop = { !week : Int, !fruit : String, !kilo : Int, !prijs : Float, !opmerking : String }
//           verkopen = C.loadAs Verkoop "notebooks/data/fruit.csv"   -- [Verkoop]
//           t = C.load "notebooks/data/fruit.csv"   -- een Table: per kolom een herkend type
//           C.showTable t                           -- kop met de typen, bv. "prijs : Float"
//           C.floatsOf "prijs" t                    -- [1.2, 1.45, ...]
//
// Een tabel is een lijst rijen, een rij een lijst velden (gepakte strings);
// de eerste rij is de kop. Velden tussen aanhalingstekens mogen de
// scheider, regeleinden en `""` (een aanhalingsteken) bevatten. Regeleinden
// "\n" of "\r\n"; lege regels worden overgeslagen.
module Csv
import "lib/text.spp" as T
import "lib/display.spp" as D
import "lib/shape.spp" as Sh

::list = Nil | Cons !x xs

// == Lezen ===================================================================

read path = parse (readFile path)

parse text = parseWith ',' text

// Met een andere scheider, bv. parseWith ';' tekst.
parseWith sep s = rowsFrom sep s 0 (strlen s)

rowsFrom sep s !i !n = if (i >= n) Nil (rowNext sep s n (fieldsFrom sep s i n))

rowNext sep s n (fs, j) = if (isBlankRow fs) (rowsFrom sep s j n) (Cons fs (rowsFrom sep s j n))

isBlankRow fs = case fs (Cons f rest -> case rest (Nil -> T.isEmpty f) (_ -> False)) (Nil -> True)

// De velden van één rij vanaf i: (velden, positie na het regeleinde).
fieldsFrom sep s !i !n =
  if (i >= n) (Cons T.empty Nil, n)
  (if (strat i s == 34) (quotedFrom sep s (i + 1) n Nil) (plainFrom sep s i i n))

plainFrom sep s !a !k !n =
  if (k >= n) (afterField sep s k n (T.slice a (k - a) s))
  (if (isFieldEnd sep (strat k s)) (afterField sep s k n (T.slice a (k - a) s)) (plainFrom sep s a (k + 1) n))

isFieldEnd sep c = (c == sep) \/ (c == 10) \/ (c == 13)

// Binnen aanhalingstekens; `acc` is de omgekeerde char-lijst van het veld.
quotedFrom sep s !k !n acc =
  if (k >= n) (afterField sep s k n (T.fromChars (revL acc Nil)))
  (if (strat k s == 34) (quoteEnd sep s k n acc) (quotedFrom sep s (k + 1) n (Cons (strat k s) acc)))

quoteEnd sep s !k !n acc =
  if (k + 1 < n) (if (strat (k + 1) s == 34) (quotedFrom sep s (k + 2) n (Cons 34 acc)) (afterQuoted sep s (k + 1) n acc))
  (afterQuoted sep s (k + 1) n acc)

// Na het sluitende aanhalingsteken: eventuele rommel tot de scheider negeren.
afterQuoted sep s !k !n acc =
  if (k >= n) (afterField sep s k n (T.fromChars (revL acc Nil)))
  (if (isFieldEnd sep (strat k s)) (afterField sep s k n (T.fromChars (revL acc Nil))) (afterQuoted sep s (k + 1) n acc))

afterField sep s !j !n field =
  if (j >= n) (Cons field Nil, n)
  (if (strat j s == sep) (consField field (fieldsFrom sep s (j + 1) n))
  (if (strat j s == 13) (Cons field Nil, skipLf s (j + 1) n) (Cons field Nil, j + 1)))

skipLf s !j !n = if (j < n) (if (strat j s == 10) (j + 1) j) j

consField field (fs, k) = (Cons field fs, k)

revL xs acc = case xs (Nil -> acc) (Cons y ys -> revL ys (Cons y acc))

// == Kop en kolommen =========================================================

header rows = case rows (Cons h rest -> h) (Nil -> Nil)

body rows = case rows (Cons h rest -> rest) (Nil -> Nil)

// De waarden van één kolom (zonder de kop), op naam.
column name rows = columnAt (indexOfName name (header rows) 0) (body rows)

columnAt i rows = if (i < 0) (error "Csv.column: onbekende kolom") (mapL (\r -> nthOr i r) rows)

indexOfName name hs !i = case hs (Nil -> 0 - 1) (Cons h rest -> if (T.equal (T.trim h) name) i (indexOfName name rest (i + 1)))

nthOr i r = case r (Nil -> T.empty) (Cons f rest -> if (i == 0) f (nthOr (i - 1) rest))

// Velden als getallen.
floats xs = mapL T.readFloat xs

ints xs = mapL T.readInt xs

// Alleen de genoemde kolommen, in die volgorde (kop plus rijen).
select names rows = selectIdx (mapL (\nm -> indexOfName nm (header rows) 0) names) rows

selectIdx idxs rows = mapL (\r -> mapL (\i -> nthOr i r) idxs) rows

// Als tabel in de notebook: de kop boven, dan de rijen.
table rows = D.table (header rows) (body rows)

// == Getypeerd: zonder vorm (verkennen) =======================================

// Een veld met een herkend type; VEmpty voor een leeg veld.
::Value = VInt !n | VFloat !x | VStr !s | VBool !b | VEmpty

// names: de kop; types: per kolom een Sh.Ty; rows: per rij een lijst Value.
::Table = Table !names !types !rows

load path = typed (read path)

typed rows = typedWith (header rows) (body rows)

typedWith hs rs = typedTypes hs rs (colTypes 0 (lenL hs) rs)

typedTypes hs rs types = Table hs types (mapL (toValues types) rs)

names t = case t (Table n ty r -> n)

types t = case t (Table n ty r -> ty)

rowsOf t = case t (Table n ty r -> r)

typeNames t = mapL Sh.tyName (types t)

// Het type van een kolom: alles een geheel getal -> Int, anders alles een
// getal -> Float, anders alles true/false -> Bool, anders String. Lege
// velden tellen niet mee; een kolom zonder waarden is String.
colTypes !i n rs = if (i >= n) Nil (Cons (colType (nonEmpty (mapL (\r -> nthOr i r) rs))) (colTypes (i + 1) n rs))

colType vs =
  if (isNilL vs) Sh.TStr
  (if (allL Sh.isIntText vs) Sh.TInt
  (if (allL Sh.isNumText vs) Sh.TFloat
  (if (allL Sh.isBoolText vs) Sh.TBool Sh.TStr)))

nonEmpty vs = filterL (\v -> notB (T.isEmpty (T.trim v))) vs

toValues types r = case types (Nil -> Nil) (Cons ty rest -> Cons (toValue ty (headOr r)) (toValues rest (tailL r)))

toValue ty s =
  if (T.isEmpty (T.trim s)) VEmpty
  (case ty
    (Sh.TInt -> VInt (T.readInt s))
    (Sh.TFloat -> VFloat (T.readFloat s))
    (Sh.TBool -> VBool (T.equal (T.toLower (T.trim s)) "true"))
    (_ -> VStr s))

// De waarden van één kolom, op naam.
values name t = valuesAt name (indexOfName name (names t) 0) t

valuesAt name i t = if (i < 0) (error (T.concat ["Csv.values: onbekende kolom \"", name, "\""])) (mapL (\r -> nthValue i r) (rowsOf t))

nthValue i r = case r (Nil -> VEmpty) (Cons v rest -> if (i == 0) v (nthValue (i - 1) rest))

asInt v = case v (VInt n -> n) (VFloat x -> ftoi x) (_ -> error (T.append "Csv.asInt: geen getal: " (showValue v)))

asFloat v = case v (VInt n -> itof n) (VFloat x -> x) (_ -> error (T.append "Csv.asFloat: geen getal: " (showValue v)))

asStr v = showValue v

asBool v = case v (VBool b -> b) (_ -> error (T.append "Csv.asBool: geen Bool: " (showValue v)))

isEmptyValue v = case v (VEmpty -> True) (_ -> False)

intsOf name t = mapL asInt (values name t)

floatsOf name t = mapL asFloat (values name t)

strsOf name t = mapL asStr (values name t)

showValue v =
  case v
    (VInt n -> T.showInt n)
    (VFloat x -> ftoa x)
    (VStr s -> s)
    (VBool b -> if b "True" "False")
    (VEmpty -> "")

// Als tabel in de notebook, met het type in de kop.
showTable t = D.table (zipWithL (\n ty -> T.concat [n, " : ", Sh.tyName ty]) (names t) (types t)) (mapL (mapL showValue) (rowsOf t))

// == Getypeerd: met een vorm (een record) =====================================

// loadAs Verkoop pad: elke rij een Verkoop. De kolommen worden op veldnaam
// gezocht (de volgorde in het bestand doet er niet toe, extra kolommen
// worden genegeerd) en omgezet volgens het veldtype. Een ontbrekende kolom
// of een veld dat niet past geeft een fout met de rij en de kolom.
loadAs con path = recordsFrom con (read path)

recordsFrom con rows = recordsWith con (Sh.fields (Sh.ofCon con)) (header rows) (body rows)

recordsWith con fs hs rs =
  if (isNilL fs) (error (T.concat ["Csv.loadAs: ", funcName con, " is geen record"]))
  (recordsIdx con fs (mapL (\f -> fieldColumn f hs) fs) rs 2)

fieldColumn f hs = fieldColumnAt f (indexOfName (Sh.fieldName f) hs 0)

fieldColumnAt f i = if (i < 0) (error (T.concat ["Csv.loadAs: geen kolom \"", Sh.fieldName f, "\" in het bestand"])) i

recordsIdx con fs idxs rs !nr = case rs (Nil -> Nil) (Cons r rest -> Cons (Sh.make con (fieldValues fs idxs r nr)) (recordsIdx con fs idxs rest (nr + 1)))

fieldValues fs idxs r nr =
  case fs
    (Nil -> Nil)
    (Cons f frest -> case idxs (Cons i irest -> Cons (fieldValue f (nthOr i r) nr) (fieldValues frest irest r nr)) (Nil -> Nil))

fieldValue f s nr = try (Sh.fromText (Sh.fieldTy f) (fieldText (Sh.fieldTy f) s)) (cellError (Sh.fieldName f) nr)

// Een tekstveld houdt zijn spaties; een getal of Bool wordt eerst getrimd.
fieldText ty s = case ty (Sh.TStr -> s) (_ -> T.trim s)

cellError name nr msg = error (T.concat ["Csv.loadAs: rij ", T.showInt nr, ", kolom ", name, ": ", msg])

// == Lijsthulpjes ============================================================

mapL f xs = case xs (Nil -> Nil) (Cons y ys -> Cons (f y) (mapL f ys))

lenL xs = case xs (Nil -> 0) (Cons y ys -> 1 + lenL ys)

isNilL xs = case xs (Nil -> True) (_ -> False)

headOr xs = case xs (Nil -> T.empty) (Cons y ys -> y)

tailL xs = case xs (Nil -> Nil) (Cons y ys -> ys)

allL p xs = case xs (Nil -> True) (Cons y ys -> if (p y) (allL p ys) False)

filterL p xs = case xs (Nil -> Nil) (Cons y ys -> if (p y) (Cons y (filterL p ys)) (filterL p ys))

zipWithL f xs ys = case xs (Nil -> Nil) (Cons a as -> case ys (Nil -> Nil) (Cons b bs -> Cons (f a b) (zipWithL f as bs)))

notB b = if b False True
