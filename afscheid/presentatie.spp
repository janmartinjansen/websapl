import "lib/list.spp" as L
import "lib/text.spp" as T
//%% [markdown]
// ## Starting Point
//
// - **IFL 2016 Conference Paper**
// - Description of a small Virtual Machine: **JMVM**
// - Aimed at the execution of Lazy Functional Languages
// - A small prototype FP language **Sapl**
// - Description of a compiler for Sapl
// - A prototype implementation of the VM and a compiler:
//   - VM in **1500 lines of C**
//   - Sapl compiler in **1000 lines Amanda**
// - The VM can run in **browser Apps**!
// - The VM is **fast**! Stays within a factor of 5 of state-of-the-art implementations of FP languages like Clean and Haskell!
//
// <div style="text-align: center; margin: 18px 0 14px;">
//   <img src="afscheid/paper_first_page.png" alt="IFL 2016 Paper - A Portable VM-based implementation Platform for non-strict Functional Programming Languages" style="max-height: 420px; border: 1px solid var(--border, #444); box-shadow: 0 4px 16px rgba(0,0,0,0.35); border-radius: 6px;" />
// </div>
//%%
D.table ["Component (2016)", "Implementation", "Size / Key property"]
  [ ["Virtual Machine (JMVM)", "C / JavaScript / asm.js", "~1500 lines C"],
    ["Prototype Language (Sapl)", "Lazy functional core semantics", "Non-strict intermediate language"],
    ["Compiler", "Amanda (via ama interpreter)", "~1000 lines Amanda"],
    ["Execution Platform", "Native & Browser apps", "Portable client-side execution"],
    ["Performance Target", "Within 5x of Clean & Haskell", "Fast graph reduction"] ]
