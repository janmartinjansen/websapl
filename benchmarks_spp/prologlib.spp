// Shared library for parsetest.spp/prolog.spp: a monadic parser-combinator
// library (pSymbol/pSatisfy/seq/choice/...) plus a small Prolog-style
// unification/resolution engine on top of it. `#import`ed by both entry
// points (preprocess/importexpand.cfp splices this in as plain text before
// parsing, so it can use full Sapl+ syntax itself -- see PLAN.md section 5).
//
// `::Tup` (the parser combinators' own "result, remainder" pairs) becomes
// a real, non-strict Sapl+ tuple `(a, b)` -- safe, since the original
// `::Tup = Tup a b` was ALREADY non-strict, so this changes nothing
// observable. `::ProTup` (variable/term bindings in the unification
// environment) stays a hand-declared ADT with its ORIGINAL strict fields
// (`ProTup !a !b`) -- deliberately NOT converted to a tuple, because Sapl+
// tuple fields are always lazy, and eval.spp (this repo's earlier
// benchmarks_spp/ session) already found a real regression from silently
// changing a list/tuple's strictness in a lazy language; no reason to
// gamble on that here too when the original made a specific choice.
//
// Every `case` dispatch becomes flat pattern-definition clauses; nested
// dispatches (`uni`, `isSingle`) become single clauses with nested/2-column
// patterns. Where an original `if (n == 0) ... (case xs ...)` genuinely
// forces its FIRST argument before ever looking at the second (`el`,
// `take`, `drop`), the pattern-definition keeps that same evaluation
// order deliberately (a guard, or a tiny helper split, instead of a
// literal-0 argument pattern) -- a literal pattern in that position would
// make the decision-tree compiler pick THAT column as the primary
// discriminant instead, silently forcing the arguments in a different
// order than the original, which matters in a lazy language (see
// eval.spp's own header for the concrete case that taught this lesson).
// `fromto`/hand-nested `Cons`-chains for a fixed program text become
// `[a..b]` range syntax and `[e1, e2, ...]` list literals.
::list = Nil | Cons !x xs
::ProTup = ProTup !a !b
::Maybe = Just !a | Nothing
::Term = Con !c | Var !v | Fun !n !ts
::Rule = Rule !t !ts

fst (a, b) = a
snd (a, b) = b

hd (x:xs) = x
tl (x:xs) = xs

length Nil = 0
length (x:xs) = 1 + length xs

from a = Cons a (from (a + 1))

el n (x:xs)
  | n == 0 = x
  | otherwise = el (n - 1) xs
el n Nil = 111

zip Nil ys = Nil
zip (x:xs) Nil = Nil
zip (x:xs) (y:ys) = Cons (x, y) (zip xs ys)

take 0 xs = Nil
take n xs = takeNonzero n xs
takeNonzero n Nil = Nil
takeNonzero n (x:xs) = Cons x (take (n - 1) xs)

drop 0 xs = xs
drop n xs = dropNonzero n xs
dropNonzero n Nil = Nil
dropNonzero n (x:xs) = drop (n - 1) xs

filter p Nil = Nil
filter p (a:as)
  | p a = Cons a (filter p as)
  | otherwise = filter p as

map f Nil = Nil
map f (x:xs) = Cons (f x) (map f xs)

append Nil ys = ys
append (x:xs) ys = Cons x (append xs ys)

concat Nil = Nil
concat (Nil:yss) = concat yss
concat ((a:as):yss) = Cons a (concat (Cons as yss))

merge Nil ys = ys
merge xs Nil = xs
merge (a:as) (b:bs)
  | a == b = Cons a (merge as bs)
  | a < b = Cons a (merge as (Cons b bs))
  | otherwise = Cons b (merge (Cons a as) bs)

foldl f z Nil = z
foldl f z (x:xs) = foldl f (f z x) xs

foldr f z Nil = z
foldr f z (x:xs) = f x (foldr f z xs)

sum Nil = 0
sum (x:xs) = x + sum xs

eqlist Nil Nil = True
eqlist Nil (y:ys) = False
eqlist (x:xs) Nil = False
eqlist (x:xs) (y:ys) = (x == y) /\ eqlist xs ys

gtlist Nil bs = False
gtlist (x:xs) Nil = True
gtlist (x:xs) (y:ys) = (x > y) \/ gtlist xs ys

pSymbol a Nil = Nil
pSymbol a (x:xs)
  | x == a = [(x, xs)]
  | otherwise = Nil

pSatisfy p Nil = Nil
pSatisfy p (x:xs)
  | p x = [(x, xs)]
  | otherwise = Nil

do1 f (x, zs) = (f x, zs)
do2 q (f, ys) = map (do1 f) (q ys)

dt Nil = Nil
dt (r:xs) = [r]

null Nil = True
null (x:xs) = False

pSequence Nil = pSucceed Nil
pSequence (p:ps) = seq (seqapply list p) (pSequence ps)

tag n (Con x) = Con x
tag n (Var x) = Var (n + 10 * x)
tag n (Fun x xs) = Fun x (map (tag n) xs)

tagRule n (Rule c cs) = Rule (tag n c) (map (tag n) cs)

lookUp bs (Var x) = look bs x
lookUp bs t = t

look Nil x = Var x
look ((ProTup z t):bs) x
  | x == z = lookUp bs t
  | otherwise = look bs x

unify (ProTup t u) (Just bs) = uni (lookUp bs t) (lookUp bs u) bs
unify d Nothing = Nothing

uni (Con x) (Con y) bs
  | x != y = Nothing
  | otherwise = Just bs
uni (Con x) (Var y) bs = Just (bind y (Con x) bs)
uni (Con x) (Fun y ys) bs = Nothing
uni (Var x) p1 bs = Just (bind x p1 bs)
uni (Fun x xs) (Con y) bs = Nothing
uni (Fun x xs) (Var y) bs = Just (bind y (Fun x xs) bs)
uni (Fun x xs) (Fun y ys) bs
  | eqlist x y /\ (length xs == length ys) = foldr unify (Just bs) (zip xs ys)
  | otherwise = Nothing

solve rules Nil e n = [e]
solve rules (t:ts) e n = concat (map (compose (ff e t rules ts n) (tagRule n)) rules)

ff e t rules ts n (Rule c cs) = fh rules ts n cs (unify (ProTup t c) e)

fh rules ts n cs (Just p40) = solve rules (append cs ts) (Just p40) (n + 1)
fh rules ts n cs Nothing = Nil

isSingle (Rule (Fun f fs) cs) = (length fs == 1) /\ (length cs == 0)

list x xs = Cons x xs
nott a = if a False True
repeat 0 x = Nil
repeat n x = Cons x (repeat (n - 1) x)
compose f g x = f (g x)
flip f a b = f b a
pToken k xs
  | eqlist k (take (length k) xs) = [(k, drop (length k) xs)]
  | otherwise = Nil
pFailp xs = Nil
pSucceed r xs = [(r, xs)]
choice p q xs = append (p xs) (q xs)
seq p q xs = concat (map (do2 q) (p xs))
seqapply f p = seq (pSucceed f) p
option p d = choice p (pSucceed d)
konst f x = f
seqleft p q = seq (seqapply konst p) q
seqright p q = seq (seqapply (flip konst) p) q
seqapplyleft f p = seqapply (konst f) p
pMany p = option (seq (seqapply list p) (pMany p)) Nil
pMany1 p = seq (seqapply list p) (pMany p)
pPack p r q = seqleft (seqright p r) q
pListSep p s = seq (seqapply list p) (pMany (seqright s p))
determ p xs = dt (p xs)
greedy p = determ (pMany p)
greedy1 p = determ (pMany1 p)
pDigit = pSatisfy isDigit
isDigit c = (c >= '0') /\ (c <= '9')
isAlpha c = (c >= 'a' /\ c <= 'z') \/ (c >= 'A' /\ c <= 'Z')
isAlphaNum c = isAlpha c \/ isDigit c
pDigAsInt = seqapply dig2num pDigit
dig2num c = c - '0'
pNatural = seqapply (foldl makeNum 0) (pMany1 pDigAsInt)
makeNum a b = a * 10 + b
pInteger = seq (option (seqapplyleft negate (pSymbol '-')) id) pNatural
pNeg = seq (seqapplyleft negate (pSymbol '-')) pNatural
pNeg2 = seqapply negate (seqright (pSymbol '-') pNatural)
negate a = 0 - a
id x = x
pIdentifier = seq (seqapply list (pSatisfy isAlpha)) (greedy (pSatisfy isAlphaNum))
pParens p = pPack (pSymbol '(') p (pSymbol ')')
pCommaList p = pListSep p (pSymbol ',')
lchoice = foldr option pFailp
numlist = pPack (pSymbol '[') (pCommaList pInteger) (pSymbol ']')
numidlist = pPack (pSymbol '[') (pCommaList (choice pInteger pIdentifier)) (pSymbol ']')
getres f = fst (hd f)
con n = Con n
var n = Var n
fun n ns = Fun n ns
rule r rs = Rule r rs
pCon = seqapply con pInteger
pVar = seqapply var (seqright (pSymbol 'X') pInteger)
pFun = seq (seqapply fun pIdentifier) (choice (pParens (pListSep pTerm pComma)) (pSucceed Nil))
pTerm = choice (choice pCon pVar) pFun
pRule = seqleft (seq (seqapply rule pTerm) (option pRightHandSide Nil)) (pSymbol '.')
pRightHandSide = seqright (seqright (pSymbol ':') (pSymbol '-')) (pListSep pTerm pComma)
pComma = pSymbol ','
isSpace x = x == ' ' \/ x == '\n'
pStart p xs = fst (hd (p (filter (compose nott isSpace) xs)))
parseTerm = pStart pTerm
parseRules prog = pStart (pMany pRule) prog
parseRule = pStart pRule
emptyEnv = Just Nil
bind v t bs = Cons (ProTup v t) bs

str2list s = strls 0 s
strls n s = if (n < strlen s) (Cons (strat n s) (strls (n + 1) s)) Nil

printstrlist Nil = 0
printstrlist (c:cs) = printC c <#> printstrlist cs

prog = concat (map str2list [line1, line2, line3, line4, line5, line6, line7, line8, line9,
                              line10, line11, line12, line13, line14, line15, line16, line17])
prog2 = concat [prog, prog]
prog3 = concat [prog, prog, prog]
prog10 = concat [prog, prog, prog, prog, prog, prog, prog, prog, prog, prog]
prog20 = concat [prog10, prog10]
prog30 = concat [prog10, prog10, prog10]
prog40 = concat [prog10, prog10, prog10, prog10]
prog50 = concat [prog10, prog10, prog10, prog10, prog10]
prog100 = concat [prog10, prog10, prog10, prog10, prog10, prog10, prog10, prog10, prog10, prog10]

line1 = "man(jan)."
line2 = "man(mark)."
line3 = "vrouw(margriet)."
line4 = "vrouw(marit)."
line5 = "ouder(jan,mark)."
line6 = "ouder(jan,marit)."
line7 = "ouder(margriet,marit)."
line8 = "ouder(margriet,mark)."
line9 = "moeder(X1,X2) :- ouder(X1,X2),vrouw(X1)."
line10 = "vader(X1,X2) :- ouder(X1,X2),man(X1)."
line11 = "ouder(joop,jan)."
line12 = "ouder(nel,jan)."
line13 = "grootouder(X1,X2) :- ouder(X1,X3),ouder(X3,X2)."
line14 = "voorouder(X1,X2) :- ouder(X1,X2)."
line15 = "voorouder(X1,X2) :- ouder(X1,X3),voorouder(X3,X2)."
line16 = "ouder(siem,nel)."
line17 = "ouder(cornelia,nel)."

sol rules inp n = length (solve rules [parseTerm inp] emptyEnv 0)
msol n = sum (map (sol (parseRules prog) (str2list "voorouder(X1,marit)")) [1..n])
unitest f s = unify (ProTup (parseTerm (str2list f)) (parseTerm (str2list s))) emptyEnv

parsetest 0 = Nil
parsetest n = Cons (length (filter isSingle (parseRules prog100))) (parsetest (n - 1))

printlist Nil = 0
printlist (x:xs) = print x <#> printlist xs
