//%% [markdown]
// # Interactieve cellen: een model dat reageert
//
// `D.interactive model0 update view` maakt een cel met een eigen model, zoals
// in Elm. `view model` bepaalt wat je ziet (een plaatje, tabel of tekst); een
// klik in de uitvoer of een toets (klik eerst in de uitvoer, dan heeft die de
// focus) is een `D.Event`, en `update gebeurtenis model` geeft het volgende
// model. `D.animated ms ...` geeft daarnaast elke `ms` milliseconden een
// `D.Tick`.
//
// Het model staat in de sessie, niet in het bestand: de cel opnieuw
// uitvoeren begint weer bij `model0`. Met **waarden bewaren** aan komt het
// model wel terug in een volgende sessie (de pagina herladen); zie het
// notebook *Waarden bewaren*. Onder de uitvoer staat hoe lang één
// gebeurtenis duurt (heen en terug). Zet **code verbergen** bovenin aan (of
// klap een losse codecel in met **inklappen**) om je op de plaatjes en
// instellingen te concentreren.
//%% [markdown]
// ## De zeef van Eratosthenes, stap voor stap
//
// Elke klik (of toets) zoekt het volgende priemgetal `p` (groen) en streept
// zijn veelvouden door (grijs).
//%%
import "lib/list.spp" as L
import "lib/text.spp" as T

::Zeef = { !p : Int, !weg : [Int] }

grens = 60
kolommen = 10

zeefBegin = Zeef 1 []

zeefStap ev z = case ev
  (D.Click x y -> volgende z)
  (D.Key k -> volgende z)
  (_ -> z)

volgende z = case (L.filter (\m -> L.elem m (weg z) == False) (L.range (p z + 1) grens))
  (Nil -> z)
  (Cons q rest -> Zeef q (L.append (weg z) [q * q, q * q + q .. grens]))

zeefBeeld z = D.picture (L.concatMap (vakje z) (L.range 2 grens))

vakje z m =
  let k = m - 2,
      x = itof (k % kolommen) * 0.19 - 0.88,
      y = 0.8 - itof (k / kolommen) * 0.3,
      kleur = if (L.elem m (weg z)) 8 (if (m <= p z) 10 15) in
  [G.GraphDisc kleur (G.Pt (x - 0.08) (y - 0.12)) (G.Pt (x + 0.08) (y + 0.12)),
   G.GraphText 0 (G.Pt (x - 0.05) (y - 0.03)) (T.showInt m)]
//%%
D.interactive zeefBegin zeefStap zeefBeeld
//%% [markdown]
// ## Een bal die stuitert
//
// Elke 40 ms een `Tick`: de bal beweegt en kaatst tegen de randen. Een klik
// zet de bal op die plek; een toets keert de richting om.
//%%
::Bal = { !bx : Float, !by : Float, !vx : Float, !vy : Float }

balBegin = Bal 0.0 0.0 0.031 0.022

balStap ev b = case ev
  (D.Tick t -> beweeg b)
  (D.Click x y -> Bal x y (vx b) (vy b))
  (D.Key k -> Bal (bx b) (by b) (0.0 - vx b) (0.0 - vy b))
  (_ -> b)

beweeg b =
  let nvx = if (bx b + vx b > 0.9 \/ bx b + vx b < 0.0 - 0.9) (0.0 - vx b) (vx b),
      nvy = if (by b + vy b > 0.9 \/ by b + vy b < 0.0 - 0.9) (0.0 - vy b) (vy b) in
  Bal (bx b + nvx) (by b + nvy) nvx nvy

balBeeld b = D.picture
  [G.GraphRectangle 7 (G.Pt (0.0 - 0.95) (0.0 - 0.95)) (G.Pt 0.95 0.95),
   G.GraphDisc 12 (G.Pt (bx b - 0.06) (by b - 0.06)) (G.Pt (bx b + 0.06) (by b + 0.06))]
//%%
D.animated 40 balBegin balStap balBeeld
//%% [markdown]
// ## Een formulier in een interactieve cel
//
// Toont `view` een formulier, dan wordt een wijziging een `D.Input veld
// waarde` voor `update` (in een gewone cel komt een wijziging in de
// brontekst). `Sh.input` (lib/shape.spp) zet de tekst om volgens het type van
// het veld en past hem toe op het record; `D.column` zet het formulier boven
// het plaatje. De figuur draait met de klok mee; pas de instellingen aan
// terwijl hij draait.
//%%
import "lib/shape.spp" as Sh

::Kleur = Rood | Groen | Blauw

::Instelling = { !fx : Int, !fy : Int, !kleur : Kleur, !lijn : Bool }

::Figuur = { !inst : Instelling, !fase : Float }

figBegin = Figuur (Instelling 3 2 Blauw True) 0.0

figStap ev f = case ev
  (D.Input veld s -> Figuur (Sh.input veld s (inst f)) (fase f))
  (D.Tick t -> Figuur (inst f) (fase f + 0.04))
  (_ -> f)

figBeeld f = D.column [D.form (inst f), D.picture (lissajous (inst f) (fase f))]

kleurNr k = case k (Rood -> 12) (Groen -> 10) (Blauw -> 9)

lissajous i ph =
  let pts = [ G.Pt (0.9 * sin (itof (fx i) * t + ph)) (0.9 * sin (itof (fy i) * t)) | t <- L.map (\k -> itof k * 0.0315) (L.range 0 200) ] in
  if (lijn i) [G.GraphPolyLine (kleurNr (kleur i)) pts]
    (L.map (stip (kleurNr (kleur i))) pts)

stip c p = case p (G.Pt x y -> G.GraphDisc c (G.Pt (x - 0.012) (y - 0.012)) (G.Pt (x + 0.012) (y + 0.012)))
//%%
D.animated 40 figBegin figStap figBeeld
//%% [markdown]
// ## Een draaiende kubus
//
// De twaalf ribben van een kubus in 3D, geroteerd om de x- en y-as en met
// perspectief geprojecteerd op het vlak. Klik in het plaatje om de kubus
// naar dat punt te kantelen; een toets (met de focus op het plaatje)
// pauzeert of hervat het draaien.
//%%
::Pt3 = Pt3 !x !y !z
::Rib = Rib !van !naar

::Kubus = { !hoekX : Float, !hoekY : Float, !draait : Bool }

kubusBegin = Kubus 0.4 0.6 True

kubusPunten =:
  let r = [0.0 - 0.55, 0.55] in
  [Pt3 x y z | x <- r, y <- r, z <- r]

kubusRibben =:
  let r = [0.0 - 0.55, 0.55] in
  L.concat
    [[Rib (Pt3 (0.0 - 0.55) a b) (Pt3 0.55 a b) | a <- r, b <- r],
     [Rib (Pt3 a (0.0 - 0.55) b) (Pt3 a 0.55 b) | a <- r, b <- r],
     [Rib (Pt3 a b (0.0 - 0.55)) (Pt3 a b 0.55) | a <- r, b <- r]]

draaiX phi p = case p (Pt3 x y z -> Pt3 x (cos phi * y - sin phi * z) (sin phi * y + cos phi * z))

draaiY phi p = case p (Pt3 x y z -> Pt3 (cos phi * x + sin phi * z) y (cos phi * z - sin phi * x))

projecteer p = case p (Pt3 x y z -> G.Pt (1.6 * x / (z + 2.4)) (1.6 * y / (z + 2.4)))

hoekPunt k p = projecteer (draaiX (hoekX k) (draaiY (hoekY k) p))

tekenRib k rib = case rib (Rib p q -> G.GraphPolyLine 11 [hoekPunt k p, hoekPunt k q])

kubusStap ev k = case ev
  (D.Tick t -> if (draait k) (Kubus (hoekX k + 0.025) (hoekY k + 0.038) True) k)
  (D.Click x y -> Kubus (0.0 - y * 1.5) (x * 1.5) (draait k))
  (D.Key toets -> Kubus (hoekX k) (hoekY k) (if (draait k) False True))
  (_ -> k)

kubusBeeld k =
  D.picture
    (L.append
      (L.map (tekenRib k) kubusRibben)
      (L.map (\p -> stip 14 (hoekPunt k p)) kubusPunten))
//%%
D.animated 40 kubusBegin kubusStap kubusBeeld
//%% [markdown]
// ## Ruimtevullende curves (Hilbert, Sierpinski en Tartan), stap voor stap
//
// Uit het oorspronkelijke Amanda-programma (`grafisch/CURVES.AMA`): `tcat`
// plakt het volgende deelplaatje relatief aan het eindpunt van het vorige,
// waarmee `hilb`, `sier` en `tart` elk uit vier gedraaide/verschoven kopieën
// van het vorige niveau bestaan. Kies de `soort`, het `niveau` (1 t/m 5) en de
// `snelheid` (lijnstukken per tik) in het formulier: de curve wordt lijnstuk
// voor lijnstuk getekend, met een rode punt op de tekenpen. Klik in het
// plaatje om opnieuw te beginnen; `pauze` (of een toets) zet het tekenen stil.
//%%
::Curve = Hilbert | Sierpinski | Tartan

::CurveInst = { !soort : Curve, !niveau : Int, !snelheid : Int, !pauze : Bool }

::CurveModel = { !cInst : CurveInst, !getekend : Int }

curveBegin = CurveModel (CurveInst Hilbert 3 1 False) 2

begrens lo hi n = if (n < lo) lo (if (n > hi) hi n)

spiegelX p = case p (G.Pt x y -> G.Pt (0.0 - x) y)
spiegelY p = case p (G.Pt x y -> G.Pt x (0.0 - y))
draai90 p = case p (G.Pt x y -> G.Pt (0.0 - y) x)
draai270 p = case p (G.Pt x y -> G.Pt y (0.0 - x))
verschuif dx dy p = case p (G.Pt x y -> G.Pt (x + dx) (y + dy))

tcat xs ys = case (L.last xs) (G.Pt lx ly -> L.append xs (L.map (verschuif lx ly) ys))

tcat4 a b c d = tcat (tcat (tcat a b) c) d

hilbStap v =
  tcat4
    (L.map (\p -> spiegelX (draai90 p)) v)
    (L.map (verschuif 1.0 0.0) v)
    (L.map (verschuif 0.0 1.0) v)
    (L.map (\p -> verschuif (0.0 - 1.0) 0.0 (spiegelY (draai90 p))) v)

hilb n = if (n <= 0) [G.Pt 0.0 0.0] (hilbStap (hilb (n - 1)))

sierStap v =
  tcat4
    v
    (L.map (\p -> verschuif (0.0 - 1.0) 1.0 (draai90 p)) v)
    (L.map (\p -> verschuif 0.0 1.0 (draai270 p)) v)
    (L.map (verschuif 1.0 1.0) v)

sier n = if (n <= 0) [G.Pt 0.0 0.0] (sierStap (sier (n - 1)))

tartStap v =
  tcat4
    v
    (L.map (\p -> verschuif 1.0 1.0 (draai90 p)) v)
    (L.map (\p -> verschuif 1.0 1.0 (draai270 p)) v)
    (L.map (verschuif 1.0 1.0) v)

tart n = if (n <= 0) [G.Pt 0.0 0.0, G.Pt 10.0 10.0] (tartStap (tart (n - 1)))

ptX p = case p (G.Pt x y -> x)
ptY p = case p (G.Pt x y -> y)

passend pts =
  let xs = L.map ptX pts,
      ys = L.map ptY pts,
      x0 = L.minimum xs, x1 = L.maximum xs,
      y0 = L.minimum ys, y1 = L.maximum ys,
      dx = x1 - x0, dy = y1 - y0,
      span = if (dx > dy) dx dy,
      s = if (span > 0.0) (1.55 / span) 1.0,
      mx = (x0 + x1) * 0.5,
      my = (y0 + y1) * 0.5 in
  [G.Pt ((ptX p - mx) * s) ((ptY p - my) * s - 0.04) | p <- pts]

hilbertRoutes =: [ passend (hilb k) | k <- [1 .. 5] ]
sierpinskiRoutes =: [ passend (sier k) | k <- [1 .. 5] ]
tartanRoutes =: [ passend (tart k) | k <- [1 .. 5] ]

curveRoute c niv =
  let k = begrens 1 5 niv - 1 in
  case c
    (Hilbert -> L.nth k hilbertRoutes)
    (Sierpinski -> L.nth k sierpinskiRoutes)
    (Tartan -> L.nth k tartanRoutes)

curveKleur c = case c (Hilbert -> 11) (Sierpinski -> 14) (Tartan -> 10)
curveNaam c = case c (Hilbert -> "Hilbert") (Sierpinski -> "Sierpinski") (Tartan -> "Tartan")

aantalCurve c n =
  let basis = case c (Tartan -> 2) (_ -> 1) in
  basis * L.foldl (\a b -> a * 4) 1 (L.range 1 (begrens 1 5 n))

curveInvoer veld s h =
  let oud = cInst h,
      nieuw = Sh.input veld s oud,
      herstart = (soort nieuw != soort oud) \/ (begrens 1 5 (niveau nieuw) != begrens 1 5 (niveau oud)) in
  CurveModel nieuw (if herstart 2 (getekend h))

curvePauze h =
  let i = cInst h in
  CurveModel (CurveInst (soort i) (niveau i) (snelheid i) (if (pauze i) False True)) (getekend h)

curveTik h =
  let i = cInst h,
      tot = aantalCurve (soort i) (niveau i),
      stap = begrens 1 64 (snelheid i),
      volgende = getekend h + stap in
  if (pauze i) h (CurveModel i (if (getekend h >= tot + 20 * stap) 2 volgende))

curveStap ev h = case ev
  (D.Input veld s -> curveInvoer veld s h)
  (D.Click x y -> CurveModel (cInst h) 2)
  (D.Key k -> curvePauze h)
  (D.Tick t -> curveTik h)
  (_ -> h)

curveBeeld h =
  let i = cInst h,
      c = soort i,
      niv = begrens 1 5 (niveau i),
      pts = curveRoute c niv,
      tot = aantalCurve c niv,
      nu = begrens 1 tot (getekend h),
      deel = L.take nu pts,
      kop = L.last deel,
      tekst = T.concat [curveNaam c, " (niveau ", T.showInt niv, "): ", T.showInt (nu - 1), " / ", T.showInt (tot - 1), " lijnstukken"] in
  D.column
    [D.form i,
     D.picture
       [G.GraphPolyLine (curveKleur c) deel,
        stip 12 kop,
        G.GraphText 7 (G.Pt (0.0 - 0.78) 0.86) tekst]]
//%%
D.animated 40 curveBegin curveStap curveBeeld
