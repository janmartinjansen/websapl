//%% [markdown]
// # Kennismaking met de Sapl-notebook
//
// Elke cel is een blok **definities** of precies **één expressie**. Een
// expressiecel toont haar waarde; een `Display`-waarde (uit
// `lib/display.spp`, beschikbaar als `D`) wordt een tabel of plaatje.
// Alle cellen samen vormen één programma, dus de volgorde van
// definities doet er niet toe.
//%%
import "lib/list.spp" as L

priemen = zeef (L.from 2)

zeef xs = case xs (Cons p rest -> Cons p (zeef (L.filter (\x -> x % p != 0) rest)))
//%%
L.take 15 priemen
//%% [markdown]
// Oneindige lijsten zijn gewone data. Zonder `take` toont de notebook de
// eerste 100 elementen:
//%%
priemen
//%%
D.table ["n", "n-de priemgetal", "kwadraat"] [ [n + 1, p, p * p] | (n, p) <- L.take 8 (L.indexed priemen) ]
//%%
D.bar (L.map (\p -> p % 10) (L.take 12 priemen))
//%%
D.lineChart (L.take 20 priemen)
//%% [markdown]
// Een eigen type krijgt een rijke weergave met een haak
// `render_<Constructor>`, die een `Display` teruggeeft:
//%%
::Temperatuur = Celsius !graden

render_Celsius t = case t (Celsius g -> D.text (strcat "🌡 " (strcat (list2str (itoa g)) " °C")))
//%%
Celsius 21
//%% [markdown]
// Tekst: `lib/text.spp` werkt op gewone strings (`"..."`).
//%%
import "lib/text.spp" as T

zin = "  de kat krabt de krullen van de trap  "
//%%
D.table ["woord", "lengte"] [ [T.toUpper w, T.length w] | w <- T.words zin ]
//%%
T.join " | " (L.map (T.padLeft 4) (L.map T.showInt (L.take 6 priemen)))
//%% [markdown]
// Een **type-cel** toont per regel het type van een expressie; een
// **λ-cel** is pure lambda-calculus (`lc_repl`). Shift+Enter voert één cel
// uit, met de cellen die ervan afhangen.
//%% [type]
// zeef
// L.take 15 priemen
// T.padLeft 4
//%% [lc]
// Y = \f.(\x. f (x x)) (\x. f (x x))
// fact = Y (\self n. eq n 0 1 (mult n (self (sub n 1))))
// :seval fact 10
// :db \f x. f (f x)
// :blc \x y. x
//%%
D.picture [G.GraphDisc 12 (G.Pt (0.0 - 0.5) (0.0 - 0.5)) (G.Pt 0.5 0.5), G.GraphText 15 (G.Pt (0.0 - 0.2) 0.0) "Sapl"]
