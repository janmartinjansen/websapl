//%% [markdown]
// # Data verkennen: een kleine fruitverkoop
//
// De gegevens staan in `notebooks/data/fruit.csv` (verzonnen cijfers).
// `lib/csv.spp` leest ze, `lib/stats.spp` rekent, `lib/plot.spp` tekent.
//
// Een rij is een `Verkoop`, een record met een type per veld; `C.loadAs`
// zoekt de kolommen op naam en zet elk veld om (een fout zegt welke rij en
// kolom niet past).
//%%
import "lib/csv.spp" as C
import "lib/stats.spp" as S
import "lib/plot.spp" as P
import "lib/list.spp" as L
import "lib/text.spp" as T

::Verkoop = { !week : Int, !fruit : String, !kilo : Int, !prijs : Float, !opmerking : String }

verkopen = C.loadAs Verkoop "notebooks/data/fruit.csv"

appels = [ v | v <- verkopen, T.equal (fruit v) "appels" ]
peren  = [ v | v <- verkopen, T.equal (fruit v) "peren" ]

kilos vs = L.map kilo vs
prijzen vs = L.map prijs vs
//%%
D.records verkopen
//%%
D.table ["", "appels", "peren"] [["kilo totaal", S.sum (kilos appels), S.sum (kilos peren)], ["gem. prijs", T.showFixed 2 (S.mean (prijzen appels)), T.showFixed 2 (S.mean (prijzen peren))]]
//%% [markdown]
// Verkopen de peren beter naarmate ze goedkoper worden?
//%%
P.scatterFit (prijzen peren) (kilos peren)
//%%
S.correlation (prijzen peren) (kilos peren)
//%%
P.bars ["w1", "w2", "w3", "w4"] (kilos appels)
//%%
P.line [1, 2, 3, 4] (prijzen appels)
//%% [markdown]
// Zonder record: `C.load` herkent per kolom zelf het type (alles een geheel
// getal: `Int`, alles een getal: `Float`, anders `String`).
//%%
C.showTable (C.load "notebooks/data/fruit.csv")
