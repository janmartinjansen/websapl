//%% [markdown]
// # Formulieren: een waarde instellen en zien wat er verandert
//
// `D.form x` toont de definitie `x` als formulier, `D.slider lo hi x` als
// schuifbalk en `D.choice opties x` als keuzelijst. Een wijziging komt in de
// brontekst van die definitie terecht (kijk naar de cel erboven), en alleen
// wat ervan afhangt wordt opnieuw uitgerekend. De waarden staan dus gewoon
// in het notebook: opslaan en opnieuw openen geeft hetzelfde.
//%%
import "lib/plot.spp" as P
import "lib/list.spp" as L
import "lib/text.spp" as T

::Golf = { !amplitude : Float, !frequentie : Int, !gedempt : Bool }

golf = Golf 1.0 3 False
//%%
D.form golf
//%%
punten = 80
//%%
D.slider 10 200 punten
//%%
vorm = "sinus"
//%%
D.choice ["sinus", "blok", "zaagtand"] vorm
//%%
xs = [ itof i / itof punten | i <- L.range 0 punten ]

basis x = if (T.equal vorm "blok") (if (sin x >= 0.0) 1.0 (0.0 - 1.0))
  (if (T.equal vorm "zaagtand") (zaag x) (sin x))

zaag x = (x / 3.14159) - (2.0 * floor ((x + 3.14159) / 6.28318))

hoogte g x = amplitude g * basis (6.28318 * itof (frequentie g) * x) * (if (gedempt g) (exp (0.0 - (3.0 * x))) 1.0)
//%%
P.line xs (L.map (hoogte golf) xs)
//%%
golf
//%% [markdown]
// ## Een somtype: eerst de soort, dan de velden
//
// Bij een type met meer constructors (met getypeerde velden, of zonder
// velden zoals `Kleur`) toont `D.form` eerst een keuze van de constructor en
// daarna de velden daarvan. Een andere keuze schrijft een nieuwe waarde in
// de definitie; een veld dat in beide constructors staan (`kleur`) houdt
// zijn waarde. Een veld van een type als `Kleur` is een keuzelijst.
//%%
::Kleur = Rood | Groen | Blauw

::Figuur = Cirkel { !straal : Float, !kleur : Kleur }
         | Rechthoek { !breedte : Float, !lengte : Float, !kleur : Kleur }
         | Niets

figuur = Cirkel 0.5 Rood
//%%
D.form figuur
//%%
kleurNr k = case k (Rood -> 12) (Groen -> 10) (Blauw -> 9)

teken f = case f
  (Cirkel s k -> [G.GraphDisc (kleurNr k) (G.Pt (0.0 - s) (0.0 - s)) (G.Pt s s)])
  (Rechthoek b h k -> [G.GraphPolygon (kleurNr k) [G.Pt (0.0 - b / 2.0) (0.0 - h / 2.0), G.Pt (b / 2.0) (0.0 - h / 2.0), G.Pt (b / 2.0) (h / 2.0), G.Pt (0.0 - b / 2.0) (h / 2.0)]])
  (Niets -> [])
//%%
D.picture (Cons (G.GraphRectangle 7 (G.Pt (0.0 - 0.95) (0.0 - 0.95)) (G.Pt 0.95 0.95)) (teken figuur))
