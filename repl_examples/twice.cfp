::list = Nil | Cons !x xs

start = printlist (reptwice 400)

reptwice n = if (n==0) Nil (Cons (tinc (if ((n % 2) == 0) 1 2) 0) (reptwice (n-1)))

step d n = n + d

twice f x = let y = f x in f y

tinc d n = twice twice twice twice (step d) n

printlist xs = case xs (Nil -> 0) (Cons x xs -> print x <#> printlist xs)
