    ["Sapl+ naar Sapl (voorbewerker)", "Sapl", "24 aug"],
    ["de compiler gen1 (vertaalt zichzelf)", "Sapl", "10 aug; productie 25 sep"],
    ["de typechecker", "Sapl", "18 sep"],
    ["het notebook", "Sapl + een HTML-pagina", "26 sep"],
    ["de REPL", "Sapl", "7 okt"],
    ["linken van losse stukken code", "Sapl", "10 okt"],
    ["het binaire laadformaat .jvb", "Sapl (schrijven) en C (lezen)", "9 okt"],
    ["talen bouwen en laden (:lang)", "Sapl", "17 okt; :lang 20 okt"],
    ["waarden met code bewaren", "Sapl + VM-primitieven", "23 okt"] ]
//%% [markdown]
