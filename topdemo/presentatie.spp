    ["dispatch met musttail (wasm)", "warm 32-91% trager dan switch", "niet gedaan"],
    ["Scott-codering i.p.v. ADT's", "1,0-3,2× trager over de benchmarks", "niet gedaan"],
    ["JMVM naar losse wasm compileren", "1,4-3,5× in Chrome, ~1,4× in Safari", "niet ingebouwd"],
    ["REPL in Sapl i.p.v. repl-host", "25,7 naar 5,8 ms per regel", "de REPL"],
    ["ongebruikte instructies weg", "native ±0, Chrome fib +21%", "alleen een tag"],
    ["ABC-interpreter: globals naar locals", "34% minder tijd in Chrome", "voorstel aan TOP"],
    ["superinstructies uit een voorstel (zes)", "3,5% buiten sprimes; plafond ~10%", "zoeken naar werk, niet naar dispatch"],
    ["eval_local, gevonden door patronen te tellen", "primes −41%, sort −27%", "standaard, met de zes"],
    ["typewaarschuwingen: twee verse agents, aan en uit", "allebei 5 van 5 goed", "waarschuwingen, geen strenge modus"] ]
