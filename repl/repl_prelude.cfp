// repl_prelude.cfp -- de vaste prelude van sapl_compiler/tools/
// repl_retag.py en vm.cpp's REPL_HOST (zie repl/README.md
// en archive/docs/2026-09-13_repl_via_retag_linking_plan.md #6/showVal).
//
// BEWUST GEEN `#import "repl/stddyn.cfp"`: dat bestand doet zelf
// `#import "lib/stdlib.cfp"`, wat de VOLLEDIGE stdlib meebrengt --
// inclusief `take`/`filter`/`map`/`drop`/`reverse`/`foldl`/`foldr`, die
// `showVal`/`printVal` helemaal niet nodig hebben (geverifieerd: hun
// enige echte afhankelijkheden zijn `itoa`/`list2str`/`strcat`, en die
// op hun beurt alleen `append`/`length`/`fillStr`/`strls`/`::list`). Elke
// naam hier is voor `:load` een gereserveerde naam (§6 van het REPL-
// gebruiksdoc, "prelude-collision"-check) -- en 10 van de 12
// kernbenchmarks declareren zelf `::list`, en sommige (bv. `primes.cfp`)
// hun eigen `take`. Met de volledige stdlib als prelude zou `:load` op
// zulke, overigens heel normale, standalone `.cfp`-bestanden onnodig
// vaak mislukken (gemeld: `:load benchmarks/primes.jmvm` gaf uiteindelijk
// een botsing op `take`, een naam die `showVal` nooit gebruikt). Deze
// file bevat daarom alleen wat `showVal`/`printVal` ECHT nodig hebben,
// zelfstandig gekopieerd (niet ge-`#import`) uit `lib/stdlib.cfp` en
// `repl/stddyn.cfp` -- geen wijziging aan die twee bestanden, want beide
// hebben andere gebruikers (`repl/repl.cfp`, `reflection/serialize.cfp`,
// `reflection/generic.cfp`, ...) die de volledige stdlib wél nodig hebben.

::list = Nil | Cons !x xs

append xs ys =
  case xs
    (Nil -> ys)
    (Cons x xs -> Cons x (append xs ys))

length xs =
  case xs
    (Nil -> 0)
    (Cons x xs -> 1 + length xs)

strls !n !s = if (n < strlen s) (Cons (strat n s) (strls (n+1) s)) Nil

str2list !s = strls 0 s

strEqual !s1 !s2 = (eqnum (strlen s1) (strlen s2)) /\ strEqualAt 0 s1 s2

strEqualAt !n !s1 !s2 = if (n >= strlen s1) 1 (if (eqnum (strat n s1) (strat n s2)) (strEqualAt (n+1) s1 s2) 0)

fillStr !i !xs !arr =
  case xs
    (Nil -> arr)
    (Cons c cs -> fillStr (i+1) cs (update c i arr))

list2str !cs = fillStr 0 cs (strcreate (length cs))

strcat !s1 !s2 = list2str (append (str2list s1) (str2list s2))

itoa n =
  if (n < 0) (Cons '-' (itoa (0 - n)))
  (if (n < 10) (Cons ('0' + n) Nil)
  (append (itoa (n / 10)) (Cons ('0' + (n % 10)) Nil)))

// --- vanaf hier: repl/stddyn.cfp's eigen showVal/printVal, ongewijzigd ---

TYPE_INT    = 1
TYPE_FLOAT  = 2
TYPE_STRING = 3
TYPE_FUNC   = 4
// Char (tag 11 in de VM, sinds 5 oktober 2026): -1, want ADT-ids beginnen
// bij 5 en `typeId x > TYPE_FUNC` betekent overal "een ADT".
TYPE_CHAR   = 0 - 1

isInt    !x = eqnum (typeId x) TYPE_INT
isFloat  !x = eqnum (typeId x) TYPE_FLOAT
isString !x = eqnum (typeId x) TYPE_STRING
isFunc   !x = eqnum (typeId x) TYPE_FUNC
isChar   !x = eqnum (typeId x) TYPE_CHAR
isADT    !x = typeId x > TYPE_FUNC

applyDynamicByName !name !args = applyDynamic (lookup name) args

showVal x =
  let tid = typeId x in if (tid > TYPE_FUNC) (showConstr x) (showValAux tid x)

showValAux !tid !x =
  if (eqnum tid TYPE_INT) (list2str (itoa x))
  (if (eqnum tid TYPE_FLOAT) (ftoa x)
  (if (eqnum tid TYPE_STRING) x
  (if (eqnum tid TYPE_FUNC) (showFunc x)
  (if (eqnum tid TYPE_CHAR) (showChar x)
  (showConstr x)))))

// 'a', met de escapes die de lexers kennen (\n \t \\ \').
showChar !c = list2str (Cons 39 (append (showCharBody c) (Cons 39 Nil)))

showCharBody !c =
  if (eqnum c 10) (Cons 92 (Cons 'n' Nil))
  (if (eqnum c 9) (Cons 92 (Cons 't' Nil))
  (if (eqnum c 92) (Cons 92 (Cons 92 Nil))
  (if (eqnum c 39) (Cons 92 (Cons 39 Nil))
  (Cons c Nil))))

// Een functiewaarde (10-11 oktober 2026, docs/2026-10-10_reflectie_en_
// notebook_plan.md): de naam, de al gebonden argumenten, en het aantal
// argumenten dat nog ontbreekt: `<fn:plus/2>`, `<fn:plus 1/1>`. Een gebonden
// argument verschijnt alleen als het al uitgerekend is (fieldIsValue: het
// wordt er niet voor geforceerd) en eenvoudig (getal, teken, korte string,
// functie, constructor zonder velden); anders `·`. Een lambda is `λ`, een
// modulefunctie `list.map` (showValX maakt daar de alias van).
showFunc !x = pvShowFunc x (funcName x) (funcArity x) (funcRemaining x)

// Alle hulpfuncties hieronder hebben de functiewaarde als STRIKTE parameter
// (11 oktober 2026). `eval` is in deze VM "uitrekenen en toepassen": op een
// gedeeltelijke toepassing, met al andere waarden in het frame, neemt het die
// als argumenten en past toe. Een strikte parameter wordt aan het begin van de
// functie uitgerekend (een leeg frame), en daarna niet opnieuw. Zie
// docs/sapl_programmeer_regels.md §10 ("eval op een gedeeltelijke toepassing").
pvShowFunc !x name !ar !rem = strcat "<fn:" (strcat (pvFuncName name) (strcat (pvBoundArgs x (ar - rem) 0) (strcat "/" (strcat (list2str (itoa rem)) ">"))))

// Argument j (in bronvolgorde) is veld k-1-j: gen1 zet de gebonden
// argumenten van een gedeeltelijke toepassing omgekeerd neer.
pvBoundArgs !x !k !j = if (j >= k) "" (strcat " " (strcat (pvBoundArg x (k - 1 - j)) (pvBoundArgs x k (j + 1))))

pvBoundArg !x !i = if (eqnum (fieldIsValue x i) 1) (pvSimple (getField x i)) "·"

pvSimple !v = pvSimpleTid v (typeId v)

pvSimpleTid !v !tid =
  if (eqnum tid TYPE_INT) (showVal v)
  (if (eqnum tid TYPE_FLOAT) (showVal v)
  (if (eqnum tid TYPE_CHAR) (showVal v)
  (if (eqnum tid TYPE_STRING) (if (strlen v <= 20) (strcat "\"" (strcat v "\"")) "·")
  (if (eqnum tid TYPE_FUNC) (pvInlineFunc v)
  (if (tid > TYPE_FUNC) (pvSimpleCon v) "·")))))

// Een functie als argument: `plus` of `(plus 1)`, zonder `<fn:` en ariteit.
pvInlineFunc !v = pvInlineWrap (strcat (pvFuncName (funcName v)) (pvBoundArgs v (funcArity v - funcRemaining v) 0))
pvInlineWrap s = if (pvContains s " ") (strcat "(" (strcat s ")")) s

pvSimpleCon !v = if (eqnum (getConstrArity v) 0) (displayConName (constrName v)) "·"

pvFuncName name = if (pvIsLam name) "λ" (if (pvIsCon name) (strslice name 6 (strlen name)) (pvModuleDot name 1 (strlen name)))
// `__con_Rechthoek`: de functie die gen1 maakt voor een gedeeltelijk
// toegepaste constructor (sapl_compiler/parser.cfp, ctPartialProgram).
pvIsCon name = if (strlen name < 7) False (strEqual (strslice name 0 6) "__con_")

pvIsLam name = if (strlen name < 6) False (strEqual (strslice name 0 6) "__lam_")

pvModuleDot name !i !n =
  if (i + 2 >= n) name
  (if (pvDoubleUnder name i) (strcat (strslice name 0 i) (strcat "." (strslice name (i + 2) n))) (pvModuleDot name (i + 1) n))

pvDoubleUnder name !i = (eqnum (strat i name) '_') /\ (eqnum (strat (i + 1) name) '_')

// Een waarde tonen voor de REPL en het notebook, met `tbl` ("list L text T":
// per import het modulevoorvoegsel en de alias) en `ty` (het type, of ""):
// een functie als `<fn:L.map/2> :: <type>`; een Bool (ook in een lijst) op
// type; de rest zoals showVal. Modulenamen van functies, ook in een lijst,
// krijgen hun alias.
showValX tbl cur ty x =
  if (eqnum (typeId x) TYPE_FUNC) (strcat (pvAliasFn tbl (strcat (showFunc x) (pvOldMark cur (funcName x) (funcAddr x)))) (pvTyPart tbl ty))
  (pvAliasFn tbl (if (pvContains ty "Bool") (showTyped ty x) (showVal x)))

printValX tbl cur ty x = printString (showValX tbl cur ty x)

// `cur`: per naam "naam k s1 l1 ... sk lk" (alle versies uit het Img van de
// REPL, oudste eerst). Wijst een functiewaarde (funcAddr) naar versie i < k,
// dan "(versie i van k)"; naar geen van alle (bv. een versie die :undo
// weghaalde), dan "(oude versie)"; naar de laatste: niets.
pvOldMark cur name !addr = pvOldMarkW (pvWords cur) name addr
pvOldMarkW ws name !addr = case ws (Nil -> "") (Cons n r -> case r (Nil -> "") (Cons k r2 -> pvOldMarkAt n (pvNum k) r2 name addr))
pvOldMarkAt n !k ws name !addr =
  if (strEqual n name) (pvVersionMark (pvFindPair ws addr 0 k) k) (pvOldMarkW (pvDrop (2 * k) ws) name addr)
pvFindPair ws !addr !i !k =
  if (i >= k) (0 - 1)
  (case ws (Nil -> 0 - 1) (Cons s r -> case r (Nil -> 0 - 1) (Cons l r2 -> pvFindPairAt s l r2 addr i k)))
pvFindPairAt s l rest !addr !i !k = if (eqnum addr (pvNum s)) i (if (eqnum addr (pvNum l)) i (pvFindPair rest addr (i + 1) k))
pvVersionMark !i !k =
  if (i < 0) " (oude versie)"
  (if (eqnum (i + 1) k) "" (strcat " (versie " (strcat (list2str (itoa (i + 1))) (strcat " van " (strcat (list2str (itoa k)) ")")))))
pvDrop !k ws = if (k <= 0) ws (case ws (Nil -> Nil) (Cons w r -> pvDrop (k - 1) r))
pvNum s = pvNumAt s 0 (strlen s) 0
pvNumAt s !i !n !acc = if (i >= n) acc (pvNumAt s (i + 1) n (acc * 10 + (ord (strat i s) - 48)))

pvTyPart tbl ty = if (eqnum (strlen ty) 0) "" (strcat " :: " (pvAliasTy tbl ty))

// `<fn:list.` -> `<fn:L.` voor elk paar uit tbl; ook na `(` en een spatie
// (een functie als gebonden argument: `<fn:L.map (list.take 3)/1>`).
pvAliasFn tbl s = pvAliasFnW s (pvWords tbl)
pvAliasFnW s ws = case ws (Nil -> s) (Cons c r -> case r (Nil -> s) (Cons a r2 -> pvAliasFnW (pvAliasAfter "(" c a (pvAliasAfter " " c a (pvAliasAfter "<fn:" c a s))) r2))
pvAliasAfter pre c a s = pvReplaceAll s (strcat pre (strcat c ".")) (strcat pre (strcat a "."))

// In een type: `list__X` en `List__X` -> `L.X`.
pvAliasTy tbl s = pvAliasTyW s (pvWords tbl)
pvAliasTyW s ws = case ws (Nil -> s) (Cons c r -> case r (Nil -> s) (Cons a r2 -> pvAliasTyW (pvReplaceAll (pvReplaceAll s (strcat c "__") (strcat a ".")) (strcat (pvCapFirst c) "__") (strcat a ".")) r2))

pvCapFirst s = if (eqnum (strlen s) 0) s (strcat (list2str (Cons (pvUpper (strat 0 s)) Nil)) (strslice s 1 (strlen s)))
pvUpper !c = if ((c >= 'a') /\ (c <= 'z')) (c - 32) c

// De woorden van een string (gescheiden door spaties).
pvWords s = pvWordsFrom s 0 0 (strlen s)
pvWordsFrom s !start !i !n =
  if (i >= n) (pvWordEnd s start n Nil)
  (if (eqnum (strat i s) ' ') (pvWordEnd s start i (pvWordsFrom s (i + 1) (i + 1) n)) (pvWordsFrom s start (i + 1) n))
pvWordEnd s !start !i rest = if (i > start) (Cons (strslice s start i) rest) rest

pvContains s sub = pvFind s sub 0 (strlen s) (strlen sub) >= 0

// De eerste plaats van `sub` in `s` vanaf i, of -1.
pvFind s sub !i !n !m = if (i + m > n) (0 - 1) (if (pvMatchAt s sub i 0 m) i (pvFind s sub (i + 1) n m))
pvMatchAt s sub !i !k !m = if (k >= m) True (if (eqnum (strat (i + k) s) (strat k sub)) (pvMatchAt s sub i (k + 1) m) False)

pvReplaceAll s from to = if (eqnum (strlen from) 0) s (pvReplFrom s from to 0 (strlen s) (strlen from))
pvReplFrom s from to !i !n !m = pvReplAt s from to i n m (pvFind s from i n m)
pvReplAt s from to !i !n !m !j = if (j < 0) (strslice s i n) (strcat (strslice s i j) (strcat to (pvReplFrom s from to (j + m) n m)))

// ::list (Cons/Nil) krijgt een STATISCHE aanroep naar show_Cons/show_Nil,
// bewust niet via de lookup+applyDynamic-haak hieronder: een module-gelinkte
// REPL (sapl_compiler/retaglink.cfp, gebruikt door zowel de websapl-REPL als
// sapl_compiler/tools/repl_retag.py) snoeit elke functie die vanaf `start`
// niet STATISCH bereikbaar is (sapl_compiler/reachability.cfp's calledNamesE
// ziet alleen App/Ct-aanroepen, geen strcat-opgebouwde naam die pas via
// `lookup` ten uitvoer komt) -- show_Cons/show_Nil zouden anders in precies
// die context stilzwijgend gesnoeid worden en de lijst-default zou daar
// onopgemerkt terugvallen op de generieke weergave. Zie
// docs/2026-09-15_show_specialisatie_hook.md voor de volledige analyse.
//
// Specialisatiehaak voor ELKE ANDERE constructor: een zelfgedefinieerde
// `show_<ConstrName> !x = ...` (exact 1 parameter, retourneert een gepakte
// string) overschrijft de generieke "Naam(veld1, ...)"-weergave -- maar
// ALLEEN via een plat `./compile`/`./compile-sapl`; in een module-gelinkte
// REPL geldt dezelfde pruning-beperking als hierboven, dus daar wordt zo'n
// haak stilzwijgend genegeerd (bekende, niet (nog) opgeloste beperking).
showConstr !x =
  let name = constrName x in
  if (strEqual name "Cons") (show_Cons x)
  (if (strEqual name "Nil") (show_Nil x) (showConstrDynamic x name))

showConstrDynamic !x !name =
  let h = lookup (strcat "show_" name) in
  if (eqnum (typeId h) TYPE_FUNC) (applyDynamic h (Cons x Nil)) (showConstrGeneric x name)

// Tupels en moduleconstructors zoals repl/stddyn.cfp (en de notebook) ze
// tonen: `(1, 2)` i.p.v. `__Tuple2(1, 2)`, `Wel(3)` i.p.v. `Lijst__Wel(3)`.
// Tot 27 september 2026 kende de REPL-prelude dat niet.
showConstrGeneric !x !name =
  let arity = getConstrArity x,
      shown = displayConName name in
  if (isTupleName name) (strcat "(" (strcat (showFields x 0 arity) ")"))
  (if (eqnum arity 0) shown (strcat shown (strcat "(" (strcat (showFields x 0 arity) ")"))))

isTupleName !name = if (strlen name > 7) (strEqualAt 0 "__Tuple" name) False

// `Module__Naam` -> `Naam` (alleen de weergave; de show_-haak en de
// ariteit zoeken met de volle naam). Zelfde regel als repl/stddyn.cfp.
displayConName !name =
  let n = strlen name in
  if (n > 0) (displayConNameFrom name n (isUpperCode (strat 0 name))) name

displayConNameFrom !name !n !upper = if upper (displayConNameScan name n 1) name

displayConNameScan !name !n !i =
  if (i + 2 >= n) name
  (if (isModuleSep name i) (strslice name (i + 2) n) (displayConNameScan name n (i + 1)))

isModuleSep !name !i = (eqnum (strat i name) '_') /\ (eqnum (strat (i + 1) name) '_') /\ isUpperCode (strat (i + 2) name)

isUpperCode !c = (c >= 'A') /\ (c <= 'Z')

// Lijst-default: een ::list-waarde (Cons/Nil, hierboven) toont
// showVal/printVal als "[1, 2, 3]" i.p.v. de generieke
// "Cons(1, Cons(2, ...))" -- statisch aangeroepen vanuit showConstr
// hierboven, dus dit werkt overal, ook in een module-gelinkte REPL.
show_Nil !xs = "[]"

show_Cons !xs = strcat "[" (strcat (showListItems xs) "]")

showListItems !xs =
  case xs
    (Cons x rest -> case rest (Nil -> showVal x) (_ -> strcat (showVal x) (strcat ", " (showListItems rest))))
    (_ -> "")

showFields !x !i !n =
  if (eqnum i n)
    ""
    (if (eqnum i (n - 1))
       (showFieldAt x i)
       (strcat (showFieldAt x i) (strcat ", " (showFields x (i + 1) n))))

// Een veld tonen in een eigen functie (11 oktober 2026): `getField` wordt
// gevolgd door `eval`, en met al een argument van strcat in het frame paste
// dat een gedeeltelijke toepassing in het veld toe (`Twee (plus 1) 5` gaf een
// runtime-fout). Hier staat de getField + eval in staartpositie.
showFieldAt !x !i = showVal (getField x i)

getConstrArity !x =
  let c = lookup (constrName x) in if (eqnum (typeId c) TYPE_FUNC) (funcArity c) 0

printVal !x = printString (showVal x)

// == Weergave op type (5 oktober 2026, notebookplan fase 3) ==================
// Bools hebben geen eigen runtime-tag (beslissing 3 van het notebookplan):
// een bool is in de VM gewoon 1/0. De REPL en het notebook typeren daarom de
// expressie eerst (preprocess/typecheck.jmvm); bevat het type `Bool`, dan
// tonen ze het resultaat met `printValT "<type>" x`: `Bool` -> True/False,
// `[T]` -> een lijst met elk element op type T, al het andere via showVal.
showTyped !ty x =
  if (strEqual ty "Bool") (showBoolVal x)
  (if (isListTy ty) (strcat "[" (strcat (showTypedItems (listElemTy ty) x) "]")) (showVal x))

showBoolVal !b = if (eqnum b 0) "False" "True"

isListTy !ty = if (strlen ty < 2) 0 (isListTy2 ty)

isListTy2 !ty = (eqnum (strat 0 ty) '[') /\ (eqnum (strat (strlen ty - 1) ty) ']')

listElemTy !ty = strslice ty 1 (strlen ty - 1)

showTypedItems !et !xs =
  case xs
    (Nil -> "")
    (Cons y ys -> showTypedItemsC et y ys)

showTypedItemsC !et y !ys =
  case ys
    (Nil -> showTyped et y)
    (Cons z zs -> strcat (showTyped et y) (strcat ", " (showTypedItems et ys)))

printValT !ty x = printString (showTyped ty x)
