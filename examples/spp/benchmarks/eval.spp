// A tiny De-Bruijn-indexed expression evaluator. The original hand-rolled
// two duplicate list types (`::Stack`, `::flist`) alongside a real list --
// unified here to plain `::list`/`Cons`/`Nil` (so `:`-cons-sugar and one
// shared `el`/`length`/`drop` apply to both the environment stack and the
// function table). **`Cons`'s head field is deliberately NOT strict**
// (unlike this repo's other `.spp` rewrites, which all use `Cons !x xs`):
// the environment stack (`es`) holds not-yet-evaluated, sometimes
// genuinely infinite subexpressions (the interpreted `primes`/`sieve`
// stream) pushed via `Cons (evol r Nil fs) es` in `evol`'s `App` case --
// a strict head field would force that argument to WHNF immediately on
// push instead of lazily on first use, turning call-by-need into
// call-by-value and infinite-looping while trying to fully evaluate an
// infinite stream eagerly. Found by first trying the same `!x` convention
// as every other rewrite in this repo, hitting a stack overflow running
// `smain 100`, and bisecting back to the original's hand-written `case`
// form (which does NOT stack-overflow) to confirm the regression was
// real and then narrowing it down to this one flipped strictness bit --
// not a preprocessor bug, a genuine semantic difference between the
// original's `::Stack = SNil | SCons x xs` (no strictness) and this
// repo's usual list-strictness convention. `::Tup` becomes a real tuple
// `(arity, body)`, so the function-table lookup is a single
// `let (arity, body) = el f fs in ...` instead of two separate
// `fst`/`snd (elf f fs)` calls. Every `case` dispatch over `::Expr`
// (`subst`, `evol`) becomes a flat set of pattern-definition clauses, one
// per constructor. `apply`/`apprel`/`getNum` were the original's most
// awkward code -- an 8-branch `case` padded with 6-7 bare `nomatch`
// placeholders (one per `::Expr` constructor the function does NOT care
// about) to reach the one or two constructors it does -- each collapses
// to exactly the clauses that matter; every other constructor combination
// is still an implicit NoMatch, same as the original's explicit ones. The
// 27-entry function table (`funcs`) is a `[a, b, c, ...]` list literal
// instead of 27 nested `FCons`s.
::list = Nil | Cons x xs
::Expr = App a b | Func !a | Var !a | Num !a | Oper a | Relop a | Boolean !b | Error

add a b = a + b
mult a b = a * b
sub a b = a - b
mod a b = a % b
eq a b = a == b

el 0 (x:xs) = x
el n (x:xs) = el (n - 1) xs
el n Nil = 111

length Nil = 0
length (x:xs) = 1 + length xs

drop 0 xs = xs
drop n Nil = Nil
drop n (x:xs) = drop (n - 1) xs

subst (App l r) es = App (subst l es) (subst r es)
subst (Func n) es = Func n
subst (Var n) es = el n es
subst (Num n) es = Num n
subst (Oper o) es = Oper o
subst (Relop o) es = Relop o
subst (Boolean l) es = Boolean l
subst Error es = Error

evol (App f r) es fs = evol f (Cons (evol r Nil fs) es) fs
evol (Func f) es fs =
  let (arity, body) = el f fs in
  if (length es >= arity) (evol (subst body es) (drop arity es) fs) (rebuild (Func f) es)
evol (Var n) es fs = el n es
evol (Num n) es fs = Num n
evol (Oper f) es fs = apply f (el 0 es) (el 1 es)
evol (Relop f) es fs = evol (apprel f (el 0 es) (el 1 es)) (drop 2 es) fs
evol (Boolean b) es fs
  | length es >= 2 = evol (dobool b (el 0 es) (el 1 es)) (drop 2 es) fs
  | otherwise = Boolean b
// no `Error` clause: same as the original's trailing bare `nomatch` --
// `nomatch` itself may only stand as a case-branch marker, never as an
// ordinary expression/function body (docs/sapl_programmeer_regels.md
// #2/#12), so the equivalent here is to simply not name this constructor
// -- Sapl's own auto-NoMatch crashes on an unhandled constructor exactly
// the same way.

rebuild e Nil = e
rebuild e (x:xs) = rebuild (App e x) xs

apply op (Num n) (Num m) = Num (op n m)
apprel op (Num n) (Num m) = Boolean (op n m)
dobool b f s = if b f s

getNum (Num n) = n
getNum (Boolean b) = b

funcs =
  [ fneq, ftypeof, fnrargs, fnrapps, fstacksize, fError, fsuc, ffac, fEmpty, fCons, ffrom,
    ftake, fdrp, ffilter, fel, fcount, fmember, fnotmodzero, fprimes, fsieve, ftake0, fdrp0,
    ffilter0, fel0, fcount0, fmember0, fsieve0 ]

fneq = (2, Error)
ftypeof = (1, Error)
fnrargs = (1, Error)
fnrapps = (1, Error)
fstacksize = (1, Error)
fError = (1, (Var 0))
fsuc = (1, (App (App (Oper add) (Var 0)) (Num 1)))
ffac = (1, (App (App (App (App (Relop eq) (Var 0)) (Num 0)) (Num 1)) (App (App (Oper mult) (Var 0)) (App (Func 7) (App (App (Oper sub) (Var 0)) (Num 1))))))
fEmpty = (2, (Var 0))
fCons = (4, (App (App (Var 3) (Var 0)) (Var 1)))
ffrom = (1, (App (App (Func 9) (Var 0)) (App (Func 10) (App (Func 6) (Var 0)))))
ftake = (2, (App (App (Var 1) (Func 8)) (App (Func 20) (Var 0))))
fdrp = (2, (App (App (Var 1) (Func 8)) (App (Func 21) (Var 0))))
ffilter = (2, (App (App (Var 1) (Func 8)) (App (Func 22) (Var 0))))
fel = (2, (App (App (Var 1) (Func 5)) (App (Func 23) (Var 0))))
fcount = (1, (App (App (Var 0) (Num 0)) (Func 24)))
fmember = (2, (App (App (Var 0) (Boolean False)) (App (Func 25) (Var 1))))
fnotmodzero = (2, (App (App (App (App (Relop eq) (App (App (Oper mod) (Var 1)) (Var 0))) (Num 0)) (Boolean False)) (Boolean True)))
fprimes = (0, (App (Func 19) (App (Func 10) (Num 2))))
fsieve = (1, (App (App (Var 0) (Func 5)) (Func 26)))

ftake0 = (3, (App (App (App (App (Relop eq) (Var 0)) (Num 0)) (Func 8)) (App (App (Func 9) (Var 1)) (App (App (Func 11) (App (App (Oper sub) (Var 0)) (Num 1))) (Var 2)))))
fdrp0 = (3, (App (App (App (App (Relop eq) (Var 0)) (Num 0)) (App (App (Func 9) (Var 1)) (Var 2))) (App (App (Func 12) (App (App (Oper sub) (Var 0)) (Num 1))) (Var 2))))
ffilter0 = (3, (App (App (App (Var 0) (Var 1)) (App (App (Func 9) (Var 1)) (App (App (Func 13) (Var 0)) (Var 2)))) (App (App (Func 13) (Var 0)) (Var 2))))
fel0 = (3, (App (App (App (App (Relop eq) (Var 0)) (Num 0)) (Var 1)) (App (App (Func 14) (App (App (Oper sub) (Var 0)) (Num 1))) (Var 2))))
fcount0 = (2, (App (Func 6) (App (Func 15) (Var 1))))
fmember0 = (3, (App (App (App (App (Relop eq) (Var 1)) (Var 0)) (Boolean True)) (App (App (Func 16) (Var 2)) (Var 0))))
fsieve0 = (2, (App (App (Func 9) (Var 0)) (App (Func 19) (App (App (Func 13) (App (Func 17) (Var 0))) (Var 1)))))

smain a = evol (App (App (Func 14) (Num a)) (Func 18)) Nil funcs

start = getNum (smain 100)
