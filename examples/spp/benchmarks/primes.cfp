::list = Nil | Cons !x0 x1
from __pat_0 = Cons __pat_0 (from (__pat_0 + 1))
sieve __pat_1 = case __pat_1 (Cons __pat_2 __pat_3 -> Cons __pat_2 (sieve (__zf_1 __pat_2 Nil __pat_3)))
