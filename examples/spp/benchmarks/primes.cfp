__zf_1 __pat_19 __pat_20 __pat_21 = case __pat_21 (Nil -> __pat_20) (Cons x __zf_tail -> if ((x % __pat_19) != 0) (Cons x (__zf_1 __pat_19 __pat_20 __zf_tail)) (__zf_1 __pat_19 __pat_20 __zf_tail))
