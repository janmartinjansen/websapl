#import "parser_combinators/parsecomb.spp"
#import "sapl_compiler/newparser_ast.cfp"
#import "sapl_compiler/lexer2.cfp"
#import "sapl_compiler/ast_helpers.cfp"

// saplParse.spp -- the closing milestone for this whole preprocessor/
// parser-combinator exercise (PLAN.md section 17, 2026-08-29): a
// parser-combinator-based parser, built on parsecomb.spp, that reproduces
// sapl_compiler/'s OWN "parse stage" -- the exact `expr`/`func`/`adt`
// (newparser_ast.cfp) values `sapl_compiler/parser.cfp`'s hand-written
// recursive-descent parser produces, i.e. what `./compile-sapl <file>
// --emit=parse` dumps via stage_dump.cfp's `dumpProgram`. Not a new
// grammar design: this is a direct structural port of parser.cfp's own
// algorithm (tokenize with lexer2.cfp, parse+postParse per clause, then a
// whole-program resolve pass), with the actual TOKEN-CONSUMING parsing
// rewritten against parsecomb.spp's combinators wherever that's a natural
// fit (juxtaposed application via `pMany`, the 5-level operator-precedence
// chain via layered `pChainl1`, case branches/ADT constructors via `pMany`/
// `pSepBy1`/`?`) and left as direct token-dispatch functions wherever a
// combinator translation would need a nested tuple pattern (case-branch
// field lists, `if`/`try`/`throw` argument arity checks) --
// docs/sapl_programmeer_regels.md #2 forbids nested list/tuple patterns
// one level deep, so those parts mirror parser.cfp's own literal
// chain-of-helper-functions style instead (`ifArgs3`/`ifArgs3a`/...).
//
// Why this doesn't repeat pcomb.cfp's exponential blowup: sapl_compiler/
// itself already tried this once -- pcomb.cfp (list-of-all-successes
// combinators, ambiguous choice via `append`) blew up exponentially on
// nested parens and was abandoned in favor of lexer2.cfp/parser.cfp's
// hand-written, single-token-dispatch design (docs/bootstrapping_plan.md,
// 9 aug 2026; lexer2.cfp's own header repeats the same story). This file
// is safe from that failure mode for a structural reason, not a
// performance trick: parsecomb.spp's `PRes` is `POk val rest | PErr msg
// rest` -- ONE result or a failure, never a list of all possible parses.
// `?` (committed choice) tries the first alternative and returns
// immediately on success; it never explores the second branch once the
// first succeeds, and never accumulates alternative parses the way
// `pcomb.cfp`'s `append`-based `choice` did. There is nothing here for an
// ambiguous grammar to multiply -- the same reason ordinary recursive-
// descent code doesn't blow up either.
//
// == What's ground-truth-testable, and how ==
// `dumpProgram fs adts` (sapl_compiler/stage_dump.cfp) renders EITHER
// parser.cfp's own parse or this file's parse in the exact same paper
// notation -- so `saplParse_test.spp` runs this parser over a handful of
// sapl_compiler/test_parser_*.cfp files and real benchmarks/*.cfp sources,
// dumps the result, and the intended check is a byte-for-byte diff against
// `./compile-sapl <file> --emit=parse`'s own output for the same source --
// the actual proof of parity, not just "looks plausible" (same discipline
// this whole session's testing has followed throughout, see e.g.
// codegenAma_test.spp's own header).
//
// == Known, deliberate divergences from parser.cfp (documented, not bugs) ==
// - Trailing tokens after a function body / let body / ADT declaration are
//   silently ignored rather than erroring, matching parser.cfp's own
//   permissiveness there (buildBody/checkLetTrailing don't enforce full
//   consumption of the whole line either -- this is not a case this port
//   is being stricter or looser about, just carried through unchanged).
// - A malformed `!` not followed by a name (`Cons ! | Nil`) makes the
//   surrounding `pMany` simply stop collecting fields/args at that point,
//   instead of parser.cfp's explicit `error "! must be followed by a
//   name"`. Only reachable on genuinely malformed source, never on the
//   well-formed test/benchmark files this port is actually validated
//   against -- accepted here to keep pField/pFuncArg a plain combinator
//   composition instead of parser.cfp's own hand-rolled bang-lookahead.
// - The `fixupCtor`/`completeBranches`/`resolveVar` whole-program pass IS
//   ported (see the bottom of this file) -- it's the reason a bare
//   0-arity top-level reference becomes `App n []` and every `case`/
//   `select` gets its missing branches filled with `NoMatch` or a written
//   catch-all, exactly like `--emit=parse`'s own output.

// == Keywords (parser.cfp's own opAtom/keyword table, unchanged) ============

ifKw      = ['if']
caseKw    = ['case']
selectKw  = ['select']
letKw     = ['let']
inKw      = ['in']
nomatchKw = ['nomatch']
trueKw    = ['True']
falseKw   = ['False']
tryKw     = ['try']
throwKw   = ['throw']
str2listOp = ['str2list']
pipeOp    = ['|']

isLetOrInIdent n = charListEq n letKw \/ charListEq n inKw
isCaseIdent n = charListEq n caseKw \/ charListEq n selectKw
isBoolLit n = charListEq n trueKw \/ charListEq n falseKw
boolLitValue n = if (charListEq n trueKw) (Num 1) (Num 0)
isUpperStart n = case n (Nil -> False) (Cons c cs -> if (c == '_') (isUpperStart cs) ((c >= 'A') /\ (c <= 'Z')))

// Same reasoning as parser.cfp's own identExpr: `readLine` is the one
// syscall with no arguments, so a bare mention of it must desugar straight
// to a saturated zero-arg `App` at parse time (every later isSyscallCall
// check only fires on an `App n as` node).
identExpr n = if (isSyscallCall n /\ (syscallArity n == 0)) (App n Nil) (Var n)

// == Token-level combinators ==================================================
// `pSat`/`pItem` (parsecomb.spp) work over ANY Cons-list, not just
// characters -- so they apply directly to lexer2.cfp's `[token]` list,
// exactly like they apply to a `[char]` list elsewhere in this library.

isTIdentTok t = case t (TIdent n -> True) (_ -> False)
tIdentName t = case t (TIdent n -> n) (_ -> error "tIdentName: not a TIdent")
pIdentTok = pSat isTIdentTok pItem --> tIdentName

isTNumTok t = case t (TNum n -> True) (_ -> False)
tNumVal t = case t (TNum n -> Num n) (_ -> error "tNumVal: not a TNum")
pNumAtom = pSat isTNumTok pItem --> tNumVal

isTFloatTok t = case t (TFloatStr s -> True) (_ -> False)
tFloatVal t = case t (TFloatStr s -> FloatLit s) (_ -> error "tFloatVal: not a TFloatStr")
pFloatAtom = pSat isTFloatTok pItem --> tFloatVal

isTStrTok t = case t (TStr s -> True) (_ -> False)
tStrVal t = case t (TStr s -> Str s) (_ -> error "tStrVal: not a TStr")
pStrAtom = pSat isTStrTok pItem --> tStrVal

// `['abc']` sugar desugars to `App str2list [Str "abc"]`, same as
// parser.cfp's own parseAtomTok TStrList case.
isTStrListTok t = case t (TStrList s -> True) (_ -> False)
tStrListVal t = case t (TStrList s -> App str2listOp (Cons (Str s) Nil)) (_ -> error "tStrListVal: not a TStrList")
pStrListAtom = pSat isTStrListTok pItem --> tStrListVal

isTLParenTok t = case t (TLParen -> True) (_ -> False)
pLParenTok = pSat isTLParenTok pItem
isTRParenTok t = case t (TRParen -> True) (_ -> False)
pRParenTok = pSat isTRParenTok pItem
isTBangTok t = case t (TBang -> True) (_ -> False)
pBangTok = pSat isTBangTok pItem
isTCommaTok t = case t (TComma -> True) (_ -> False)
pCommaTok = pSat isTCommaTok pItem

isTOpEq sym t = case t (TOp o -> charListEq o sym) (_ -> False)
pOpEqTok sym = pSat (isTOpEq sym) pItem
pPipeTok = pOpEqTok pipeOp

// `!field`/`field` -- an optional leading TBang, folded to a strictness
// Bool. Used by both ADT field lists and function argument lists.
constTrue t = True
pStrictMark = (pBangTok --> constTrue) ? (pReturn False)

// == Atoms: number, float, string, `['...']`, identifier (incl. case/
// select routing), or `( expr )` ============================================
// Mutually recursive with pApp/the precedence chain/pCaseExpr below --
// ordinary top-level Sapl functions can reference each other regardless of
// textual order, same as parser.cfp's own parseAtom/parseExpr/
// parseCaseExpr mutual recursion.

// A bare identifier is EITHER routed into a full `case`/`select` parse
// (consuming far more than one token) OR becomes a plain `Var`/0-arg `App`
// -- not expressible as `pChoice` over independent atom combinators, since
// which branch runs depends on the token's own text, not just its shape.
// Same reason parser.cfp's own parseAtomTok is a direct dispatch, not
// composed from smaller pieces.
pIdentAtom toks =
  case toks
    (Nil -> PErr "pIdentAtom: unexpected end of input" Nil)
    (Cons t rest -> pIdentAtomTok t rest)

pIdentAtomTok t rest =
  case t
    (TIdent n -> pIdentAtomName n rest)
    (_ -> PErr "pIdentAtom: not an identifier" (Cons t rest))

pIdentAtomName n rest =
  if (isCaseIdent n) (pCaseExpr rest)
  (if (isLetOrInIdent n) (PErr "pIdentAtom: let/in not allowed here" (Cons (TIdent n) rest)) (POk (identExpr n) rest))

pParenAtom = (pLParenTok ++> pExpr) <++ pRParenTok

pAtom = pNumAtom ? pFloatAtom ? pStrAtom ? pStrListAtom ? pIdentAtom ? pParenAtom

// == Application: juxtaposed atoms, left-associative, tightest binding ======
// `pMany pAtom` naturally stops exactly where parser.cfp's own
// collectAppOnTok does -- pAtom itself fails (PErr, no input consumed) on
// every token that isn't the start of a new atom (an operator, `)`, `->`,
// `,`, `=`, or a bare `let`/`in`), so pMany's own "stop on first failure,
// keep the original position" rule reproduces the same termination
// condition without needing that manual lookahead case-by-case.

appendArgRaw head arg =
  case head
    (Var n -> App n (Cons arg Nil))
    (App n as -> App n (append as (Cons arg Nil)))
    (_ -> error "appendArgRaw: unexpected argument in this position")

foldAppArgs head args =
  case args
    (Nil -> head)
    (Cons a rest -> foldAppArgs (appendArgRaw head a) rest)

foldApp (head, args) = foldAppArgs head args

pApp = (pAtom +++ pMany pAtom) --> foldApp

// == Infix operators: layered `pChainl1`, tightest to loosest ===============
// Mirrors parser.cfp's own `opTable`/precedence-climbing exactly (same 5
// distinct priority levels, same operators per level, same left-
// associativity) -- a strict priority hierarchy of `pChainl1` layers is the
// direct combinator equivalent of that climbing algorithm.

mkPrim2 opname l r = Prim opname (Cons l (Cons r Nil))

isTOpAny syms t = case t (TOp o -> member syms o) (_ -> False)
tOpName t = case t (TOp o -> o) (_ -> error "tOpName: not a TOp")
pOpAny syms = (pSat (isTOpAny syms) pItem) --> tOpName
pOpCombiner syms = pOpAny syms --> mkPrim2

mulSyms  = Cons ['*'] (Cons ['%'] (Cons ['/'] Nil))
addSyms  = Cons ['+'] (Cons ['-'] (Cons ['<#>'] Nil))
cmpSyms  = Cons ['<'] (Cons ['<='] (Cons ['>'] (Cons ['>='] Nil)))
eqSyms   = Cons ['=='] (Cons ['!='] Nil)
boolSyms = Cons slashBackslash (Cons backslashSlash Nil)

pLevel20 = pChainl1 pApp (pOpCombiner mulSyms)
pLevel10 = pChainl1 pLevel20 (pOpCombiner addSyms)
pLevel4  = pChainl1 pLevel10 (pOpCombiner cmpSyms)
pLevel3  = pChainl1 pLevel4 (pOpCombiner eqSyms)
pLevel1  = pChainl1 pLevel3 (pOpCombiner boolSyms)

pExpr = pLevel1

// == case scrut (Con v1 v2 -> body) ... ======================================
// `caseKw`/`selectKw` itself is already consumed by pIdentAtomName before
// this runs. Scrutinee is a single ATOM (matching real usage: `case lst
// (...)`), not a full expression -- same restriction parser.cfp's own
// parseCaseExpr has, since a binary-operator expression would swallow the
// following `(` as an operand instead of leaving it for the first branch.

pCaseExpr toks =
  case (pAtom toks)
    (POk scrut rest -> pCaseExprBranches scrut rest)
    (PErr m r -> PErr m r)

pCaseExprBranches scrut toks =
  case (pMany pBranchItem toks)
    (POk items rest -> POk (Case scrut (concatAll items)) rest)
    (PErr m r -> error "pCaseExprBranches: unreachable, pMany never fails")

singletonList x = Cons x Nil
constNil t = Nil

isNomatchTok t = case t (TIdent n -> charListEq n nomatchKw) (_ -> False)
pNomatchSkip = pSat isNomatchTok pItem

// Each item contributes 0 branches (a bare `nomatch`, just documentation --
// completeBranches below fills every uncovered constructor regardless) or
// exactly 1 (a real `(Con v* -> body)`).
pBranchItem = (pNomatchSkip --> constNil) ? (pOneBranch --> singletonList)

pOneBranch = (pLParenTok ++> pBranchInner) <++ pRParenTok

// A branch's field-name list is variable-length with no natural
// combinator terminator shape (it stops at `TArrow`, not at any token an
// independent "field" combinator could just fail on the way pAtom does for
// pMany pAtom) -- direct dispatch, same as parser.cfp's own
// parseBranchFields/parseBranchFieldsTok.
pBranchInner toks =
  case (pIdentTok toks)
    (POk con rest -> pBranchInnerFields con Nil rest)
    (PErr m r -> PErr m r)

pBranchInnerFields con acc toks =
  case toks
    (Nil -> PErr "pBranchInner: missing -> in case branch" Nil)
    (Cons t rest -> pBranchInnerFieldsTok con acc t rest)

pBranchInnerFieldsTok con acc t rest =
  case t
    (TIdent v -> pBranchInnerFields con (append acc (Cons v Nil)) rest)
    (TArrow -> pBranchInnerBody con acc rest)
    (_ -> PErr "pBranchInner: expected a field name or -> in the pattern" (Cons t rest))

pBranchInnerBody con fields toks =
  case (pExpr toks)
    (POk body rest -> POk (CaseBranch con fields (postParseExpr body)) rest)
    (PErr m r -> PErr m r)

// == let b1 = e1, !b2 = e2, ... in body =======================================
// Only reachable as a whole function body (pFuncBody below), never as a
// nested atom -- same restriction as parser.cfp's own postParse (whose Let
// branch is deliberately unreachable, docs/sapl_programmeer_regels.md #4).
// `pSepBy1` handles the comma-separated list itself; the mandatory
// trailing `in` isn't expressible through `pSepBy1` alone (it has no
// "then require X" combinator), so that part is direct dispatch.

pLetBindingOne toks =
  case (pStrictMark toks)
    (POk strict rest -> pLetBindingOneName strict rest)
    (PErr m r -> error "pLetBindingOne: unreachable, pStrictMark never fails")

pLetBindingOneName strict toks =
  case (pIdentTok toks)
    (POk name rest -> pLetBindingOneEq strict name rest)
    (PErr m r -> PErr m r)

pLetBindingOneEq strict name toks =
  case toks
    (Nil -> PErr "pLetBindingOne: missing = in let binding" Nil)
    (Cons t rest -> pLetBindingOneEqTok strict name t rest)

pLetBindingOneEqTok strict name t rest =
  case t
    (TEquals ->
       case (pExpr rest)
         (POk e rest2 -> POk (LetBinding name strict (postParseExpr e)) rest2)
         (PErr m r -> PErr m r))
    (_ -> PErr "pLetBindingOne: = expected after the name in a let binding" (Cons t rest))

pLetClauseBody toks =
  case (pSepBy1 pLetBindingOne pCommaTok toks)
    (POk bindings rest -> pLetClauseAfterBindings bindings rest)
    (PErr m r -> error (strcat "parseLet: " m))

pLetClauseAfterBindings bindings toks =
  case toks
    (Nil -> error "parseLet: missing 'in' after the let bindings")
    (Cons t rest -> pLetClauseAfterBindingsTok bindings t rest)

pLetClauseAfterBindingsTok bindings t rest =
  case t
    (TIdent n -> if (charListEq n inKw) (pLetClauseAfterIn bindings rest) (error "parseLet: , or in expected after a let binding"))
    (_ -> error "parseLet: , or in expected after a let binding")

pLetClauseAfterIn bindings toks =
  case (pExpr toks)
    (POk body remTail -> Let bindings (postParseExpr body))
    (PErr m r -> error (strcat "parseLet: " m))

startsWithLetToks toks =
  case toks
    (Nil -> False)
    (Cons t rest -> case t (TIdent n -> charListEq n letKw) (_ -> False))

pFuncBody toks =
  if (startsWithLetToks toks)
    (pLetClauseBody (tailOr Nil toks))
    (pPlainFuncBody toks)

pPlainFuncBody toks =
  case (pExpr toks)
    (POk e rest -> postParseExpr e)
    (PErr m r -> error (strcat "buildFunc: " m))

// == Post-processing: rewrite raw App/Var into If/Try/Throw/Ct/bool-literal,
// bottom-up over the WHOLE expression tree. Direct port of parser.cfp's own
// postParse/finishApp (lines ~296-365) -- not a parsing concern (no tokens
// consumed here), so no combinator translation applies; the chain-of-
// helper-functions style for ifArgs3/tryArgs2/throwArgs2 matches
// parser.cfp exactly (a `case as (Cons a1 (Cons a2 (Cons a3 Nil)) -> ...)`
// nested pattern is not allowed, docs/sapl_programmeer_regels.md #2). =====

ifArgs3 as = case as (Cons a1 rest1 -> ifArgs3a a1 rest1) (Nil -> error "ifArgs3: expected 3 args")
ifArgs3a a1 rest1 = case rest1 (Cons a2 rest2 -> ifArgs3b a1 a2 rest2) (Nil -> error "ifArgs3: expected 3 args")
ifArgs3b a1 a2 rest2 = case rest2 (Cons a3 rest3 -> ifArgs3c a1 a2 a3 rest3) (Nil -> error "ifArgs3: expected 3 args")
ifArgs3c a1 a2 a3 rest3 = case rest3 (Nil -> If a1 a2 a3) (Cons x xs -> error "ifArgs3: expected 3 args")

tryArgs2 as = case as (Cons a1 rest1 -> tryArgs2a a1 rest1) (Nil -> error "tryArgs2: expected 2 args")
tryArgs2a a1 rest1 = case rest1 (Cons a2 rest2 -> tryArgs2b a1 a2 rest2) (Nil -> error "tryArgs2: expected 2 args")
tryArgs2b a1 a2 rest2 = case rest2 (Nil -> Try a1 a2) (Cons x xs -> error "tryArgs2: expected 2 args")

throwArgs2 as = case as (Cons a1 rest1 -> throwArgs2a a1 rest1) (Nil -> error "throwArgs2: expected 2 args")
throwArgs2a a1 rest1 = case rest1 (Cons a2 rest2 -> throwArgs2b a1 a2 rest2) (Nil -> error "throwArgs2: expected 2 args")
throwArgs2b a1 a2 rest2 = case rest2 (Nil -> Throw a1 a2) (Cons x xs -> error "throwArgs2: expected 2 args")

finishApp n as =
  if (charListEq n ifKw /\ (length as == 3))
    (ifArgs3 as)
    (if (charListEq n tryKw /\ (length as == 2))
      (tryArgs2 as)
      (if (charListEq n throwKw /\ (length as == 2))
        (throwArgs2 as)
        (if (isUpperStart n) (Ct n as) (App n as))))

postParseBranch b = case b (CaseBranch c vs bd -> CaseBranch c vs (postParseExpr bd))

postParseExpr e =
  case e
    (Num n -> Num n)
    (FloatLit s -> FloatLit s)
    (Str s -> Str s)
    (Var v -> if (isBoolLit v) (boolLitValue v) (if (isUpperStart v) (Ct v Nil) (Var v)))
    (If a b c -> If (postParseExpr a) (postParseExpr b) (postParseExpr c))
    (App n as -> finishApp n (map postParseExpr as))
    (Prim o as -> Prim o (map postParseExpr as))
    (Ct n as -> Ct n (map postParseExpr as))
    (Case sc cs -> Case (postParseExpr sc) (map postParseBranch cs))
    (NoMatch -> NoMatch)
    (Try b h -> Try (postParseExpr b) (postParseExpr h))
    (Throw nr p -> Throw (postParseExpr nr) (postParseExpr p))
    (_ -> error "postParseExpr: unexpected expression form during parsing")

// == ADT declarations: `name = Con1 !f1 f2 | Con2 | Con3 f3` ================
// The caller (below) has already stripped the leading `::` and isolated
// the logical line before tokenizing, same as parser.cfp's own
// parseAdtDecl/dropChars convention.

pAdtField = (pStrictMark +++ pIdentTok) --> fstOf

mkAdtCon (n, fs) = AdtCon n fs
pAdtCon = (pIdentTok +++ pMany pAdtField) --> mkAdtCon

pAdtDeclToks toks =
  case toks
    (Nil -> error "parseAdt: empty ADT declaration")
    (Cons t rest -> pAdtDeclHead t rest)

pAdtDeclHead t rest =
  case t
    (TIdent n -> pAdtDeclEquals n rest)
    (_ -> error "parseAdt: a type name must start with a name")

pAdtDeclEquals n toks =
  case toks
    (Nil -> error "parseAdt: missing = after the type name")
    (Cons t rest -> pAdtDeclEqualsTok n t rest)

pAdtDeclEqualsTok n t rest =
  case t
    (TEquals ->
       case (pSepBy1 pAdtCon pPipeTok rest)
         (POk cons remTail -> Adt n cons)
         (PErr m r -> error (strcat "parseAdt: " m)))
    (_ -> error "parseAdt: = expected after the type name")

// == Function head: `name arg1 !arg2 = body` =================================

mkArg (strict, name) = Arg name strict
pFuncArg = (pStrictMark +++ pIdentTok) --> mkArg

pFuncClauseToks toks =
  case toks
    (Nil -> error "buildFunc: empty function head")
    (Cons t rest -> pFuncClauseHead t rest)

pFuncClauseHead t rest =
  case t
    (TIdent n -> pFuncClauseArgs n rest)
    (_ -> error "buildFunc: a function head must start with a name")

pFuncClauseArgs n toks =
  case (pMany pFuncArg toks)
    (POk args rest -> pFuncClauseEquals n args rest)
    (PErr m r -> error "pFuncClauseArgs: unreachable, pMany never fails")

pFuncClauseEquals n args toks =
  case toks
    (Nil -> error "buildFunc: missing = in function definition")
    (Cons t rest -> pFuncClauseEqualsTok n args t rest)

pFuncClauseEqualsTok n args t rest =
  case t
    (TEquals -> Func n args (pFuncBody rest))
    (_ -> error "buildFunc: = expected after function head")

// == Multi-line clauses: a newline followed by a space continues the
// current logical line (any indentation), a blank line starts a new one.
// Direct port of parser.cfp's own linesOf/mergeContinuations/
// dropBlankLines/isBlankLine (lines ~620-663) -- pure text preprocessing,
// no combinators involved, unrelated to what this file is actually
// porting to combinators. `stripComment`/`startsWithDoubleColon` are
// reused directly from lexer2.cfp (already imported) rather than
// redeclared. ==============================================================

startsWithSpace cs = case cs (Nil -> False) (Cons c cs2 -> c == 32)

mergeContinuations lns =
  case lns
    (Nil -> Nil)
    (Cons l1 rest -> mergeContinuationsStep l1 rest)

mergeContinuationsStep l1 rest =
  case rest
    (Nil -> Cons l1 Nil)
    (Cons l2 ls -> if (startsWithSpace l2) (mergeContinuations (Cons (append l1 (Cons 32 l2)) ls)) (Cons l1 (mergeContinuations (Cons l2 ls))))

linesOfAcc acc cs =
  case cs
    (Nil -> Cons (reverse acc) Nil)
    (Cons c cs2 -> if (c == 10) (Cons (reverse acc) (linesOfAcc Nil cs2)) (linesOfAcc (Cons c acc) cs2))
linesOf cs = linesOfAcc Nil cs

dropLeadingSpaces cs = case cs (Nil -> Nil) (Cons c cs2 -> if (c == 32) (dropLeadingSpaces cs2) cs)
isBlankLine line = length (dropLeadingSpaces (stripComment line)) == 0

dropBlankLines lns =
  case lns
    (Nil -> Nil)
    (Cons l rest -> if (isBlankLine l) (dropBlankLines rest) (Cons l (dropBlankLines rest)))

dropChars n cs = if (n == 0) cs (case cs (Nil -> Nil) (Cons c cs2 -> dropChars (n - 1) cs2))

// == Program: one clause/ADT declaration per (post-merge) logical line ======

::ParsedProgram = ParsedProgram !fs !as
ppFuncs p = case p (ParsedProgram fs a -> fs)
ppAdts  p = case p (ParsedProgram fs a -> a)

prependFunc f p = case p (ParsedProgram fs a -> ParsedProgram (Cons f fs) a)
prependAdt a p = case p (ParsedProgram fs aa -> ParsedProgram fs (Cons a aa))

parseAdtDeclLine line = pAdtDeclToks (tokenize (dropChars 2 line))
parseFuncClauseLine line = pFuncClauseToks (tokenize line)

parseProgramLines lns =
  case lns
    (Nil -> ParsedProgram Nil Nil)
    (Cons l ls -> parseProgramLinesTok l ls)

parseProgramLinesTok l ls =
  if (isBlankLine l) (parseProgramLines ls)
  (if (startsWithDoubleColon l) (prependAdt (parseAdtDeclLine l) (parseProgramLines ls)) (prependFunc (parseFuncClauseLine l) (parseProgramLines ls)))

// == Whole-program resolve pass ==============================================
// Direct port of parser.cfp's own resolveVar/fixupCtor/completeBranches/
// resolveExpr (lines ~677-819) -- this is what `--emit=parse` ACTUALLY
// dumps (parseProgramText runs this immediately after parseProgramLines,
// there is no separate "resolve stage" in driver.cfp's own stage list), so
// reproducing it is required for byte-for-byte parity, not optional
// polish: it turns a bare 0-arity top-level reference into `App n []`, a
// capitalized top-level FUNCTION name (not an ADT constructor -- e.g.
// benchmarks/sprimes.cfp's Add/Sub/Gt/...) back from `Ct` into `App`, and
// fills every `case`/`select`'s branches out to one-per-constructor
// (declaration order), synthesizing `NoMatch` or reusing a written `_`
// catch-all for whatever the source didn't cover.

resolveVar topNames locals v = if (member locals v) (Var v) (if (member topNames v) (App v Nil) (Var v))

fixupCtor topNames adts n as = if (isKnownCon n adts) (Ct n as) (if (member topNames n) (App n as) (Ct n as))

isConOfAdt name a = isConOfList name (adtConsOf a)
isKnownCon name adts =
  case adts
    (Nil -> False)
    (Cons a as -> if (isConOfAdt name a) True (isKnownCon name as))
adtConNamesOf con adts = map adtConName (adtConsOf (findAdtByCon con adts))

cbCon cb = case cb (CaseBranch c vs b -> c)
cbVars cb = case cb (CaseBranch c vs b -> vs)
cbBody cb = case cb (CaseBranch c vs b -> b)

conArity name adts = length (adtConFields (findAdtCon name (adtConsOf (findAdtByCon name adts))))

mkPlaceholderFieldsAcc n =
  if (n == 0) Nil (Cons (append ['_nm'] (itoa n)) (mkPlaceholderFieldsAcc (n - 1)))
mkNoMatchBranch adts con = CaseBranch con (mkPlaceholderFieldsAcc (conArity con adts)) NoMatch

hasCatchAllBranch branches =
  case branches
    (Nil -> False)
    (Cons b bs -> if (charListEq (cbCon b) ['_']) True (hasCatchAllBranch bs))

catchAllBody branches =
  case branches
    (Nil -> error "catchAllBody: no catch-all branch found")
    (Cons b bs -> if (charListEq (cbCon b) ['_']) (cbBody b) (catchAllBody bs))

mkCatchAllBranch adts con allBranches = CaseBranch con (mkPlaceholderFieldsAcc (conArity con adts)) (catchAllBody allBranches)

findBranchByCon adts con allBranches branches =
  case branches
    (Nil -> if (hasCatchAllBranch allBranches) (mkCatchAllBranch adts con allBranches) (mkNoMatchBranch adts con))
    (Cons b bs -> if (charListEq (cbCon b) con) b (findBranchByCon adts con allBranches bs))

fillBranches adts branches names =
  case names
    (Nil -> Nil)
    (Cons c cs -> Cons (findBranchByCon adts c branches branches) (fillBranches adts branches cs))

headBranch branches = case branches (Cons b bs -> b) (Nil -> error "headBranch: empty")

completeBranches adts branches =
  if (length branches == 0)
    branches
    (if (isKnownCon (cbCon (headBranch branches)) adts) (fillBranches adts branches (adtConNamesOf (cbCon (headBranch branches)) adts)) branches)

resolveBranch topNames adts locals cb =
  case cb
    (CaseBranch c vs b -> CaseBranch c vs (resolveExpr topNames adts (append locals vs) b))

resolveBinding topNames adts locals lb =
  case lb
    (LetBinding n s e -> LetBinding n s (resolveExpr topNames adts locals e))

lbName lb = case lb (LetBinding n s e -> n)

resolveLetLocals topNames adts locals ls b =
  let locals2 = append locals (map lbName ls) in
  Let (map (resolveBinding topNames adts locals2) ls) (resolveExpr topNames adts locals2 b)

resolveExpr topNames adts locals e =
  case e
    (Num n -> Num n)
    (FloatLit s -> FloatLit s)
    (Str s -> Str s)
    (Var v -> resolveVar topNames locals v)
    (If a b c -> If (resolveExpr topNames adts locals a) (resolveExpr topNames adts locals b) (resolveExpr topNames adts locals c))
    (App n as -> App n (map (resolveExpr topNames adts locals) as))
    (Prim o as -> Prim o (map (resolveExpr topNames adts locals) as))
    (Ct n as -> fixupCtor topNames adts n (map (resolveExpr topNames adts locals) as))
    (Case sc cs -> Case (resolveExpr topNames adts locals sc) (map (resolveBranch topNames adts locals) (completeBranches adts cs)))
    (Let ls b -> resolveLetLocals topNames adts locals ls b)
    (NoMatch -> NoMatch)
    (Try b h -> Try (resolveExpr topNames adts locals b) (resolveExpr topNames adts locals h))
    (Throw nr p -> Throw (resolveExpr topNames adts locals nr) (resolveExpr topNames adts locals p))
    (_ -> error "resolveExpr: unexpected expression form")

argName a = case a (Arg n s -> n)

resolveFunc topNames adts f =
  case f
    (Func n args body -> Func n args (resolveExpr topNames adts (map argName args) body))

resolveProgram adts funcs = map (resolveFunc (map funcNameOf funcs) adts) funcs

resolveParsedProgram p =
  case p
    (ParsedProgram fs a -> ParsedProgram (resolveProgram a fs) a)

// == Top-level entry points ===================================================
// `stripComment` is applied per RAW line, BEFORE merging (not left to
// tokenize's own internal call) -- same fix, same reason, as parser.cfp's
// own parseProgramText: an indented comment-only line inside a multi-line
// `case` must reduce to harmless whitespace before merging, or a later
// `//` on a subsequent branch line gets swallowed by a single greedy strip
// over the whole merged blob (docs/2026-08-13 self-hosting regression,
// see parser.cfp's own header comment on parseProgramText for the full
// story).

parseProgramText text = resolveParsedProgram (parseProgramLines (mergeContinuations (dropBlankLines (map stripComment (linesOf text)))))

parseProgramFile filename = parseProgramText (str2list (readFile filename))
