::Point = Pt !x !y
::List = Nil | Cons !x !xs
::MenuCat = MenuCat !name !items
::Graphics = GraphText !c !p !txt | GraphPolyLine !c !pts | GraphPolygon !c !pts | GraphRectangle !c !p1 !p2 | GraphEllipse !c !p1 !p2 | GraphDisc !c !p1 !p2 | GraphClear | GraphMenu !cats | GraphPrompt !title !deflt
::Event = KeyIn !c | MouseDown !p | MouseUp !p | MouseDragged !p | MouseDoubleClick !p | MenuItem !cat !item | PText !txt | OpenFile !content | NoInput

// 16 VGA/EGA Colors
col_black        = 0
col_blue         = 1
col_green        = 2
col_cyan         = 3
col_red          = 4
col_magenta      = 5
col_brown        = 6
col_lightgray    = 7
col_darkgray     = 8
col_brightblue   = 9
col_brightgreen  = 10
col_brightcyan   = 11
col_brightred    = 12
col_brightmagenta = 13
col_yellow       = 14
col_white        = 15

// Basic Point Constructors & Transformers
pt x y = Pt x y

vergrootPt factor p = case p (Pt x y -> Pt (factor * x) (factor * y))

draaiPt hoek p = let c = cos hoek, s = sin hoek in case p (Pt x y -> Pt ((c * x) + (s * y)) ((0.0 - (s * x)) + (c * y)))

verschuifPt d p = case d (Pt dx dy -> case p (Pt x y -> Pt (x + dx) (y + dy)))

addPt p1 p2 = case p1 (Pt x1 y1 -> case p2 (Pt x2 y2 -> Pt (x1 + x2) (y1 + y2)))
subPt p1 p2 = case p1 (Pt x1 y1 -> case p2 (Pt x2 y2 -> Pt (x1 - x2) (y1 - y2)))
scalePt factor p = case p (Pt x y -> Pt (factor * x) (factor * y))
dotPt p1 p2 = case p1 (Pt x1 y1 -> case p2 (Pt x2 y2 -> (x1 * x2) + (y1 * y2)))

distPtHelper x1 y1 x2 y2 = let dx = x1 - x2, dy = y1 - y2 in sqrt ((dx * dx) + (dy * dy))
distPt p1 p2 = case p1 (Pt x1 y1 -> case p2 (Pt x2 y2 -> distPtHelper x1 y1 x2 y2))

// List Helpers
append xs ys = case xs (Nil -> ys) (Cons x rest -> Cons x (append rest ys))

revAppend xs acc = case xs (Nil -> acc) (Cons x rest -> revAppend rest (Cons x acc))
reverseList xs = revAppend xs Nil

mapList f xs = case xs (Nil -> Nil) (Cons x rest -> Cons (f x) (mapList f rest))

filterList p xs = case xs (Nil -> Nil) (Cons x rest -> if (p x) (Cons x (filterList p rest)) (filterList p rest))

lengthList xs = case xs (Nil -> 0) (Cons x rest -> 1 + lengthList rest)

// Force evaluation of entire graphics tree
forcePt p = case p (Pt x y -> Pt x y)

forcePoints pts = case pts (Nil -> Nil) (Cons p ps -> Cons (forcePt p) (forcePoints ps))

forceItem item = case item (GraphText c p txt -> GraphText c (forcePt p) txt) (GraphPolyLine c pts -> GraphPolyLine c (forcePoints pts)) (GraphPolygon c pts -> GraphPolygon c (forcePoints pts)) (GraphRectangle c p1 p2 -> GraphRectangle c (forcePt p1) (forcePt p2)) (GraphEllipse c p1 p2 -> GraphEllipse c (forcePt p1) (forcePt p2)) (GraphDisc c p1 p2 -> GraphDisc c (forcePt p1) (forcePt p2)) (GraphClear -> GraphClear) (GraphMenu cats -> GraphMenu (forceMenuCats cats)) (GraphPrompt title deflt -> GraphPrompt title deflt)

forceGraphics g = case g (Nil -> Nil) (Cons item rest -> Cons (forceItem item) (forceGraphics rest))

forceMenuCats cats = case cats (Nil -> Nil) (Cons c rest -> Cons (forceMenuCat c) (forceMenuCats rest))
forceMenuCat c = case c (MenuCat name items -> MenuCat name items)

// ============================================================
// graphicsout: serializes a [Graphics] list into one flat string for
// transfer across the JMVM/WASM boundary (see
// websapl/js/graphics_renderer.js). Every item is tagged with its
// REAL constructor name, read via `constrName` straight from the
// compiler's own constructor table, instead of a positional
// `constr_N` index - so reordering or renaming a constructor in the
// `::Graphics` declaration above can never silently desync the tag
// the renderer dispatches on: a mismatch either fails to compile
// (case pattern check below) or shows up as an unrecognized tag
// string, never a silently misrendered picture. Point lists are
// length-prefixed (`<n> x1 y1 x2 y2 ...`) so the renderer doesn't
// need to search for an end-of-list sentinel either.
// ============================================================

graphicsout gs = list2str (graphicsoutChars gs)

graphicsoutChars gs =
  case gs
    (Nil -> Nil)
    (Cons g rest -> append (itemChars g) (graphicsoutChars rest))

itemChars g =
  case g
    (GraphClear -> tagChars g)
    (GraphText c p txt -> append (tagChars g) (append (intChars c) (append (ptChars p) (quotedChars txt))))
    (GraphPolyLine c pts -> pointsItemChars g c pts)
    (GraphPolygon c pts -> pointsItemChars g c pts)
    (GraphRectangle c p1 p2 -> pairItemChars g c p1 p2)
    (GraphEllipse c p1 p2 -> pairItemChars g c p1 p2)
    (GraphDisc c p1 p2 -> pairItemChars g c p1 p2)
    (GraphMenu cats -> append (tagChars g) (menuCatsChars cats))
    (GraphPrompt title deflt -> append (tagChars g) (append (quotedChars title) (quotedChars deflt)))

// GraphMenu wire format: `<nCats> <cat1> <cat2> ...`, each category
// `<"name"> <nItems> <"item1"> <"item2"> ...` - same length-prefixed,
// no-end-sentinel style as ptsChars above, quoted like GraphText's txt
// field (menu/item names are short identifiers, never containing a
// literal '"' - same assumption quotedChars already documents).
menuCatsChars cats = append (intChars (lengthList cats)) (menuCatsBody cats)

menuCatsBody cats =
  case cats
    (Nil -> Nil)
    (Cons c rest -> append (menuCatChars c) (menuCatsBody rest))

menuCatChars c =
  case c
    (MenuCat name items -> append (quotedChars name) (append (intChars (lengthList items)) (menuItemsChars items)))

menuItemsChars items =
  case items
    (Nil -> Nil)
    (Cons it rest -> append (quotedChars it) (menuItemsChars rest))

pairItemChars g c p1 p2 = append (tagChars g) (append (intChars c) (append (ptChars p1) (ptChars p2)))

pointsItemChars g c pts = append (tagChars g) (append (intChars c) (append (intChars (lengthList pts)) (ptsChars pts)))

ptsChars pts =
  case pts
    (Nil -> Nil)
    (Cons p rest -> append (ptChars p) (ptsChars rest))

ptChars p = case p (Pt x y -> append (floatChars x) (floatChars y))

tagChars g = append (str2list (constrName g)) (Cons ' ' Nil)

intChars n = append (itoa n) (Cons ' ' Nil)

floatChars x = append (str2list (ftoa x)) (Cons ' ' Nil)

// txt is assumed not to contain a literal '"' - true for every GraphText
// call site in grafisch/*.cfp today; not a general-purpose escaping scheme.
quotedChars txt = Cons '"' (append (str2list txt) (Cons '"' (Cons ' ' Nil)))

// -------------------------------------------------------------
// Minimal char-list <-> packed-string helpers, kept local to this
// file (same recipe as lib/stdlib.cfp) rather than imported from it,
// since importing lib/stdlib.cfp would redefine `append`/`mapList`/...
// already declared above and Sapl rejects duplicate top-level names.
// -------------------------------------------------------------

str2list s = strls 0 s
strls n s = if (n < strlen s) (Cons (strat n s) (strls (n + 1) s)) Nil

list2str cs = fillStr 0 cs (strcreate (lengthList cs))
fillStr i xs arr =
  case xs
    (Nil -> arr)
    (Cons c cs -> fillStr (i + 1) cs (update c i arr))

itoa n =
  if (n < 0) (Cons '-' (itoa (0 - n)))
  (if (n < 10) (Cons ('0' + n) Nil)
  (append (itoa (n / 10)) (Cons ('0' + (n % 10)) Nil)))

// ============================================================
// parseEvent / splitWords / decodePointList: the input-side mirror of
// graphicsout above - decode a stdin line back into real Sapl values
// for the state-per-event protocol (see the interactive demos'
// `start`, e.g. grafisch/bspline.cfp). Same tag-based, no-quoting-
// needed style: an Event's fields are only floats/a charcode, so a
// line is just whitespace-separated words, no string escaping.
// ============================================================

strEqual s1 s2 = (strlen s1 == strlen s2) /\ strEqualAt 0 s1 s2
strEqualAt n s1 s2 = if (n >= strlen s1) 1 (if (strat n s1 == strat n s2) (strEqualAt (n + 1) s1 s2) 0)

splitWords s = splitWordsChars (str2list s)

splitWordsChars cs =
  case cs
    (Nil -> Nil)
    (Cons c rest -> if (c == ' ') (splitWordsChars rest) (splitWordsWord cs))

splitWordsWord cs = Cons (list2str (takeWordChars cs)) (splitWordsChars (dropWordChars cs))

takeWordChars cs =
  case cs
    (Nil -> Nil)
    (Cons c rest -> if (c == ' ') Nil (Cons c (takeWordChars rest)))

dropWordChars cs =
  case cs
    (Nil -> Nil)
    (Cons c rest -> if (c == ' ') rest (dropWordChars rest))

// -------------------- Event decoding --------------------

// `PText` is the odd one out: its payload is free text that MAY contain
// spaces (a filename, a "New Text" content string, ...), unlike every
// other event's fields (a coordinate, a menu category/item - always
// single words). splitWords would silently truncate it at the first
// space, so PText is recognized on the RAW line, before word-splitting
// - "PText " (6 chars) followed by the text verbatim, no quoting (this
// is stdin from the JS side, not graphicsout's quoted OUTPUT protocol;
// a literal '"' in the text is fine here, same non-general-purpose
// assumption quotedChars documents for the other direction).
startsWithPText line = (strlen line >= 6) /\ strEqualAt 0 "PText " line

// Fase 6 (Open/Save): "File → Open" is intercepted entirely in
// websapl/graphics.html via a native file-picker (no GraphPrompt round
// trip) -- once a file is chosen, its content (a `figListChars`-format
// blob, itself space-separated) is sent back as ONE `OpenFile <content>`
// stdin line. Same raw-line reasoning as PText: a VText figure's own
// text may contain spaces, so this can't go through splitWords either.
startsWithOpenFile line = (strlen line >= 9) /\ strEqualAt 0 "OpenFile " line

parseEvent line =
  if (startsWithPText line) (PText (dropCharsFromStr 6 line))
  (if (startsWithOpenFile line) (OpenFile (dropCharsFromStr 9 line))
  (parseEventWords (splitWords line)))

dropCharsFromStr n s = list2str (dropChars n (str2list s))

dropChars n cs = if (n <= 0) cs (dropChars1 n cs)
dropChars1 n cs = case cs (Nil -> Nil) (Cons c rest -> dropChars (n - 1) rest)

parseEventWords ws =
  case ws
    (Nil -> NoInput)
    (Cons tag rest -> parseEventTag tag rest)

parseEventTag tag rest =
  if (strEqual tag "MouseDown") (MouseDown (parseEventPt rest))
  (if (strEqual tag "MouseUp") (MouseUp (parseEventPt rest))
  (if (strEqual tag "MouseDragged") (MouseDragged (parseEventPt rest))
  (if (strEqual tag "MouseDoubleClick") (MouseDoubleClick (parseEventPt rest))
  (if (strEqual tag "KeyIn") (KeyIn (parseEventKey rest))
  (if (strEqual tag "MenuItem") (parseMenuItemEvent rest)
  NoInput)))))

// `MenuItem <cat> <item>` - both single words (every GRAFIEK.AMA menu
// item name is one word: "Open"/"Save"/"Select"/"Rect"/"black"/... - see
// grafisch/GRAFIEK.AMA's own `menu` definition), so no quoting needed on
// this side (unlike the OUTPUT-side quotedChars, which quotes for the
// JS/canvas parser, not for parseEvent's own splitWords).
parseMenuItemEvent ws =
  case ws
    (Nil -> NoInput)
    (Cons cat rest2 -> parseMenuItemEventItem cat rest2)

parseMenuItemEventItem cat rest2 =
  case rest2
    (Nil -> NoInput)
    (Cons item rest3 -> MenuItem cat item)

parseEventPt ws =
  case ws
    (Nil -> Pt 0.0 0.0)
    (Cons xs rest -> parseEventPtY xs rest)

parseEventPtY xs rest =
  case rest
    (Nil -> Pt (atof xs) 0.0)
    (Cons ys rest2 -> Pt (atof xs) (atof ys))

parseEventKey ws =
  case ws
    (Nil -> 0)
    (Cons cs rest -> ftoi (atof cs))

// -------------------- Generic numeric decoding (mirrors floatChars/ptsChars) --------------------

// Every word on the line, parsed as a float - handy for a demo whose
// state is a fixed-size tuple of floats (see grafisch/convex.cfp).
decodeFloatWords ws =
  case ws
    (Nil -> Nil)
    (Cons w rest -> Cons (atof w) (decodeFloatWords rest))

// A length-prefixed point list, `<n> x1 y1 x2 y2 ...` - the exact
// inverse of pointsItemChars's point-list encoding, for a demo whose
// state is a variable-length point list (see grafisch/bspline.cfp).
decodePointList ws =
  case ws
    (Nil -> Nil)
    (Cons nStr rest -> decodePoints (ftoi (atof nStr)) rest)

decodePoints n ws = if (n <= 0) Nil (decodePointsStep n ws)

decodePointsStep n ws =
  case ws
    (Nil -> Nil)
    (Cons xs rest -> decodePointsStepY n xs rest)

decodePointsStepY n xs rest =
  case rest
    (Nil -> Nil)
    (Cons ys rest2 -> Cons (Pt (atof xs) (atof ys)) (decodePoints (n - 1) rest2))
