#import "grafisch/graphics.cfp"

// Cubic B-Spline Basis Functions for t in [0, 1]
b0 t = ((1.0 - t) * (1.0 - t) * (1.0 - t)) / 6.0
b1 t = ((3.0 * t * t * t) - (6.0 * t * t) + 4.0) / 6.0
b2 t = (((0.0 - 3.0) * t * t * t) + (3.0 * t * t) + (3.0 * t) + 1.0) / 6.0
b3 t = (t * t * t) / 6.0

// Evaluate single point on B-Spline segment
evalSplineHelper x0 y0 x1 y1 x2 y2 x3 y3 t = 
  let c0 = b0 t,
      c1 = b1 t,
      c2 = b2 t,
      c3 = b3 t,
      px = (c0 * x0) + (c1 * x1) + (c2 * x2) + (c3 * x3),
      py = (c0 * y0) + (c1 * y1) + (c2 * y2) + (c3 * y3)
  in Pt px py

evalSplinePt p0 p1 p2 p3 t = 
  case p0 (Pt x0 y0 -> case p1 (Pt x1 y1 -> case p2 (Pt x2 y2 -> case p3 (Pt x3 y3 ->
    evalSplineHelper x0 y0 x1 y1 x2 y2 x3 y3 t))))

// Sample a segment from t=0 to t=1 with nSteps
sampleSegmentNext p0 p1 p2 p3 step nSteps acc = 
  let t = (itof step) / (itof nSteps),
      pt = evalSplinePt p0 p1 p2 p3 t
  in sampleSegmentStep p0 p1 p2 p3 (step + 1) nSteps (Cons pt acc)

sampleSegmentStep p0 p1 p2 p3 step nSteps acc = 
  if (step > nSteps) acc (sampleSegmentNext p0 p1 p2 p3 step nSteps acc)

sampleSegment p0 p1 p2 p3 nSteps = 
  let pts = sampleSegmentStep p0 p1 p2 p3 0 nSteps Nil in
  reverseList pts

// Generate all spline segments for a list of control points
genSplineHelper p0 p1 p2 p3 r1 nSteps = 
  let seg = sampleSegment p0 p1 p2 p3 nSteps,
      tailSegs = genSplineSegments r1 nSteps
  in append seg tailSegs

genSplineSegments pts nSteps = 
  case pts (Nil -> Nil) (Cons p0 r1 ->
  case r1 (Nil -> Nil) (Cons p1 r2 ->
  case r2 (Nil -> Nil) (Cons p2 r3 ->
  case r3 (Nil -> Nil) (Cons p3 rest ->
    genSplineHelper p0 p1 p2 p3 r1 nSteps))))

// Draw control point markers - the selected one (dragged idx) larger
// and in a different color, matching the old JS-side highlight.
toDiscSel idx i p = case p (Pt x y -> toDiscSelXY idx i x y)
toDiscSelXY idx i x y =
  if (i == idx)
    (GraphDisc col_yellow (Pt (x - 0.035) (y - 0.035)) (Pt (x + 0.035) (y + 0.035)))
    (GraphDisc col_brightred (Pt (x - 0.025) (y - 0.025)) (Pt (x + 0.025) (y + 0.025)))

drawControlDiscsSel pts idx = drawControlDiscsSelStep pts idx 0
drawControlDiscsSelStep pts idx i =
  case pts
    (Nil -> Nil)
    (Cons p rest -> Cons (toDiscSel idx i p) (drawControlDiscsSelStep rest idx (i + 1)))

// Example / default Control Points
ctrlPoints =
  let p1 = Pt (0.0 - 0.8) (0.0 - 0.5),
      p2 = Pt (0.0 - 0.5) 0.6,
      p3 = Pt (0.0 - 0.1) (0.0 - 0.6),
      p4 = Pt 0.3 0.7,
      p5 = Pt 0.7 (0.0 - 0.4),
      p6 = Pt 0.9 0.3
  in Cons p1 (Cons p2 (Cons p3 (Cons p4 (Cons p5 (Cons p6 Nil)))))

renderBSplineFromPts pts idx nSteps =
  let poly = GraphPolyLine col_darkgray pts,
      discs = drawControlDiscsSel pts idx,
      curvePts = genSplineSegments pts nSteps,
      curve = GraphPolyLine col_brightcyan curvePts
  in append (Cons poly discs) (Cons curve Nil)

// -------------------------------------------------------------
// Interactive state: the control-point list plus which index (if
// any, -1 = none) is currently being dragged.
// -------------------------------------------------------------

::BsplineState = BsplineState !pts !selectedIdx

defaultBsplineState = BsplineState ctrlPoints (0 - 1)

decodeBsplineState line = if (strEqual line "") defaultBsplineState (decodeBsplineWords (splitWords line))
decodeBsplineWords ws =
  case ws
    (Nil -> defaultBsplineState)
    (Cons idxStr rest -> BsplineState (decodePointList rest) (ftoi (atof idxStr)))

encodeBsplineState state = case state (BsplineState pts idx -> list2str (append (intChars idx) (append (intChars (lengthList pts)) (ptsChars pts))))

nearestPointIdx pts p = nearestPointIdxStep pts p 0 (0 - 1) 0.08
nearestPointIdxStep pts p i bestIdx bestDist =
  case pts
    (Nil -> bestIdx)
    (Cons q rest -> nearestPointIdxCheck q rest p i bestIdx bestDist)
nearestPointIdxCheck q rest p i bestIdx bestDist =
  let d = distPt q p in
  if (d < bestDist)
    (nearestPointIdxStep rest p (i + 1) i d)
    (nearestPointIdxStep rest p (i + 1) bestIdx bestDist)

appendPoint pts p = append pts (Cons p Nil)

replaceAt pts idx p = replaceAtStep pts idx p 0
replaceAtStep pts idx p i =
  case pts
    (Nil -> Nil)
    (Cons q rest -> if (i == idx) (Cons p (replaceAtStep rest idx p (i + 1))) (Cons q (replaceAtStep rest idx p (i + 1))))

stepBsplineDown pts p =
  let nearest = nearestPointIdx pts p in
  if (nearest >= 0)
    (BsplineState pts nearest)
    (BsplineState (appendPoint pts p) (lengthList pts))

stepBsplineDrag pts idx p =
  if ((idx >= 0) /\ (idx < lengthList pts))
    (BsplineState (replaceAt pts idx p) idx)
    (BsplineState pts idx)

stepBspline state event = case state (BsplineState pts idx -> stepBsplineFields pts idx event)
stepBsplineFields pts idx event =
  case event
    (MouseDown p -> stepBsplineDown pts p)
    (MouseDragged p -> stepBsplineDrag pts idx p)
    (MouseUp p -> BsplineState pts (0 - 1))
    (_ -> BsplineState pts idx)

renderBsplineState state = case state (BsplineState pts idx -> renderBSplineFromPts pts idx 12)

// stateLine/eventLine must be forced (via <#>) before use - see
// grafisch/boom.cfp's start for why an unforced readLine can silently
// never fire.
start =
  let stateLine = readLine,
      eventLine = readLine,
      state0    = decodeBsplineState stateLine,
      event     = parseEvent eventLine,
      state1    = stepBspline state0 event,
      pic       = renderBsplineState state1
  in stateLine <#> eventLine <#> printString (encodeBsplineState state1) <#> writeChar 1 10 <#> printString (graphicsout (forceGraphics pic)) <#> writeChar 1 10
