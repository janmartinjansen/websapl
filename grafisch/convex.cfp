#import "grafisch/graphics.cfp"

::Pt3 = Pt3 !x !y !z
::Edge3 = Edge3 !p1 !p2

// 3D Rotations
rotX3Helper phi x y z = 
  let c = cos phi, s = sin phi in
  Pt3 x ((c * y) - (s * z)) ((s * y) + (c * z))

rotX3 phi p = case p (Pt3 x y z -> rotX3Helper phi x y z)

rotY3Helper phi x y z = 
  let c = cos phi, s = sin phi in
  Pt3 ((c * x) + (s * z)) y ((0.0 - (s * x)) + (c * z))

rotY3 phi p = case p (Pt3 x y z -> rotY3Helper phi x y z)

rotZ3Helper phi x y z = 
  let c = cos phi, s = sin phi in
  Pt3 ((c * x) - (s * y)) ((s * x) + (c * y)) z

rotZ3 phi p = case p (Pt3 x y z -> rotZ3Helper phi x y z)

rotEdgeX phi e = case e (Edge3 p1 p2 -> Edge3 (rotX3 phi p1) (rotX3 phi p2))
rotEdgeY phi e = case e (Edge3 p1 p2 -> Edge3 (rotY3 phi p1) (rotY3 phi p2))
rotEdgeZ phi e = case e (Edge3 p1 p2 -> Edge3 (rotZ3 phi p1) (rotZ3 phi p2))

// Perspective Projection from 3D to 2D
projectPtHelper x y z = 
  let d = z + 2.2,
      px = (1.5 * x) / d,
      py = (1.5 * y) / d
  in Pt px py

projectPt p = case p (Pt3 x y z -> projectPtHelper x y z)

projectEdgeHelper p1 p2 = 
  let pt1 = projectPt p1,
      pt2 = projectPt p2
  in Cons pt1 (Cons pt2 Nil)

projectEdge e = case e (Edge3 p1 p2 -> projectEdgeHelper p1 p2)

makeList4 a b c d = Cons a (Cons b (Cons c (Cons d Nil)))

// 3D Cube Edges
cubeEdges = 
  let s = 0.5,
      ns = 0.0 - 0.5,
      p000 = Pt3 ns ns ns,
      p001 = Pt3 ns ns s,
      p010 = Pt3 ns s ns,
      p011 = Pt3 ns s s,
      p100 = Pt3 s ns ns,
      p101 = Pt3 s ns s,
      p110 = Pt3 s s ns,
      p111 = Pt3 s s s,
      e1  = Edge3 p000 p001,
      e2  = Edge3 p001 p011,
      e3  = Edge3 p011 p010,
      e4  = Edge3 p010 p000,
      e5  = Edge3 p100 p101,
      e6  = Edge3 p101 p111,
      e7  = Edge3 p111 p110,
      e8  = Edge3 p110 p100,
      e9  = Edge3 p000 p100,
      e10 = Edge3 p001 p101,
      e11 = Edge3 p010 p110,
      e12 = Edge3 p011 p111,
      l1  = makeList4 e1 e2 e3 e4,
      l2  = makeList4 e5 e6 e7 e8,
      l3  = makeList4 e9 e10 e11 e12
  in append l1 (append l2 l3)

// Render 3D Edges to Graphics
toPolyGreen seg = GraphPolyLine col_brightgreen seg
renderEdges edges = 
  let projLines = mapList projectEdge edges in
  mapList toPolyGreen projLines

// Rotate entire scene
rotateScene phiX phiY phiZ edges = 
  let rX = mapList (rotEdgeX phiX) edges,
      rY = mapList (rotEdgeY phiY) rX,
      rZ = mapList (rotEdgeZ phiZ) rY
  in rZ

// Static demo view (rotated 3D cube)
renderCube phiX phiY phiZ = 
  let rot = rotateScene phiX phiY phiZ cubeEdges in
  renderEdges rot

// -------------------------------------------------------------
// Interactive state: 3 rotation angles plus the last cursor position
// (needed to turn MouseDragged's absolute point into a delta, since
// ::Event only carries an absolute Pt, not a movement vector).
// -------------------------------------------------------------

::ConvexState = ConvexState !rotX !rotY !rotZ !lastX !lastY

defaultConvexState = ConvexState 0.5 0.7 0.2 0.0 0.0

decodeConvexState line = if (strEqual line "") defaultConvexState (convexStateFromFloats (decodeFloatWords (splitWords line)))

convexStateFromFloats fs = case fs (Nil -> defaultConvexState) (Cons rx rest -> convexStateFromFloats2 rx rest)
convexStateFromFloats2 rx rest = case rest (Nil -> defaultConvexState) (Cons ry rest2 -> convexStateFromFloats3 rx ry rest2)
convexStateFromFloats3 rx ry rest2 = case rest2 (Nil -> defaultConvexState) (Cons rz rest3 -> convexStateFromFloats4 rx ry rz rest3)
convexStateFromFloats4 rx ry rz rest3 = case rest3 (Nil -> defaultConvexState) (Cons lx rest4 -> convexStateFromFloats5 rx ry rz lx rest4)
convexStateFromFloats5 rx ry rz lx rest4 = case rest4 (Nil -> defaultConvexState) (Cons ly rest5 -> ConvexState rx ry rz lx ly)

encodeConvexState s = list2str (encodeConvexStateChars s)
encodeConvexStateChars s = case s (ConvexState rx ry rz lx ly -> append (floatChars rx) (append (floatChars ry) (append (floatChars rz) (append (floatChars lx) (floatChars ly)))))

tau = 6.28318

wrapAngle a = if (a < 0.0) (a + tau) (if (a > tau) (a - tau) a)

setLastPos state p = case state (ConvexState rx ry rz lx ly -> setLastPosXY rx ry rz p)
setLastPosXY rx ry rz p = case p (Pt x y -> ConvexState rx ry rz x y)

dragConvex state p = case state (ConvexState rx ry rz lx ly -> dragConvexHelper rx ry rz lx ly p)
dragConvexHelper rx ry rz lx ly p =
  case p
    (Pt x y -> ConvexState (wrapAngle (rx - ((y - ly) * 2.5))) (wrapAngle (ry + ((x - lx) * 2.5))) rz x y)

stepConvex state event =
  case event
    (MouseDown p -> setLastPos state p)
    (MouseDragged p -> dragConvex state p)
    (_ -> state)

renderConvexState state = case state (ConvexState rx ry rz lx ly -> renderCube rx ry rz)

// stateLine/eventLine must be forced (via <#>) before use - see
// grafisch/boom.cfp's start for why an unforced readLine can silently
// never fire.
start =
  let stateLine = readLine,
      eventLine = readLine,
      state0    = decodeConvexState stateLine,
      event     = parseEvent eventLine,
      state1    = stepConvex state0 event,
      pic       = renderConvexState state1
  in stateLine <#> eventLine <#> printString (encodeConvexState state1) <#> writeChar 1 10 <#> printString (graphicsout (forceGraphics pic)) <#> writeChar 1 10
