#import "lib/stdlib.cfp"
#import "sapl_compiler/newparser_ast.cfp"
// escapeStr (below, ppExpr's Str case) -- explicit, not relying on
// driver.cfp happening to import both this file and stage5_codegen.cfp
// together.
#import "sapl_compiler/stage5_codegen.cfp"
// funcNameOf/funcArityOf/funcArgs/argStrict (writeDefFile below) -- also
// already reachable transitively via stage5_codegen.cfp's own import of
// this file, but explicit here too for the same reason as the import
// above: don't lean on another file's import graph happening to supply it.
#import "sapl_compiler/ast_helpers.cfp"

// stage_dump.cfp - pretty-printer for newparser_ast.cfp's Func/expr/adt
// types, for the --emit=<stage> CLI flag on ./compile-sapl (see docs/
// decompiler/2026-08-18_eval_hang_pauze_en_stagevorm_decompiler_plan.md section 4).
// Renders in the SAME concrete notation as main.pdf's own figures and
// ordinary Sapl source (juxtaposed application, infix Prim operators,
// `if (c) t e`, `case x (Con v -> body) ...`, `let a = X, b = Y in body`,
// `eval(n)`/`thunk (...)`/`lazy (...)`/`closure (...)`) -- NOT the earlier
// generic reflection-based Cons(...)-nested dump this file used to
// contain (superseded 18 augustus 2026, same day: the reflection version
// was readable enough to spot bugs in, but didn't look like the paper,
// which was the actual point of --emit=<stage> for an educational site).
//
// A plain typed pretty-printer, not reflection-based: newparser_ast.cfp's
// shapes are fully known ahead of time (unlike a truly generic dumper),
// so ordinary `case` pattern matching is simpler, faster, and needs no
// runtime type inspection at all. Every name/identifier field (Var's
// name, App's name, Ct's name, CaseBranch's con/vars, Arg's name, ...) is
// a Sapl char-list (what ['...'] bracket-literal sugar produces) by
// construction from the parser -- list2str turns it into a packed string
// directly, no char-list-vs-string ambiguity to detect (the old version's
// isCharListLike heuristic is gone; it's simply not needed once the exact
// type is known).
//
// Parenthesization matches docs/sapl_programmeer_regels.md's own
// precedence table (juxtaposed application binds tighter than any infix
// operator) and was verified character-for-character against main.pdf's
// own facl example: `facl n = if (eval(n) == 0) 1 (eval(n) * facl (thunk
// (facl_1 n)))`. Two DIFFERENT wrapping rules are needed, not one:
//   - ppPrimOperand (a Prim's own two operands): a compound application
//     (App/Ct/Thunk/Lazy/Closure, all rendered as juxtaposition) does NOT
//     need wrapping here, since juxtaposition binds tighter than any
//     infix operator -- `eval(n) * facl (thunk (facl_1 n))` has no extra
//     parens around `facl (thunk (facl_1 n))` even though it's the right
//     operand of `*`.
//   - ppAppArg (an application's OWN argument -- App/Ct's arg list,
//     Thunk/Lazy/Closure's inner expr, If/Try/Throw's sub-parts): the
//     SAME compound application DOES need wrapping here, since
//     juxtaposition is left-associative (`thunk facl_1 n` would parse as
//     `(thunk facl_1) n`, not `thunk (facl_1 n)` -- confirmed this was
//     the bug in an early draft, caught by checking against the paper's
//     exact text before committing).
// Eval as a Prim operand never needs extra wrapping (`eval(n)`'s own
// tight parens already self-delimit it there, matching the paper: `eval(n)
// == 0`, not `(eval(n)) == 0`) -- but as an APPLICATION'S OWN ARGUMENT it
// DOES, same reason as any other compound application: `sumall eval(xs2)`
// would parse as `(sumall eval) (xs2)` under left-associative
// juxtaposition, not `sumall (eval(xs2))` (caught by inspecting real
// output on an ADT-matching example before committing -- facl's own
// example never exercises this, Eval only ever appears there as a Prim
// operand). So isAtomExpr/ppAppArg treat Eval as any other non-atomic
// expression; only ppPrimOperand special-cases it.
//
// A zero-argument App/Ct (a bare function/constructor reference, e.g.
// MyNil or a 0-arity helper) is also atomic for ppAppArg's purposes --
// nothing can misassociate with it since there's no argument list to
// swallow a following token, so `MyCons 3 MyNil` (not `MyCons 3
// (MyNil)`) is both unambiguous and matches how it'd actually be written.

isAtomExpr e =
  case e
    (Num n -> True)
    (FloatLit s -> True)
    (Str s -> True)
    (Var v -> True)
    (NoMatch -> True)
    (App n as -> isEmptyArgs as)
    (Ct n as -> isEmptyArgs as)
    (_ -> False)

isEmptyArgs as = case as (Nil -> True) (_ -> False)

needsWrapAsPrimOperand e =
  case e
    (Prim op as -> True)
    (If c t el -> True)
    (Case sc cs -> True)
    (Let ls b -> True)
    (Try b h -> True)
    (Throw nr p -> True)
    (_ -> False)

ppPrimOperand e =
  if (needsWrapAsPrimOperand e) (strcat "(" (strcat (ppExpr e) ")")) (ppExpr e)

ppAppArg e =
  if (isAtomExpr e) (ppExpr e) (strcat "(" (strcat (ppExpr e) ")"))

ppExpr e =
  case e
    (Num n -> list2str (itoa n))
    (FloatLit s -> list2str s)
    // escapeStr: sapl_compiler/stage5_codegen.cfp's own string-literal
    // escaper (`push "..."`'s TEXT needs the same escaping the lexer can
    // read back). Reused, not reimplemented -- an unescaped source string
    // containing a literal '"' or '\' broke the retag dump's own
    // re-tokenizing (lexer2.cfp's readStrLit, "tokenize: missing closing
    // \" in string literal", found 13 september 2026 dumping
    // sapl_compiler's own ~4618-line source). A first attempt duplicated
    // this logic locally under the same name (`escapeStrChar`) and hit
    // "already defined" at compile time -- the collision itself is the
    // evidence this already existed, not something to name around.
    (Str s -> strcat "\"" (strcat (list2str (escapeStr s)) "\""))
    (Var v -> list2str v)
    (NoMatch -> "nomatch")
    (If c t el -> ppIf c t el)
    (App n as -> ppJuxtaposed n as)
    (Prim op as -> ppPrim op as)
    (Ct n as -> ppJuxtaposed n as)
    (Case sc cs -> ppCase sc cs)
    (Let ls b -> ppLet ls b)
    (Lazy inner -> strcat "lazy " (ppAppArg inner))
    (Thunk inner -> strcat "thunk " (ppAppArg inner))
    (Closure inner -> strcat "closure " (ppAppArg inner))
    (Eval inner -> strcat "eval(" (strcat (ppExpr inner) ")"))
    (Try b h -> strcat "try " (strcat (ppAppArg b) (strcat " " (ppAppArg h))))
    (Throw nr p -> strcat "throw " (strcat (ppAppArg nr) (strcat " " (ppAppArg p))))

ppIf c t el = strcat "if " (strcat (ppAppArg c) (strcat " " (strcat (ppAppArg t) (strcat " " (ppAppArg el)))))

// Juxtaposed application: `name arg1 arg2 ...` (App and Ct render
// identically -- a constructor application is just a juxtaposed
// application whose head happens to be capitalized by convention).
ppJuxtaposed n as = strcat (list2str n) (ppArgsSpace as)

ppArgsSpace as =
  case as
    (Nil -> "")
    (Cons a rest -> strcat " " (strcat (ppAppArg a) (ppArgsSpace rest)))

// Infix rendering for the two-operand case (every Prim this codebase
// actually produces -- primInstr/isComparisonOp in stage5_codegen.cfp
// only ever cover binary operators). Falls back to a labeled juxtaposed
// form for any other arity instead of erroring: this is a display tool,
// not a codegen stage, so a graceful (if unexpected) rendering beats
// refusing to show a genuinely-encountered value.
ppPrim op as =
  case as
    (Cons a rest -> ppPrimRest op a rest)
    (Nil -> strcat "prim_" (strcat (list2str op) (ppArgsSpace as)))

ppPrimRest op a rest =
  case rest
    (Cons b rest2 -> ppPrimCheckTail op a b rest2)
    (Nil -> strcat "prim_" (strcat (list2str op) (ppArgsSpace (Cons a rest))))

ppPrimCheckTail op a b rest2 =
  case rest2
    (Nil -> strcat (ppPrimOperand a) (strcat " " (strcat (list2str op) (strcat " " (ppPrimOperand b)))))
    (Cons c more -> strcat "prim_" (strcat (list2str op) (ppArgsSpace (Cons a (Cons b rest2)))))

ppCase sc cs = strcat "case " (strcat (ppAppArg sc) (strcat " " (ppBranches cs)))

ppBranches cs =
  case cs
    (Nil -> "")
    (Cons cb rest -> ppBranchesCons cb rest)

ppBranchesCons cb rest =
  case rest
    (Nil -> ppBranch cb)
    (Cons cb2 rest2 -> strcat (ppBranch cb) (strcat " " (ppBranchesCons cb2 rest2)))

ppBranch cb = case cb (CaseBranch con vars body -> strcat "(" (strcat (list2str con) (strcat (ppVarsSpace vars) (strcat " -> " (strcat (ppExpr body) ")")))))

ppVarsSpace vars =
  case vars
    (Nil -> "")
    (Cons v rest -> strcat " " (strcat (list2str v) (ppVarsSpace rest)))

ppLet ls b = strcat "let " (strcat (ppLetBindings ls) (strcat " in " (ppExpr b)))

ppLetBindings ls =
  case ls
    (Nil -> "")
    (Cons lb rest -> ppLetBindingsCons lb rest)

ppLetBindingsCons lb rest =
  case rest
    (Nil -> ppLetBinding lb)
    (Cons lb2 rest2 -> strcat (ppLetBinding lb) (strcat ", " (ppLetBindingsCons lb2 rest2)))

ppLetBinding lb = case lb (LetBinding n s rhs -> strcat (ppStrictMark s) (strcat (list2str n) (strcat " = " (ppExpr rhs))))

ppStrictMark s = if (s == 0) "" "!"

// == functions, with their parameter list (!-marked when strict, same
// convention as real Sapl source syntax: `fac !n = ...`) ==

ppArg a = case a (Arg n s -> strcat (ppStrictMark s) (list2str n))

ppArgsHeader args =
  case args
    (Nil -> "")
    (Cons a rest -> strcat " " (strcat (ppArg a) (ppArgsHeader rest)))

ppFunc f = case f (Func name args body -> strcat (list2str name) (strcat (ppArgsHeader args) (strcat " = " (ppExpr body))))

ppFuncsOnly fs =
  case fs
    (Nil -> "")
    (Cons f rest -> strcat (ppFunc f) (strcat "\n" (ppFuncsOnly rest)))

// == ADT declarations: `::name = Con1 x0 x1 | Con2` (field NAMES aren't
// tracked anywhere in this AST -- docs/sapl_programmeer_regels.md section
// 1 notes they're free labels -- only per-field strictness is, so fields
// render as generic x0/x1/... with a !-mark, same convention decompiler.py
// already uses in impersapl/ for the same reason). ==

ppAdt a = case a (Adt name cons -> strcat "::" (strcat (list2str name) (strcat " = " (ppAdtCons cons))))

ppAdtCons cons =
  case cons
    (Nil -> "")
    (Cons c rest -> ppAdtConsCons c rest)

ppAdtConsCons c rest =
  case rest
    (Nil -> ppAdtCon c)
    (Cons c2 rest2 -> strcat (ppAdtCon c) (strcat " | " (ppAdtConsCons c2 rest2)))

ppAdtCon c = case c (AdtCon name fields -> strcat (list2str name) (ppAdtFieldsAt fields 0))

ppAdtFieldsAt fields i =
  case fields
    (Nil -> "")
    (Cons s rest -> strcat " " (strcat (ppStrictMark s) (strcat "x" (strcat (list2str (itoa i)) (ppAdtFieldsAt rest (i + 1))))))

ppAdtsOnly adts =
  case adts
    (Nil -> "")
    (Cons a rest -> strcat (ppAdt a) (strcat "\n" (ppAdtsOnly rest)))

// Public entry point: ADT declarations first (if any), then every
// function, one per line -- matches the layout of real Sapl source.
//
// O(n^2) on real-sized programs (kept only because
// sapl_compiler/test_retag_roundtrip.cfp's byte-diff check calls it
// directly on tiny examples): every ppFuncsOnly/ppArgsSpace/ppBranchesCons/
// ppLetBindingsCons/ppAdtsOnly step is `strcat headPiece (strcat sep
// (recurseOnRest))` -- strcat on packed-array strings copies BOTH operands
// into a fresh array, and the inner recursive call must fully materialize
// "the rest" before the outer strcat can prepend one more piece, so each of
// the n functions pays for re-copying the (growing) remainder. Measured
// 12 september 2026: ~5-9 BILLION instructions to dump sapl_compiler's own
// ~900-function source (vs. ~634 million for the entire compile-to-
// bytecode pipeline) via ./compile-sapl --emit=<stage>, and --emit=retag/
// lazytag/lift segfault outright on that source (see docs/2026-09-12_
// modulariteit_en_linken_plan.md #5.2) -- likely a stack-depth issue
// elsewhere entangled with the same growing-string pattern, not fully
// root-caused. dumpProgramToFile below avoids the whole class of problem
// by never materializing the concatenated whole; use that for anything
// beyond a small, fixed test fixture.
dumpProgram fs adts = strcat (ppAdtsOnly adts) (ppFuncsOnly fs)

// Streaming variant: writes each ADT/function's own (small, O(1)-to-render)
// line straight to an already-open file descriptor as it's produced,
// instead of concatenating everything into one packed string first. Total
// work is O(total output size), not O(size^2), and memory never holds more
// than one line at a time. Reuses writeChar/openFile/closeFile (the same
// primitives writeStream/lib/stdlib.cfp already use for streaming file
// I/O) rather than writeStream itself, since writeStream closes the file
// descriptor on Nil -- wrong here, since more lines still need to be
// written to the same fd afterwards.
writeCharsNoClose fd cs =
  case cs
    (Nil -> 0)
    (Cons c rest -> writeChar fd c <#> writeCharsNoClose fd rest)

writeLineTo fd s = writeCharsNoClose fd (str2list s) <#> writeChar fd '\n'

writeAdtsStream fd adts =
  case adts
    (Nil -> 0)
    (Cons a rest -> writeLineTo fd (ppAdt a) <#> writeAdtsStream fd rest)

writeFuncsStream fd fs =
  case fs
    (Nil -> 0)
    (Cons f rest -> writeLineTo fd (ppFunc f) <#> writeFuncsStream fd rest)

dumpProgramToFile outfile fs adts =
  let fd = openFile outfile "w" in
  writeAdtsStream fd adts <#> writeFuncsStream fd fs <#> closeFile fd

// == Definitiebestand: naam/ariteit/striktheid per functie, geen lichaam ==
//
// docs/2026-09-12_modulariteit_en_linken_plan.md #5.1: wat een module
// nodig heeft om EEN ANDERE, apart gecompileerde module te kunnen
// aanroepen tijdens zijn eigen strictness-inferentie/naamresolutie (§C.1/
// §5) -- dezelfde drie velden die uiteindelijk toch in `.metadata`'s
// `func`-regel terechtkomen, alleen hier zonder bytecode-label (dat bestaat
// nog niet vóór codegen) en zonder de lazy/strict-entry-verdubbeling
// (irrelevant voor een lezende module -- die wil één kanoniek signatuur
// per naam, geen twee bytecode-adressen).
//
// `funcNameOf`/`funcArityOf`/`funcArgs`/`argStrict` (ast_helpers.cfp) zijn
// exact wat `genFuncMetas` (stage5_codegen.cfp:1416-1422) ook al voor
// `.metadata` gebruikt -- geen nieuwe extractielogica. NIET hergebruikt:
// `genFuncMetas`'s eigen `strictStr` (stage5_codegen.cfp:1430-1436) -- die
// heeft een off-by-one: `strictStr Nil = ['0']` is bedoeld als plaatshouder
// voor ariteit 0, maar vuurt ook aan het EIND van de recursie voor elke
// NIET-lege lijst, dus elke ariteit>=1 krijgt een spookkarakter '0' achteraan
// geplakt (geverifieerd: een echt gecompileerd .jmvm's `.metadata` had al
// `func 13 el 2 010` staan -- ariteit 2, drie tekens). Al aanwezig in
// productie, stil onschadelijk omdat niets ooit meer dan de eerste `ariteit`
// tekens leest -- maar een definitiebestand dat straks WEL op exacte lengte
// gelezen wordt, mag die dubbelzinnigheid niet overnemen. `genStrictField`
// hieronder is een eigen, correcte renderer (geen gedeeld bestand gewijzigd,
// geen regressierisico voor `.metadata`/reflectie).
//
// Bevat, net als de retag-dump zelf (dumpProgramToFile hierboven), ALLE
// functies in `fs` -- inclusief tijdens lift ontstane hulpfuncties zoals
// `el_1` (docs/2026-09-12_modulariteit_en_linken_plan.md #C.3's uitleg
// waarom parser.ama deze wél mist maar sapl_compiler niet). Nog geen
// export/zichtbaarheidsonderscheid (§6.3's ML/Go-stijl-alternatieven) --
// "in eerste instantie" betekent hier: alles zichtbaar, net als Sapl
// vandaag al doet voor top-level namen binnen één bestand.
// `if` moet als hele clausule-body staan, niet inline als aanroepargument
// (docs/sapl_programmeer_regels.md #3) -- vandaar een eigen naam i.p.v.
// `Cons (if b '1' '0') ...` rechtstreeks, zelfde stijl als dit bestand se
// eigen `ppStrictMark`.
strictBitChar b = if b '1' '0'

genStrictBitsChars bits =
  case bits
    (Nil -> Nil)
    (Cons b rest -> Cons (strictBitChar b) (genStrictBitsChars rest))

genStrictField arity bits =
  if (arity == 0) "0" (list2str (genStrictBitsChars bits))

genDefLine f =
  let n = list2str (funcNameOf f),
      arity = funcArityOf f,
      strict = genStrictField arity (map argStrict (funcArgs f)) in
  strcat n (strcat " " (strcat (list2str (itoa arity)) (strcat " " strict)))

writeDefsStream fd fs =
  case fs
    (Nil -> 0)
    (Cons f rest -> writeLineTo fd (genDefLine f) <#> writeDefsStream fd rest)

writeDefFile outfile fs =
  let fd = openFile outfile "w" in
  writeDefsStream fd fs <#> closeFile fd

// Type-definitiebestand (docs/2026-09-12_modulariteit_en_linken_plan.md
// #5.6, gat 2): in tegenstelling tot een functie heeft een ADT-declaratie
// geen lichaam om weg te laten -- `AdtCon !name !fields` (newparser_ast.cfp)
// bevat sowieso alleen een naam en een `[Bool]` (strict-vlag per veld,
// veldnamen worden door de parser al niet bewaard, zie parser.cfp's
// `collectConFieldsTok`). Een NIEUW lijnformaat zou dus alleen dupliceren
// wat de taal zelf al zegt -- vandaar hier gewoon een pretty-printer terug
// naar geldige `::Naam = Con1 ... | Con2 ...`-syntax. De lezerkant hoeft
// daarom geen nieuwe parser te zijn: `parseProgram`/`ppAdts` (parser.cfp)
// leest zo'n bestand net zo goed als een gewoon .cfp-bestand met alleen
// ADT-declaraties erin (zie sapl_compiler/saplcomp_module.cfp).
adtFieldName i = append ['f'] (itoa i)

adtFieldText i strict =
  if strict (strcat "!" (list2str (adtFieldName i))) (list2str (adtFieldName i))

adtFieldsJoined fields = adtFieldsJoinedN 0 fields

adtFieldsJoinedN i fields =
  case fields
    (Nil -> "")
    (Cons strict rest -> adtFieldsJoinedCons i strict rest)

adtFieldsJoinedCons i strict rest =
  case rest
    (Nil -> adtFieldText i strict)
    (Cons s2 rest2 -> strcat (adtFieldText i strict) (strcat " " (adtFieldsJoinedN (i+1) rest)))

adtConText c = strcat (list2str (adtConName c)) (strcat " " (adtFieldsJoined (adtConFields c)))

adtConsJoined cons =
  case cons
    (Nil -> "")
    (Cons c rest -> adtConsJoinedCons c rest)

adtConsJoinedCons c rest =
  case rest
    (Nil -> adtConText c)
    (Cons c2 rest2 -> strcat (adtConText c) (strcat " | " (adtConsJoined rest)))

adtDeclLine a = strcat "::" (strcat (list2str (adtName a)) (strcat " = " (adtConsJoined (adtConsOf a))))

writeTypeDefsStream fd as =
  case as
    (Nil -> 0)
    (Cons a rest -> writeLineTo fd (adtDeclLine a) <#> writeTypeDefsStream fd rest)

writeTypeDefFile outfile as =
  let fd = openFile outfile "w" in
  writeTypeDefsStream fd as <#> closeFile fd
